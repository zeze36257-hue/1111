{
 "00.mp3": {
  "key": "b1afeb265fe4",
  "start": 0.15,
  "text": "哈佛追踪了一群人，八十多年。",
  "speed": 1.0,
  "dur": 2.35,
  "room": 3.8
 },
 "01.mp3": {
  "key": "203e2ffddfe3",
  "start": 3.84,
  "text": "比胆固醇更能预测晚年健康的，是什么？先猜一个。",
  "speed": 1.034,
  "dur": 4.21,
  "room": 3.95
 },
 "02.mp3": {
  "key": "3eeb5c459b08",
  "start": 8.2,
  "text": "答案是：关系。",
  "speed": 1.0,
  "dur": 1.75,
  "room": 2.45
 },
 "03.mp3": {
  "key": "3a2bebfaf9fb",
  "start": 10.8,
  "text": "50 岁时对关系最满意的人，",
  "speed": 1.0,
  "dur": 2.26,
  "room": 2.65
 },
 "04.mp3": {
  "key": "aa45c58eee0a",
  "start": 13.6,
  "text": "到了 80 岁，往往最健康。",
  "speed": 1.0,
  "dur": 2.13,
  "room": 2.55
 },
 "05.mp3": {
  "key": "73842378a4db",
  "start": 16.3,
  "text": "两千多年前，亚里士多德说：",
  "speed": 1.0,
  "dur": 2.21,
  "room": 3.45
 },
 "06.mp3": {
  "key": "d5cdb1bba189",
  "start": 19.9,
  "text": "我们做的一切，最后都是为了「幸福」。",
  "speed": 1.0,
  "dur": 2.38,
  "room": 3.95
 },
 "07.mp3": {
  "key": "50af2afa6a8c",
  "start": 24.0,
  "text": "但他说的幸福，不是开心一阵子，",
  "speed": 1.0,
  "dur": 2.59,
  "room": 3.55
 },
 "08.mp3": {
  "key": "413f8d4a3efb",
  "start": 27.47,
  "text": "而是「活得好」：把你能成为的样子，活出来。",
  "speed": 1.0,
  "dur": 3.98,
  "room": 3.75
 },
 "09.mp3": {
  "key": "95063eb99a92",
  "start": 31.6,
  "text": "这就是「幸福主义」：幸福，是人生最后的目的。",
  "speed": 1.0,
  "dur": 3.71,
  "room": 5.85
 },
 "10.mp3": {
  "key": "d118184ee285",
  "start": 37.36,
  "text": "可是，越盯着幸福，它好像越远。",
  "speed": 1.0,
  "dur": 3.39,
  "room": 3.15
 },
 "11.mp3": {
  "key": "70c0e88e7a95",
  "start": 40.9,
  "text": "心理学家莫斯发现：越把「要幸福」看得重的人，",
  "speed": 1.0,
  "dur": 3.17,
  "room": 3.85
 },
 "12.mp3": {
  "key": "dcbd7c41327a",
  "start": 44.9,
  "text": "在本该开心的时候，反而更容易失望。",
  "speed": 1.0,
  "dur": 2.97,
  "room": 3.85
 },
 "13.mp3": {
  "key": "36ad8839dc97",
  "start": 48.9,
  "text": "就像一边开心，一边在检查：我够不够开心？",
  "speed": 1.0,
  "dur": 3.67,
  "room": 4.55
 },
 "14.mp3": {
  "key": "19bf1248f1e5",
  "start": 53.6,
  "text": "那幸福从哪来？回到开头那个研究。",
  "speed": 1.0,
  "dur": 3.13,
  "room": 4.15
 },
 "15.mp3": {
  "key": "b4359f19ad51",
  "start": 57.9,
  "text": "追了八十多年，研究者说：",
  "speed": 1.0,
  "dur": 2.41,
  "room": 2.75
 },
 "16.mp3": {
  "key": "4cd32aa27145",
  "start": 60.8,
  "text": "好的关系，让人更快乐，也更健康。",
  "speed": 1.0,
  "dur": 3.25,
  "room": 3.35
 },
 "17.mp3": {
  "key": "d0d61db19c28",
  "start": 64.3,
  "text": "所以，与其一遍遍问：我幸福吗？",
  "speed": 1.033,
  "dur": 2.77,
  "room": 3.45
 },
 "18.mp3": {
  "key": "a879b5b77ad4",
  "start": 67.9,
  "text": "不如问问：今天，我好好对待谁了？",
  "speed": 1.0,
  "dur": 3.61,
  "room": 4.15
 },
 "19.mp3": {
  "key": "b89356bf6b5f",
  "start": 72.2,
  "text": "幸福，常常是好好生活的「副产品」。",
  "speed": 1.0,
  "dur": 2.82,
  "room": 3.95
 },
 "20.mp3": {
  "key": "54dfe0a3b88c",
  "start": 76.3,
  "text": "一百五十多年前，密尔写过：",
  "speed": 1.0,
  "dur": 2.11,
  "room": 3.75
 },
 "21.mp3": {
  "key": "3de5f20d38ae",
  "start": 80.2,
  "text": "「问问自己幸不幸福，你就不再幸福了。」—— 约翰·密尔",
  "speed": 1.0,
  "dur": 4.2,
  "room": 4.55
 },
 "22.mp3": {
  "key": "c8bbfdb5431f",
  "start": 84.9,
  "text": "这一季，我们聊了十个「日常里的主义」。",
  "speed": 1.0,
  "dur": 3.03,
  "room": 3.85
 },
 "23.mp3": {
  "key": "a08c4c838483",
  "start": 88.9,
  "text": "谢谢你，一期一期看到这里。",
  "speed": 1.0,
  "dur": 2.8,
  "room": 4.35
 },
 "24.mp3": {
  "key": "131825210dfc",
  "start": 93.4,
  "text": "别盯着幸福，好好去生活。",
  "speed": 1.0,
  "dur": 2.24,
  "room": 4.85
 },
 "25.mp3": {
  "key": "b335e6e4ce11",
  "start": 98.4,
  "text": "评论区：你最近一次觉得幸福，是什么时候？",
  "speed": 1.0,
  "dur": 4.03,
  "room": 5.45
 }
}