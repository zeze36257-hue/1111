{
 "00.mp3": {
  "key": "6dd8b5181f4c",
  "start": 0.15,
  "text": "1967 年的一个实验：狗被电击，怎么都逃不掉。",
  "speed": 1.25,
  "dur": 3.22,
  "room": 3.8
 },
 "01.mp3": {
  "key": "07b81eeebd0c",
  "start": 3.89,
  "text": "后来换到一跳就能逃的箱子，它会逃吗？先猜一个。",
  "speed": 1.07,
  "dur": 4.16,
  "room": 3.95
 },
 "02.mp3": {
  "key": "0873c7456f6b",
  "start": 8.2,
  "text": "答案是：大多数，趴着不动。",
  "speed": 1.3,
  "dur": 2.11,
  "room": 2.45
 },
 "03.mp3": {
  "key": "84324298841c",
  "start": 10.8,
  "text": "明明能逃，却不再试了。",
  "speed": 1.0,
  "dur": 2.03,
  "room": 2.65
 },
 "04.mp3": {
  "key": "23a665bef99e",
  "start": 13.6,
  "text": "这个实验，今天看来很残忍。",
  "speed": 1.0,
  "dur": 2.29,
  "room": 2.55
 },
 "05.mp3": {
  "key": "41798cb6341c",
  "start": 16.3,
  "text": "心理学家塞利格曼，把这叫「习得性无助」。",
  "speed": 1.0,
  "dur": 3.43,
  "room": 3.45
 },
 "06.mp3": {
  "key": "96a1d9d8727b",
  "start": 19.9,
  "text": "人也一样：一次次努力没用，就学会了放弃。",
  "speed": 1.0,
  "dur": 3.61,
  "room": 3.95
 },
 "07.mp3": {
  "key": "2d571dd25060",
  "start": 24.0,
  "text": "「反正没用」「我就这样了」——",
  "speed": 1.0,
  "dur": 1.49,
  "room": 3.55
 },
 "08.mp3": {
  "key": "dc60be9cd34a",
  "start": 27.7,
  "text": "这些话，你是不是也对自己说过？",
  "speed": 1.0,
  "dur": 2.9,
  "room": 3.75
 },
 "09.mp3": {
  "key": "0ec0ae3ff9b4",
  "start": 31.6,
  "text": "这就是「失败主义」：还没开始，先认输。",
  "speed": 1.0,
  "dur": 3.79,
  "room": 5.85
 },
 "10.mp3": {
  "key": "a5a84c5278c3",
  "start": 37.6,
  "text": "可 50 年后，塞利格曼自己改了说法。",
  "speed": 1.0,
  "dur": 2.85,
  "room": 3.15
 },
 "11.mp3": {
  "key": "5abfda6ebae1",
  "start": 40.9,
  "text": "长期受苦时，「不动」是大脑的默认反应，",
  "speed": 1.0,
  "dur": 2.32,
  "room": 3.85
 },
 "12.mp3": {
  "key": "7c5dcca2f700",
  "start": 44.67,
  "text": "根本不用学。要学的，是另一件事：",
  "speed": 1.0,
  "dur": 4.08,
  "room": 3.85
 },
 "13.mp3": {
  "key": "22b12759d980",
  "start": 48.9,
  "text": "「我做的事，有用」。",
  "speed": 1.0,
  "dur": 1.62,
  "room": 4.55
 },
 "14.mp3": {
  "key": "be5bda8f3e63",
  "start": 53.6,
  "text": "大脑里有一块区域，专门察觉「我能控制」。",
  "speed": 1.0,
  "dur": 2.8,
  "room": 4.15
 },
 "15.mp3": {
  "key": "7093d9f23c52",
  "start": 57.89,
  "text": "一旦察觉到，就能压住「放弃」的反应；而这种察觉，是从经验里学会的。",
  "speed": 1.0,
  "dur": 6.26,
  "room": 6.25
 },
 "16.mp3": {
  "key": "37548a16bd45",
  "start": 64.3,
  "text": "所以，你不是学会了无助，",
  "speed": 1.0,
  "dur": 2.22,
  "room": 3.45
 },
 "17.mp3": {
  "key": "ffd106a20d54",
  "start": 67.9,
  "text": "只是还没学会：有些事，你说了算。",
  "speed": 1.0,
  "dur": 3.06,
  "room": 4.15
 },
 "18.mp3": {
  "key": "3d6b40ad0b79",
  "start": 72.2,
  "text": "从一件小事开始，就够了。",
  "speed": 1.0,
  "dur": 2.51,
  "room": 3.95
 },
 "19.mp3": {
  "key": "b443d7d17489",
  "start": 76.3,
  "text": "50 年后，他们在论文里写道：",
  "speed": 1.0,
  "dur": 2.25,
  "room": 3.75
 },
 "20.mp3": {
  "key": "24ac31d096cd",
  "start": 79.8,
  "text": "「大脑要察觉的，是控制的存在，而不是它的缺失。」—— 迈尔 & 塞利格曼",
  "speed": 1.3,
  "dur": 4.95,
  "room": 4.55
 },
 "21.mp3": {
  "key": "d597c0254e1a",
  "start": 84.9,
  "text": "放弃不用学，",
  "speed": 1.0,
  "dur": 1.15,
  "room": 3.85
 },
 "22.mp3": {
  "key": "9407ec099d16",
  "start": 88.9,
  "text": "「我能行」才要学。",
  "speed": 1.0,
  "dur": 1.13,
  "room": 4.35
 },
 "23.mp3": {
  "key": "8e6455e59b8c",
  "start": 93.4,
  "text": "先做成一件小事，再说「没用」。",
  "speed": 1.0,
  "dur": 2.27,
  "room": 4.85
 },
 "24.mp3": {
  "key": "727bac97ad2c",
  "start": 98.4,
  "text": "评论区：你最近做成的一件小事是什么？",
  "speed": 1.0,
  "dur": 3.04,
  "room": 5.45
 }
}