{
 "00.mp3": {
  "key": "172c1cb4d2bb",
  "start": 0.15,
  "text": "做一套题之前，一个说「我肯定考砸」，一个说「稳了」。",
  "speed": 1.111,
  "dur": 3.64,
  "room": 3.8
 },
 "01.mp3": {
  "key": "b1588c1d8515",
  "start": 4.1,
  "text": "谁做得更好？先猜一个。",
  "speed": 1.0,
  "dur": 2.63,
  "room": 3.95
 },
 "02.mp3": {
  "key": "782f05f9be73",
  "start": 8.2,
  "text": "答案是：差不多。",
  "speed": 1.0,
  "dur": 1.49,
  "room": 2.45
 },
 "03.mp3": {
  "key": "95df27a9ab83",
  "start": 10.7,
  "text": "预期差了一大截，成绩却没差多少。",
  "speed": 1.0,
  "dur": 2.75,
  "room": 2.65
 },
 "04.mp3": {
  "key": "649d67ff9979",
  "start": 13.6,
  "text": "那句「我肯定考砸」，到底在干什么？",
  "speed": 1.3,
  "dur": 1.83,
  "room": 2.55
 },
 "05.mp3": {
  "key": "a676483d9192",
  "start": 16.3,
  "text": "心理学家诺伦，把这叫「防御性悲观」。",
  "speed": 1.0,
  "dur": 2.75,
  "room": 3.45
 },
 "06.mp3": {
  "key": "e7316abc78b7",
  "start": 19.65,
  "text": "先把期待放低，再把可能出错的地方，一个个想一遍。",
  "speed": 1.0,
  "dur": 4.2,
  "room": 3.95
 },
 "07.mp3": {
  "key": "99a4d7794e5f",
  "start": 24.0,
  "text": "卡壳了怎么办？紧张了怎么办？忘词了怎么办？",
  "speed": 1.3,
  "dur": 3.35,
  "room": 3.55
 },
 "08.mp3": {
  "key": "b1034dd35aae",
  "start": 27.7,
  "text": "每想到一个坏结果，就准备一个办法。",
  "speed": 1.0,
  "dur": 2.59,
  "room": 3.75
 },
 "09.mp3": {
  "key": "3b00e6194835",
  "start": 31.6,
  "text": "这是另一种「悲观主义」：往坏处想，是为了做准备。",
  "speed": 1.0,
  "dur": 4.27,
  "room": 5.85
 },
 "10.mp3": {
  "key": "10e01381f72e",
  "start": 37.6,
  "text": "所以，别急着劝他「往好处想」。",
  "speed": 1.0,
  "dur": 2.9,
  "room": 3.15
 },
 "11.mp3": {
  "key": "4ff83aab1cbf",
  "start": 40.9,
  "text": "有研究发现：不让这种人去想坏结果，他们反而做得更差；",
  "speed": 1.194,
  "dur": 3.68,
  "room": 3.85
 },
 "12.mp3": {
  "key": "8faee4783d48",
  "start": 44.9,
  "text": "而硬让乐观的人去想，乐观的人也会变差。",
  "speed": 1.0,
  "dur": 3.61,
  "room": 3.85
 },
 "13.mp3": {
  "key": "652e4d354a51",
  "start": 48.9,
  "text": "每个人，都有自己的「热身方式」。",
  "speed": 1.0,
  "dur": 2.22,
  "room": 4.55
 },
 "14.mp3": {
  "key": "221c9fd80626",
  "start": 53.6,
  "text": "但它和「真的悲观」，不一样：",
  "speed": 1.0,
  "dur": 2.13,
  "room": 4.15
 },
 "15.mp3": {
  "key": "dba3cedf7c50",
  "start": 57.48,
  "text": "悲观，是想到坏结果就停下；防御性悲观，是想到坏结果就动手。",
  "speed": 1.0,
  "dur": 6.67,
  "room": 6.25
 },
 "16.mp3": {
  "key": "fd12fceb55e2",
  "start": 64.3,
  "text": "这条路也有代价：想得多，心就绷得紧。",
  "speed": 1.206,
  "dur": 3.56,
  "room": 3.45
 },
 "17.mp3": {
  "key": "bb0ba9899f08",
  "start": 68.01,
  "text": "所以，只想到「我能做什么」为止，然后去做。",
  "speed": 1.0,
  "dur": 4.0,
  "room": 4.15
 },
 "18.mp3": {
  "key": "79a2a620a625",
  "start": 72.2,
  "text": "想完了，就把它放下。",
  "speed": 1.0,
  "dur": 1.66,
  "room": 3.95
 },
 "19.mp3": {
  "key": "a239284744f9",
  "start": 76.3,
  "text": "诺伦写过一本书，书名就是：",
  "speed": 1.0,
  "dur": 2.58,
  "room": 3.75
 },
 "20.mp3": {
  "key": "fca9729c15cf",
  "start": 80.2,
  "text": "「消极思维的积极力量」—— 诺伦（书名）",
  "speed": 1.0,
  "dur": 3.63,
  "room": 4.55
 },
 "21.mp3": {
  "key": "87bdf3fef89d",
  "start": 84.9,
  "text": "带伞的人，不是盼着下雨，",
  "speed": 1.0,
  "dur": 2.47,
  "room": 3.85
 },
 "22.mp3": {
  "key": "e9f0a45919be",
  "start": 88.9,
  "text": "是下雨了，也照样出门。",
  "speed": 1.0,
  "dur": 2.28,
  "room": 4.35
 },
 "23.mp3": {
  "key": "74459fb9288a",
  "start": 93.4,
  "text": "往坏处想，往好处做。",
  "speed": 1.0,
  "dur": 2.15,
  "room": 4.85
 },
 "24.mp3": {
  "key": "b0b14f3f9602",
  "start": 98.4,
  "text": "评论区：你是「完了派」，还是「稳了派」？",
  "speed": 1.0,
  "dur": 3.12,
  "room": 5.45
 }
}