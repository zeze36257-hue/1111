{
 "00.mp3": {
  "key": "9c12ee322266",
  "start": 0.15,
  "text": "一群男孩，按喜欢哪位画家，被分成两组。",
  "speed": 1.163,
  "dur": 2.6,
  "room": 3.8
 },
 "01.mp3": {
  "key": "ce35504e042b",
  "start": 3.64,
  "text": "再让他们给别的男孩分钱，会怎么分？先猜一个。",
  "speed": 1.0,
  "dur": 4.41,
  "room": 3.95
 },
 "02.mp3": {
  "key": "68d29117b5d5",
  "start": 8.2,
  "text": "答案是 C：很多人选了拉开差距。",
  "speed": 1.274,
  "dur": 2.34,
  "room": 2.45
 },
 "03.mp3": {
  "key": "0478ead17dab",
  "start": 10.8,
  "text": "就算自己组少拿一点，",
  "speed": 1.0,
  "dur": 1.59,
  "room": 2.65
 },
 "04.mp3": {
  "key": "eae0d0201f39",
  "start": 13.6,
  "text": "也要让对方组，拿得更少。",
  "speed": 1.0,
  "dur": 2.55,
  "room": 2.55
 },
 "05.mp3": {
  "key": "fa7e5adf2cb9",
  "start": 16.3,
  "text": "更妙的是：分组，其实是随机的。",
  "speed": 1.0,
  "dur": 3.09,
  "room": 3.45
 },
 "06.mp3": {
  "key": "95770bbede23",
  "start": 19.9,
  "text": "他们不知道组员是谁，钱也落不进自己口袋。",
  "speed": 1.0,
  "dur": 3.41,
  "room": 3.95
 },
 "07.mp3": {
  "key": "fb6c013ef6d3",
  "start": 24.0,
  "text": "只是一个标签，就够让人偏心了。",
  "speed": 1.0,
  "dur": 2.34,
  "room": 3.55
 },
 "08.mp3": {
  "key": "aa1868bd9b3f",
  "start": 27.7,
  "text": "心理学家泰弗尔，把这叫做「最简群体」。",
  "speed": 1.0,
  "dur": 2.96,
  "room": 3.75
 },
 "09.mp3": {
  "key": "8fba06e4aad0",
  "start": 31.6,
  "text": "这就是「部落主义」：先分出「我们」和「他们」。",
  "speed": 1.0,
  "dur": 2.66,
  "room": 5.85
 },
 "10.mp3": {
  "key": "213f5e9fc119",
  "start": 37.6,
  "text": "更早的 1954 年，在一个夏令营里，",
  "speed": 1.0,
  "dur": 3.14,
  "room": 3.15
 },
 "11.mp3": {
  "key": "bce4f5d82f25",
  "start": 40.9,
  "text": "22 个男孩被分成两队，比棒球、比拔河；",
  "speed": 1.0,
  "dur": 3.77,
  "room": 3.85
 },
 "12.mp3": {
  "key": "1d444e02981c",
  "start": 44.9,
  "text": "没几天，就骂人、烧队旗、闯对方的小屋。",
  "speed": 1.038,
  "dur": 3.89,
  "room": 3.85
 },
 "13.mp3": {
  "key": "ed4594fcb417",
  "start": 48.94,
  "text": "可他们本来，都是背景差不多的普通孩子。",
  "speed": 1.0,
  "dur": 2.85,
  "room": 4.55
 },
 "14.mp3": {
  "key": "2c9b419389a8",
  "start": 53.6,
  "text": "后来，营地的供水“坏了”，",
  "speed": 1.0,
  "dur": 1.98,
  "room": 4.15
 },
 "15.mp3": {
  "key": "4abf8b82a5af",
  "start": 57.9,
  "text": "两队只能一起去修；",
  "speed": 1.0,
  "dur": 1.39,
  "room": 2.75
 },
 "16.mp3": {
  "key": "5dc54e3a6aab",
  "start": 60.8,
  "text": "一起干了几件事，敌意慢慢少了。",
  "speed": 1.0,
  "dur": 2.95,
  "room": 3.35
 },
 "17.mp3": {
  "key": "bca5c904c802",
  "start": 64.3,
  "text": "所以，当心里冒出“他们那种人”，",
  "speed": 1.0,
  "dur": 2.21,
  "room": 3.45
 },
 "18.mp3": {
  "key": "a829c6b34205",
  "start": 67.89,
  "text": "可以先问一句：我们，是不是在同一条船上？",
  "speed": 1.0,
  "dur": 4.16,
  "room": 4.15
 },
 "19.mp3": {
  "key": "3bda8d8e989e",
  "start": 72.2,
  "text": "相处多了，“他们”就变回了一个个人。",
  "speed": 1.0,
  "dur": 2.43,
  "room": 3.95
 },
 "20.mp3": {
  "key": "48bd6144ac6c",
  "start": 76.3,
  "text": "两千多年前，《论语》里说：",
  "speed": 1.0,
  "dur": 2.0,
  "room": 3.75
 },
 "21.mp3": {
  "key": "8ade2c3fe67f",
  "start": 80.2,
  "text": "「四海之内，皆兄弟也。」——《论语》",
  "speed": 1.0,
  "dur": 2.85,
  "room": 4.55
 },
 "22.mp3": {
  "key": "74882b62ba49",
  "start": 84.9,
  "text": "爱分组，也许是人的天性；",
  "speed": 1.0,
  "dur": 2.07,
  "room": 3.85
 },
 "23.mp3": {
  "key": "d24c2c136fe5",
  "start": 88.9,
  "text": "可分出来的那条线，画得上，也擦得掉。",
  "speed": 1.0,
  "dur": 3.46,
  "room": 4.35
 },
 "24.mp3": {
  "key": "0b2071e4e848",
  "start": 93.4,
  "text": "组可以分，心不必分。",
  "speed": 1.0,
  "dur": 2.23,
  "room": 4.85
 },
 "25.mp3": {
  "key": "9ebe4acc593c",
  "start": 98.4,
  "text": "评论区：你有没有因为一个标签，就看不惯一个人？",
  "speed": 1.0,
  "dur": 3.33,
  "room": 5.45
 }
}