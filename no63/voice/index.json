{
 "00.mp3": {
  "key": "209cda85eaf9",
  "start": 0.15,
  "text": "三个人在网上玩传球，传着传着，",
  "speed": 1.0,
  "dur": 2.88,
  "room": 3.8
 },
 "01.mp3": {
  "key": "21dda12b4f58",
  "start": 3.9,
  "text": "再也没人传给你。只有几分钟，你会怎样？先猜一个。",
  "speed": 1.2,
  "dur": 4.15,
  "room": 3.95
 },
 "02.mp3": {
  "key": "c0d68dff4592",
  "start": 8.2,
  "text": "答案是 C：明显受伤。",
  "speed": 1.0,
  "dur": 2.26,
  "room": 2.45
 },
 "03.mp3": {
  "key": "3bda66b7e8ca",
  "start": 10.76,
  "text": "心情变差，归属感、自尊都往下掉；",
  "speed": 1.103,
  "dur": 3.39,
  "room": 2.65
 },
 "04.mp3": {
  "key": "ff1cb44d04f1",
  "start": 14.3,
  "text": "就算告诉你，另外两个只是电脑程序。",
  "speed": 1.042,
  "dur": 2.92,
  "room": 2.55
 },
 "05.mp3": {
  "key": "6a1f1a923496",
  "start": 17.37,
  "text": "这个小游戏，后来被很多研究反复用过，",
  "speed": 1.0,
  "dur": 2.88,
  "room": 3.45
 },
 "06.mp3": {
  "key": "c0ab35eac11d",
  "start": 20.4,
  "text": "结果很一致：被冷落，哪怕几分钟，也会疼。",
  "speed": 1.153,
  "dur": 3.63,
  "room": 3.95
 },
 "07.mp3": {
  "key": "fb6b1b017f9d",
  "start": 24.18,
  "text": "有研究发现：被讨厌的人冷落，也一样难受。",
  "speed": 1.256,
  "dur": 3.02,
  "room": 3.55
 },
 "08.mp3": {
  "key": "437546c148ce",
  "start": 27.7,
  "text": "人需要“在群里”，就像需要吃饭。",
  "speed": 1.0,
  "dur": 2.7,
  "room": 3.75
 },
 "09.mp3": {
  "key": "4d0676c43258",
  "start": 31.6,
  "text": "这就是「社群主义」：人，是在“我们”里活着的。",
  "speed": 1.0,
  "dur": 3.26,
  "room": 5.85
 },
 "10.mp3": {
  "key": "9e740cf443d5",
  "start": 37.6,
  "text": "研究者给被冷落的人做了脑部扫描：",
  "speed": 1.0,
  "dur": 2.93,
  "room": 3.15
 },
 "11.mp3": {
  "key": "d0043a853af8",
  "start": 40.9,
  "text": "一块和身体疼痛有关的区域，也活跃了起来。",
  "speed": 1.0,
  "dur": 3.44,
  "room": 3.85
 },
 "12.mp3": {
  "key": "443e504e79ee",
  "start": 44.9,
  "text": "“心痛”这个词，也许不只是比喻。",
  "speed": 1.0,
  "dur": 2.15,
  "room": 3.85
 },
 "13.mp3": {
  "key": "03d43a446782",
  "start": 48.66,
  "text": "具体机制还有争论，但“被冷落会疼”，一再被证实。",
  "speed": 1.0,
  "dur": 4.79,
  "room": 4.55
 },
 "14.mp3": {
  "key": "fd46125e7658",
  "start": 53.6,
  "text": "而我们每个人，都可能是那个不传球的人：",
  "speed": 1.0,
  "dur": 3.3,
  "room": 4.15
 },
 "15.mp3": {
  "key": "a5d7205cf284",
  "start": 57.9,
  "text": "群里有人说话，没人接；",
  "speed": 1.0,
  "dur": 1.95,
  "room": 2.75
 },
 "16.mp3": {
  "key": "7e41eb22546e",
  "start": 60.8,
  "text": "饭桌上有人插不上嘴，没人看。",
  "speed": 1.0,
  "dur": 2.86,
  "room": 3.35
 },
 "17.mp3": {
  "key": "0d9f3ff1dc12",
  "start": 64.3,
  "text": "所以，下次看到有人被晾在一边，",
  "speed": 1.0,
  "dur": 2.75,
  "room": 3.45
 },
 "18.mp3": {
  "key": "5c19e863f701",
  "start": 67.9,
  "text": "传一个球给他就好：叫一声名字，问一句“你觉得呢”。",
  "speed": 1.107,
  "dur": 3.65,
  "room": 4.15
 },
 "19.mp3": {
  "key": "298b3bd6fb30",
  "start": 72.2,
  "text": "对你只是顺手，对他可能是一整天。",
  "speed": 1.0,
  "dur": 2.26,
  "room": 3.95
 },
 "20.mp3": {
  "key": "49210f1507ab",
  "start": 76.3,
  "text": "两千多年前，孔子说：",
  "speed": 1.0,
  "dur": 2.09,
  "room": 3.75
 },
 "21.mp3": {
  "key": "38415bd75e9e",
  "start": 80.2,
  "text": "「德不孤，必有邻。」—— 孔子",
  "speed": 1.0,
  "dur": 2.16,
  "room": 4.55
 },
 "22.mp3": {
  "key": "3045ff526eb5",
  "start": 84.9,
  "text": "这一季，我们聊了十个「人和人之间的主义」。",
  "speed": 1.0,
  "dur": 2.54,
  "room": 3.85
 },
 "23.mp3": {
  "key": "a08c4c838483",
  "start": 88.9,
  "text": "谢谢你，一期一期看到这里。",
  "speed": 1.0,
  "dur": 2.2,
  "room": 4.35
 },
 "24.mp3": {
  "key": "c9b151d922d1",
  "start": 93.4,
  "text": "传一个球，就有人不孤单。",
  "speed": 1.0,
  "dur": 2.47,
  "room": 4.85
 },
 "25.mp3": {
  "key": "1f8fa9d5edcf",
  "start": 98.4,
  "text": "评论区：最近一次有人“传球”给你，是什么时候？",
  "speed": 1.0,
  "dur": 3.24,
  "room": 5.45
 }
}