{
 "00.mp3": {
  "key": "07035ef7b525",
  "tkey": "0fc8b5a4e66c",
  "file": "00.mp3",
  "start": 0.7,
  "text": "为什么，你总是不肯让自己犯一点错？",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 2.68,
  "room": 3.33
 },
 "01.mp3": {
  "key": "9e2f14693bcf",
  "tkey": "b03cd91da6b2",
  "file": "01.mp3",
  "start": 4.18,
  "text": "日子稍微有点风吹草动，你就开始焦虑、开始内耗。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 4.27,
  "room": 4.42
 },
 "02.mp3": {
  "key": "b54a832bffc8",
  "tkey": "c34493338369",
  "file": "02.mp3",
  "start": 8.75,
  "text": "可想来想去，问题没解决，心情倒先坏了。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 3.91,
  "room": 4.46
 },
 "03.mp3": {
  "key": "944415620e53",
  "tkey": "759adf109fe8",
  "file": "03.mp3",
  "start": 13.36,
  "text": "放不下昨天，也过不好今天。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 2.32,
  "room": 3.07
 },
 "04.mp3": {
  "key": "fe730136c611",
  "tkey": "ba4917e36e3f",
  "file": "04.mp3",
  "start": 16.58,
  "text": "其实，生活里有点不如意，再正常不过了。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 3.93,
  "room": 4.38
 },
 "05.mp3": {
  "key": "4128f63594a3",
  "tkey": "0869fb2e7624",
  "file": "05.mp3",
  "start": 21.11,
  "text": "这世上本来就没有完美的事，你也不用做完美的人。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 3.75,
  "room": 4.5
 },
 "06.mp3": {
  "key": "98cfcab2b8a5",
  "tkey": "7eb3ac299484",
  "file": "06.mp3",
  "start": 25.76,
  "text": "不想犯错，当然是好事；",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 2.09,
  "room": 2.19
 },
 "07.mp3": {
  "key": "94d1b4ecf9d8",
  "tkey": "3b4e4413ad90",
  "file": "07.mp3",
  "start": 28.1,
  "text": "可要是你允许自己出错，还敢从错里学到点什么，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 3.54,
  "room": 3.69
 },
 "08.mp3": {
  "key": "6e79ebdd6a94",
  "tkey": "d6ae78821f75",
  "file": "08.mp3",
  "start": 31.94,
  "text": "这样的你，只会越来越好。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.95,
  "dur": 2.15,
  "room": 4.61
 }
}