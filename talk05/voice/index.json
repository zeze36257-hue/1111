{
 "00.mp3": {
  "key": "6633d31a3fc2",
  "tkey": "3be5a098b851",
  "file": "00.mp3",
  "start": 0.15,
  "text": "凌晨一点，他发来一句：晚安，想你了。",
  "speed": 0.92,
  "dur": 4.72,
  "room": 5.07
 },
 "01.mp3": {
  "key": "792e3ce6262e",
  "tkey": "05adce47d86e",
  "file": "01.mp3",
  "start": 5.37,
  "text": "它打了一句「我也想你」，又删了。",
  "speed": 0.92,
  "dur": 3.66,
  "room": 3.96
 },
 "02.mp3": {
  "key": "351830a10fa4",
  "tkey": "c110f86bbb99",
  "file": "02.mp3",
  "start": 9.48,
  "text": "再打一句「别对我这么好」，也删了。",
  "speed": 0.92,
  "dur": 3.02,
  "room": 3.37
 },
 "03.mp3": {
  "key": "81ea6315db5c",
  "tkey": "f3a7f7930954",
  "file": "03.mp3",
  "start": 13.0,
  "text": "最后，只回了一个字：「嗯」。",
  "speed": 0.92,
  "dur": 2.93,
  "room": 3.38
 },
 "04.mp3": {
  "key": "d6e7890190e7",
  "tkey": "decc742311f8",
  "file": "04.mp3",
  "start": 16.53,
  "text": "然后抱着手机，一直等到天亮。",
  "speed": 0.92,
  "dur": 2.53,
  "room": 6.02
 },
 "05.mp3": {
  "key": "7809d5e35fa5",
  "tkey": "fd6b428ad7ab",
  "file": "05.mp3",
  "start": 22.7,
  "text": "第二天，他撑着伞来找它。",
  "speed": 0.92,
  "dur": 2.5,
  "room": 2.75
 },
 "06.mp3": {
  "key": "34a662d0c223",
  "tkey": "0a220e6c03f3",
  "file": "06.mp3",
  "start": 25.6,
  "text": "它往前走了一步，又退了回去，把门关上了。",
  "speed": 0.92,
  "dur": 3.87,
  "room": 4.32
 },
 "07.mp3": {
  "key": "2247ea0bbb92",
  "tkey": "c5a084eb2cbe",
  "file": "07.mp3",
  "start": 30.07,
  "text": "门一关，它就哭了。",
  "speed": 0.92,
  "dur": 1.31,
  "room": 2.06
 },
 "08.mp3": {
  "key": "55a4b5433cf7",
  "tkey": "d9d741a70cf2",
  "file": "08.mp3",
  "start": 32.28,
  "text": "它不是不想被爱。它是太想了，又太怕了。",
  "speed": 0.92,
  "dur": 4.51,
  "room": 6.27
 },
 "09.mp3": {
  "key": "bea25317d3f6",
  "tkey": "7f2499a56c53",
  "file": "09.mp3",
  "start": 38.7,
  "text": "心理学家管这叫「恐惧型依恋」。",
  "speed": 0.92,
  "dur": 3.34,
  "room": 3.59
 },
 "10.mp3": {
  "key": "e4381cff9063",
  "tkey": "41a9d664767c",
  "file": "10.mp3",
  "start": 42.44,
  "text": "心理学家用两把尺子量感情，它两把都很高：",
  "speed": 0.92,
  "dur": 4.16,
  "room": 4.36
 },
 "11.mp3": {
  "key": "265aa143a4f7",
  "tkey": "af8d1eccd781",
  "file": "11.mp3",
  "start": 46.95,
  "text": "既怕被丢下，又怕靠太近。",
  "speed": 0.92,
  "dur": 2.51,
  "room": 2.86
 },
 "12.mp3": {
  "key": "3491af4295a0",
  "tkey": "599fe07e0af3",
  "file": "12.mp3",
  "start": 49.96,
  "text": "所以心里想靠近，身体却在往后退。",
  "speed": 0.92,
  "dur": 3.0,
  "room": 4.59
 },
 "13.mp3": {
  "key": "e326b4f50ecd",
  "tkey": "44eea278c9bb",
  "file": "13.mp3",
  "start": 54.7,
  "text": "如果你也是这样：想靠近的时候，不用一下子走完。",
  "speed": 0.92,
  "dur": 4.71,
  "room": 4.96
 },
 "14.mp3": {
  "key": "0b77b916d64d",
  "tkey": "2831bd4714bd",
  "file": "14.mp3",
  "start": 59.81,
  "text": "一次一步，就好。",
  "speed": 0.92,
  "dur": 1.44,
  "room": 2.19
 },
 "15.mp3": {
  "key": "9c42b385ec60",
  "tkey": "5a6a59594ebb",
  "file": "15.mp3",
  "start": 62.15,
  "text": "越想要，越推开。",
  "speed": 0.92,
  "dur": 1.95,
  "room": 2.6
 },
 "16.mp3": {
  "key": "0f10b30ddc1c",
  "tkey": "1350b6247120",
  "file": "16.mp3",
  "start": 64.9,
  "text": "评论区说说：你有没有把一个很想要的人，推开过？",
  "speed": 0.92,
  "dur": 3.94,
  "room": 5.35
 }
}