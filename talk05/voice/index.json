{
 "00.mp3": {
  "key": "6633d31a3fc2",
  "tkey": "3be5a098b851",
  "file": "00.mp3",
  "start": 0.15,
  "text": "凌晨一点，他发来一句：晚安，想你了。",
  "speed": 0.92,
  "dur": 4.72,
  "room": 5.07
 },
 "01.mp3": {
  "key": "792e3ce6262e",
  "tkey": "05adce47d86e",
  "file": "01.mp3",
  "start": 5.37,
  "text": "它打了一句「我也想你」，又删了。",
  "speed": 0.92,
  "dur": 3.66,
  "room": 3.96
 },
 "02.mp3": {
  "key": "351830a10fa4",
  "tkey": "c110f86bbb99",
  "file": "02.mp3",
  "start": 9.48,
  "text": "再打一句「别对我这么好」，也删了。",
  "speed": 0.92,
  "dur": 3.02,
  "room": 3.37
 },
 "03.mp3": {
  "key": "81ea6315db5c",
  "tkey": "f3a7f7930954",
  "file": "03.mp3",
  "start": 13.0,
  "text": "最后，只回了一个字：「嗯」。",
  "speed": 0.92,
  "dur": 2.93,
  "room": 3.38
 },
 "04.mp3": {
  "key": "d6e7890190e7",
  "tkey": "decc742311f8",
  "file": "04.mp3",
  "start": 16.53,
  "text": "然后抱着手机，一直等到天亮。",
  "speed": 0.92,
  "dur": 2.53,
  "room": 6.02
 },
 "05.mp3": {
  "key": "7809d5e35fa5",
  "tkey": "fd6b428ad7ab",
  "file": "05.mp3",
  "start": 22.7,
  "text": "第二天，他撑着伞来找它。",
  "speed": 0.92,
  "dur": 2.5,
  "room": 2.75
 },
 "06.mp3": {
  "key": "34a662d0c223",
  "tkey": "0a220e6c03f3",
  "file": "06.mp3",
  "start": 25.6,
  "text": "它往前走了一步，又退了回去，把门关上了。",
  "speed": 0.92,
  "dur": 3.87,
  "room": 4.32
 },
 "07.mp3": {
  "key": "2247ea0bbb92",
  "tkey": "c5a084eb2cbe",
  "file": "07.mp3",
  "start": 30.07,
  "text": "门一关，它就哭了。",
  "speed": 0.92,
  "dur": 1.31,
  "room": 2.06
 },
 "08.mp3": {
  "key": "55a4b5433cf7",
  "tkey": "d9d741a70cf2",
  "file": "08.mp3",
  "start": 32.28,
  "text": "它不是不想被爱。它是太想了，又太怕了。",
  "speed": 0.92,
  "dur": 4.51,
  "room": 6.27
 },
 "09.mp3": {
  "key": "bea25317d3f6",
  "tkey": "7f2499a56c53",
  "file": "09.mp3",
  "start": 38.7,
  "text": "心理学家管这叫「恐惧型依恋」。",
  "speed": 0.92,
  "dur": 3.34,
  "room": 3.59
 },
 "10.mp3": {
  "key": "403dce9d06f2",
  "tkey": "bf8294b1667f",
  "file": "10.mp3",
  "start": 42.44,
  "text": "他们用两把尺子量一个人怎么谈感情：一把是「怕被丢下」，一把是「怕靠太近」。",
  "speed": 0.92,
  "dur": 6.79,
  "room": 7.04
 },
 "11.mp3": {
  "key": "b8855046b33a",
  "tkey": "5769b4c4c92f",
  "file": "11.mp3",
  "start": 49.63,
  "text": "焦虑型，第一把高；回避型，第二把高；恐惧型，两把都很高。",
  "speed": 0.92,
  "dur": 8.16,
  "room": 8.51
 },
 "12.mp3": {
  "key": "bd0dd0c016a1",
  "tkey": "128227abe1e2",
  "file": "12.mp3",
  "start": 58.29,
  "text": "研究者这样形容他们：渴望亲密，却因为害怕被拒绝，躲开了亲密。",
  "speed": 0.92,
  "dur": 5.96,
  "room": 6.26
 },
 "13.mp3": {
  "key": "3e42099e7097",
  "tkey": "cdec58ba45de",
  "file": "13.mp3",
  "start": 64.7,
  "text": "他们往往不太相信自己值得被爱，也不太敢相信别人。",
  "speed": 0.92,
  "dur": 4.44,
  "room": 5.85
 },
 "14.mp3": {
  "key": "89777dd5a081",
  "tkey": "75a7c3f7daca",
  "file": "14.mp3",
  "start": 70.7,
  "text": "所以在感情里，它心里像住着两个声音：",
  "speed": 0.92,
  "dur": 3.41,
  "room": 3.56
 },
 "15.mp3": {
  "key": "452c59febfa5",
  "tkey": "8f68610c3ac0",
  "file": "15.mp3",
  "start": 74.41,
  "text": "一个说：「快靠近他。」另一个说：「快跑，会受伤的。」",
  "speed": 0.92,
  "dur": 5.06,
  "room": 5.41
 },
 "16.mp3": {
  "key": "ecd2dd3bfd33",
  "tkey": "4a00e1960b63",
  "file": "16.mp3",
  "start": 79.97,
  "text": "他一靠近，它就想逃；他一走远，它又慌了。",
  "speed": 0.92,
  "dur": 4.42,
  "room": 4.72
 },
 "17.mp3": {
  "key": "e8049926fd7e",
  "tkey": "073b7fcd1019",
  "file": "17.mp3",
  "start": 84.84,
  "text": "先把人推开，是想在被丢下之前，先保护好自己。",
  "speed": 0.92,
  "dur": 4.6,
  "room": 4.95
 },
 "18.mp3": {
  "key": "48ff894f8dd9",
  "tkey": "3f8a1cc3d540",
  "file": "18.mp3",
  "start": 89.94,
  "text": "有个研究观察情侣面对面聊天：恐惧型的人，坐得离对方最远，说话也最紧张。",
  "speed": 0.92,
  "dur": 6.96,
  "room": 9.41
 },
 "19.mp3": {
  "key": "57ae84edef8c",
  "tkey": "59bcddacd584",
  "file": "19.mp3",
  "start": 99.5,
  "text": "这种矛盾，是从哪儿来的？",
  "speed": 0.92,
  "dur": 2.33,
  "room": 2.58
 },
 "20.mp3": {
  "key": "1cf52bce93d9",
  "tkey": "d935e2f5a385",
  "file": "20.mp3",
  "start": 102.23,
  "text": "研究者认为，可能和小时候有关：",
  "speed": 0.92,
  "dur": 2.53,
  "room": 2.68
 },
 "21.mp3": {
  "key": "149eb1260c35",
  "tkey": "166f5cd3f299",
  "file": "21.mp3",
  "start": 105.06,
  "text": "那个最该保护你的人，有时候，也是让你害怕的人。",
  "speed": 0.92,
  "dur": 4.66,
  "room": 5.01
 },
 "22.mp3": {
  "key": "a221ba3fa994",
  "tkey": "e1e9d2ccef03",
  "file": "22.mp3",
  "start": 110.22,
  "text": "想靠近，又想逃开，孩子就这样卡住了。",
  "speed": 0.92,
  "dur": 3.89,
  "room": 4.24
 },
 "23.mp3": {
  "key": "3fea5d753b30",
  "tkey": "0d0c1e7b731c",
  "file": "23.mp3",
  "start": 114.61,
  "text": "也可能是长大以后，在感情里被狠狠伤过。",
  "speed": 0.92,
  "dur": 3.48,
  "room": 7.14
 },
 "24.mp3": {
  "key": "604c674e63b9",
  "tkey": "0bcc2fe6d38a",
  "file": "24.mp3",
  "start": 121.9,
  "text": "如果你也是这样：",
  "speed": 0.92,
  "dur": 1.16,
  "room": 1.31
 },
 "25.mp3": {
  "key": "36ece4fea12e",
  "tkey": "5dccd4e8fc42",
  "file": "25.mp3",
  "start": 123.36,
  "text": "想逃的时候，先告诉自己：这是害怕，不是他不好。",
  "speed": 0.92,
  "dur": 4.5,
  "room": 4.8
 },
 "26.mp3": {
  "key": "ced945693ad6",
  "tkey": "ae94b0b509a0",
  "file": "26.mp3",
  "start": 128.31,
  "text": "想靠近的时候，不用一下子走完，一次一步就好。",
  "speed": 0.92,
  "dur": 4.09,
  "room": 4.39
 },
 "27.mp3": {
  "key": "1f1247f433da",
  "tkey": "06c5c3cbdf0e",
  "file": "27.mp3",
  "start": 132.85,
  "text": "也可以试着说出来：「我其实很在乎，只是有点怕。」",
  "speed": 0.92,
  "dur": 4.51,
  "room": 4.96
 },
 "28.mp3": {
  "key": "1e9cb3b4953b",
  "tkey": "dd6e0517ba67",
  "file": "28.mp3",
  "start": 137.96,
  "text": "如果你爱着一个恐惧型：",
  "speed": 0.92,
  "dur": 1.68,
  "room": 1.83
 },
 "29.mp3": {
  "key": "a09360589f55",
  "tkey": "f48b4d702f06",
  "file": "29.mp3",
  "start": 139.94,
  "text": "他推开你，不一定是不爱你。",
  "speed": 0.92,
  "dur": 2.79,
  "room": 3.04
 },
 "30.mp3": {
  "key": "d53568b3963a",
  "tkey": "6575b0d31bbc",
  "file": "30.mp3",
  "start": 143.13,
  "text": "别追得太紧，也别一走了之。稳定地出现，比说多少遍「我爱你」都管用。",
  "speed": 0.92,
  "dur": 6.52,
  "room": 6.87
 },
 "31.mp3": {
  "key": "87cb1d4dcf40",
  "tkey": "eb78af2c8b1e",
  "file": "31.mp3",
  "start": 150.15,
  "text": "依恋类型挺稳定，但不是一辈子的标签。",
  "speed": 0.92,
  "dur": 3.42,
  "room": 3.67
 },
 "32.mp3": {
  "key": "c8bcd2520e6c",
  "tkey": "f82e48546b1b",
  "file": "32.mp3",
  "start": 153.97,
  "text": "有些人在被好好对待的关系里，慢慢学会了不再害怕。",
  "speed": 0.92,
  "dur": 3.62,
  "room": 4.27
 },
 "33.mp3": {
  "key": "f2cdd12252d8",
  "tkey": "136c147237ef",
  "file": "33.mp3",
  "start": 158.39,
  "text": "越想要，越推开。慢一点，也能走近。",
  "speed": 0.92,
  "dur": 4.75,
  "room": 5.4
 },
 "34.mp3": {
  "key": "febc349765c9",
  "tkey": "1350b6247120",
  "file": "34.mp3",
  "start": 163.94,
  "text": "评论区说说：你有没有把一个很想要的人，推开过？",
  "speed": 0.92,
  "dur": 3.94,
  "room": 5.51
 }
}