{
 "00.mp3": {
  "key": "612b1430fa67",
  "start": 0.15,
  "text": "一家公司，把“凭本事说话”写进了核心价值。",
  "speed": 1.0,
  "dur": 3.67,
  "room": 3.8
 },
 "01.mp3": {
  "key": "8cf1a08868f3",
  "start": 4.1,
  "text": "业绩一样的一男一女，经理会怎么发奖金？先猜一个。",
  "speed": 1.051,
  "dur": 4.66,
  "room": 3.95
 },
 "02.mp3": {
  "key": "d5a59fc5ef0d",
  "start": 8.91,
  "text": "答案是 C：男员工平均多拿约 46 美元。",
  "speed": 1.3,
  "dur": 2.82,
  "room": 2.45
 },
 "03.mp3": {
  "key": "3fe75f602c70",
  "start": 11.88,
  "text": "换一家没强调“凭本事”的公司，",
  "speed": 1.0,
  "dur": 2.56,
  "room": 2.65
 },
 "04.mp3": {
  "key": "4003726cd666",
  "start": 14.59,
  "text": "这个差距，反而倒了过来。",
  "speed": 1.0,
  "dur": 2.4,
  "room": 2.55
 },
 "05.mp3": {
  "key": "df497886e466",
  "start": 17.14,
  "text": "研究者的解释是：",
  "speed": 1.0,
  "dur": 1.17,
  "room": 3.45
 },
 "06.mp3": {
  "key": "53d4b3032fca",
  "start": 19.9,
  "text": "越相信“我们这里最公平”，越不去检查自己。",
  "speed": 1.0,
  "dur": 3.78,
  "room": 3.95
 },
 "07.mp3": {
  "key": "a5ab5365021e",
  "start": 24.0,
  "text": "公平写在墙上，不等于做在了手上。",
  "speed": 1.0,
  "dur": 3.26,
  "room": 3.55
 },
 "08.mp3": {
  "key": "07532015e464",
  "start": 27.7,
  "text": "“凭本事”是个好理想，可它容易让人以为，已经做到了。",
  "speed": 1.0,
  "dur": 3.6,
  "room": 3.75
 },
 "09.mp3": {
  "key": "ac25012a760e",
  "start": 31.6,
  "text": "这就是「精英主义」的悖论：越信它，越难做到它。",
  "speed": 1.0,
  "dur": 4.88,
  "room": 5.85
 },
 "10.mp3": {
  "key": "7e04a3ee3c5d",
  "start": 37.6,
  "text": "还有一个偏差，让“凭本事”更难看清：",
  "speed": 1.0,
  "dur": 2.68,
  "room": 3.15
 },
 "11.mp3": {
  "key": "c6faebc32b49",
  "start": 40.9,
  "text": "我们清楚记得，自己顶过的每一阵逆风；",
  "speed": 1.0,
  "dur": 2.98,
  "room": 3.85
 },
 "12.mp3": {
  "key": "a861d223ac14",
  "start": 44.9,
  "text": "却很少注意，一路推着自己走的顺风。",
  "speed": 1.0,
  "dur": 2.76,
  "room": 3.85
 },
 "13.mp3": {
  "key": "5fc303f6d778",
  "start": 48.9,
  "text": "于是成功了，就容易觉得：全靠我自己。",
  "speed": 1.0,
  "dur": 3.41,
  "room": 4.55
 },
 "14.mp3": {
  "key": "17f8eb7af1f2",
  "start": 53.6,
  "text": "哲学家桑德尔担心，这样下去：",
  "speed": 1.0,
  "dur": 2.21,
  "room": 4.15
 },
 "15.mp3": {
  "key": "9808e362280a",
  "start": 57.9,
  "text": "赢的人，觉得自己配得上一切；",
  "speed": 1.0,
  "dur": 2.11,
  "room": 2.75
 },
 "16.mp3": {
  "key": "58f87776d979",
  "start": 60.8,
  "text": "没赢的人，觉得自己活该。",
  "speed": 1.0,
  "dur": 1.99,
  "room": 3.35
 },
 "17.mp3": {
  "key": "657542ec8209",
  "start": 64.3,
  "text": "所以，努力当然值得骄傲，",
  "speed": 1.0,
  "dur": 2.5,
  "room": 3.45
 },
 "18.mp3": {
  "key": "1d36a21650b3",
  "start": 67.9,
  "text": "但也可以数一数：一路上，帮过你的那些顺风。",
  "speed": 1.0,
  "dur": 3.36,
  "room": 4.15
 },
 "19.mp3": {
  "key": "6f1eb13ed367",
  "start": 72.13,
  "text": "看见运气，人也许会更谦虚，也更宽厚一点。",
  "speed": 1.0,
  "dur": 4.02,
  "room": 3.95
 },
 "20.mp3": {
  "key": "b7e8bf5fe3bc",
  "start": 76.3,
  "text": "哲学家罗尔斯写过：",
  "speed": 1.0,
  "dur": 1.44,
  "room": 3.75
 },
 "21.mp3": {
  "key": "e7088441a1fb",
  "start": 79.2,
  "text": "「没有人应得他更高的天赋，也没有人配得上一个更有利的起点。」—— 罗尔斯（大意）",
  "speed": 1.3,
  "dur": 5.62,
  "room": 4.55
 },
 "22.mp3": {
  "key": "8f784c602965",
  "start": 84.97,
  "text": "天赋和起点，很多时候是抽到的；",
  "speed": 1.0,
  "dur": 2.54,
  "room": 3.85
 },
 "23.mp3": {
  "key": "14d18a190103",
  "start": 88.9,
  "text": "能决定的，是拿到之后，怎么对待别人。",
  "speed": 1.0,
  "dur": 3.26,
  "room": 4.35
 },
 "24.mp3": {
  "key": "5446f3e095cf",
  "start": 93.4,
  "text": "努力值得骄傲，运气值得感谢。",
  "speed": 1.0,
  "dur": 3.29,
  "room": 4.85
 },
 "25.mp3": {
  "key": "90fd4067adcf",
  "start": 98.4,
  "text": "评论区：你觉得自己现在拥有的，有几成是运气？",
  "speed": 1.0,
  "dur": 3.61,
  "room": 5.45
 }
}