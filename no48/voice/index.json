{
 "00.mp3": {
  "key": "373ed519a0fd",
  "start": 0.15,
  "text": "穿一件很尴尬的 T 恤，走进一间满是人的教室。",
  "speed": 1.0,
  "dur": 3.36,
  "room": 3.8
 },
 "01.mp3": {
  "key": "23830a8f8c03",
  "start": 4.1,
  "text": "你会觉得有多少人注意到了？实际上呢？先猜一个。",
  "speed": 1.125,
  "dur": 3.92,
  "room": 3.95
 },
 "02.mp3": {
  "key": "567f1e1a84af",
  "start": 8.2,
  "text": "答案是：不到四分之一。",
  "speed": 1.0,
  "dur": 2.32,
  "room": 2.45
 },
 "03.mp3": {
  "key": "72c0433c5291",
  "start": 10.8,
  "text": "穿的人以为，大约一半人看见了；",
  "speed": 1.0,
  "dur": 2.5,
  "room": 2.65
 },
 "04.mp3": {
  "key": "c62b071e6684",
  "start": 13.6,
  "text": "实际记得的，只有约 23%。",
  "speed": 1.046,
  "dur": 2.37,
  "room": 2.55
 },
 "05.mp3": {
  "key": "d086b7903938",
  "start": 16.3,
  "text": "这是 2000 年，康奈尔的吉洛维奇做的实验。",
  "speed": 1.048,
  "dur": 2.71,
  "room": 3.45
 },
 "06.mp3": {
  "key": "1877eb1f7024",
  "start": 19.9,
  "text": "他把这叫「聚光灯效应」：",
  "speed": 1.0,
  "dur": 1.82,
  "room": 3.95
 },
 "07.mp3": {
  "key": "1991bf9230b8",
  "start": 23.44,
  "text": "我们总觉得自己站在舞台中央，灯只照着自己。",
  "speed": 1.0,
  "dur": 4.11,
  "room": 3.55
 },
 "08.mp3": {
  "key": "46bd3c77e177",
  "start": 27.7,
  "text": "可别人，也都在忙着照自己。",
  "speed": 1.0,
  "dur": 2.31,
  "room": 3.75
 },
 "09.mp3": {
  "key": "582857db01c2",
  "start": 31.6,
  "text": "这就是「自我中心主义」：把自己，看得比在别人眼里更大。",
  "speed": 1.0,
  "dur": 4.69,
  "room": 5.85
 },
 "10.mp3": {
  "key": "159757b2acfe",
  "start": 37.6,
  "text": "不只是衣服。",
  "speed": 1.0,
  "dur": 0.91,
  "room": 3.15
 },
 "11.mp3": {
  "key": "f121065ff269",
  "start": 40.9,
  "text": "上台发言时，你以为紧张全写在脸上；",
  "speed": 1.0,
  "dur": 2.87,
  "room": 3.85
 },
 "12.mp3": {
  "key": "4f4b99ba5459",
  "start": 44.9,
  "text": "可听的人，往往看不出来。",
  "speed": 1.0,
  "dur": 2.24,
  "room": 3.85
 },
 "13.mp3": {
  "key": "d01dbaaf1182",
  "start": 48.9,
  "text": "心理学家把这叫「透明度错觉」。",
  "speed": 1.0,
  "dur": 2.83,
  "room": 4.55
 },
 "14.mp3": {
  "key": "cbc055982d78",
  "start": 53.6,
  "text": "有意思的是：",
  "speed": 1.0,
  "dur": 0.9,
  "room": 4.15
 },
 "15.mp3": {
  "key": "02f9a2ad9eba",
  "start": 57.9,
  "text": "只要提前告诉演讲的人这一点，",
  "speed": 1.0,
  "dur": 2.12,
  "room": 2.75
 },
 "16.mp3": {
  "key": "4241b2665e4f",
  "start": 60.8,
  "text": "他们就没那么紧张，讲得也更好。",
  "speed": 1.0,
  "dur": 2.23,
  "room": 3.35
 },
 "17.mp3": {
  "key": "e113ae1b9437",
  "start": 64.3,
  "text": "所以，下次觉得「所有人都在看我」，",
  "speed": 1.0,
  "dur": 2.98,
  "room": 3.45
 },
 "18.mp3": {
  "key": "8001cb0eaf24",
  "start": 67.9,
  "text": "记得：大多数人，正忙着担心自己。",
  "speed": 1.0,
  "dur": 2.7,
  "room": 4.15
 },
 "19.mp3": {
  "key": "3f1e9db277ef",
  "start": 72.2,
  "text": "你的灯，没你想的那么亮。",
  "speed": 1.0,
  "dur": 1.89,
  "room": 3.95
 },
 "20.mp3": {
  "key": "a23709543f6e",
  "start": 76.3,
  "text": "有一句老话说：",
  "speed": 1.0,
  "dur": 1.19,
  "room": 3.75
 },
 "21.mp3": {
  "key": "bc6ad1917357",
  "start": 79.77,
  "text": "「要是你知道别人很少想到你，就不会那么在意别人怎么想你。」—— 奥林·米勒（大意）",
  "speed": 1.242,
  "dur": 4.98,
  "room": 4.55
 },
 "22.mp3": {
  "key": "8e22e2c71551",
  "start": 84.9,
  "text": "没那么多人在看你，",
  "speed": 1.0,
  "dur": 1.3,
  "room": 3.85
 },
 "23.mp3": {
  "key": "8ada805b2680",
  "start": 88.9,
  "text": "所以，你可以更自在一点。",
  "speed": 1.0,
  "dur": 2.11,
  "room": 4.35
 },
 "24.mp3": {
  "key": "e395470f6afc",
  "start": 93.4,
  "text": "没人在看，就大胆一点。",
  "speed": 1.0,
  "dur": 1.79,
  "room": 4.85
 },
 "25.mp3": {
  "key": "8b712f2ed7f2",
  "start": 98.4,
  "text": "评论区：你有过哪次「全世界都在看我」的尴尬？",
  "speed": 1.0,
  "dur": 3.86,
  "room": 5.45
 }
}