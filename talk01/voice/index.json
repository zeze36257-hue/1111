{
 "00.mp3": {
  "key": "ffd024406b51",
  "start": 0.15,
  "text": "你有没有发现：",
  "speed": 1.0,
  "dur": 0.89,
  "room": 1.75
 },
 "01.mp3": {
  "key": "d743890bc116",
  "start": 2.05,
  "text": "小时候交朋友，只要一句“一起玩吧”。",
  "speed": 1.0,
  "dur": 2.92,
  "room": 3.45
 },
 "02.mp3": {
  "key": "303e80cb1277",
  "start": 5.65,
  "text": "长大以后，通讯录里几百个人，",
  "speed": 1.0,
  "dur": 2.63,
  "room": 3.05
 },
 "03.mp3": {
  "key": "a9b4a4b04fff",
  "start": 8.85,
  "text": "能在半夜打个电话的，一只手就数得过来。",
  "speed": 1.0,
  "dur": 3.25,
  "room": 4.15
 },
 "04.mp3": {
  "key": "8fc2cc351081",
  "start": 13.15,
  "text": "有人分析过三百多万人的通话记录：",
  "speed": 1.0,
  "dur": 2.6,
  "room": 3.75
 },
 "05.mp3": {
  "key": "fd50a0ebd8e9",
  "start": 17.05,
  "text": "一个人经常联系的人数，大约在25岁到顶，",
  "speed": 1.0,
  "dur": 3.58,
  "room": 4.35
 },
 "06.mp3": {
  "key": "506465dc15c2",
  "start": 21.55,
  "text": "之后就开始往下走。",
  "speed": 1.0,
  "dur": 1.08,
  "room": 2.15
 },
 "07.mp3": {
  "key": "ca4a1c1e8b19",
  "start": 23.85,
  "text": "为什么越长大，朋友越少？",
  "speed": 1.0,
  "dur": 2.22,
  "room": 2.65
 },
 "08.mp3": {
  "key": "4c2d59405a55",
  "start": 26.65,
  "text": "是你变冷漠了吗？其实，不全是。",
  "speed": 1.0,
  "dur": 3.69,
  "room": 5.5
 },
 "09.mp3": {
  "key": "e60b8f8013fc",
  "start": 32.3,
  "text": "交朋友，是要花时间的。",
  "speed": 1.0,
  "dur": 2.18,
  "room": 2.45
 },
 "10.mp3": {
  "key": "62c0b158d079",
  "start": 34.9,
  "text": "美国有研究估算过：",
  "speed": 1.0,
  "dur": 1.26,
  "room": 2.15
 },
 "11.mp3": {
  "key": "0f704cfec630",
  "start": 37.2,
  "text": "从陌生人变成普通朋友，大约要一起待50个小时；",
  "speed": 1.0,
  "dur": 3.57,
  "room": 5.05
 },
 "12.mp3": {
  "key": "a3c6a1d75173",
  "start": 42.4,
  "text": "变成好朋友，要200个小时以上。",
  "speed": 1.0,
  "dur": 2.58,
  "room": 3.45
 },
 "14.mp3": {
  "key": "f285c36e34d4",
  "start": 50.3,
  "text": "一起开会加班，几乎不算。",
  "speed": 1.0,
  "dur": 1.83,
  "room": 2.65
 },
 "15.mp3": {
  "key": "342a77571485",
  "start": 53.1,
  "text": "上学的时候，这200个小时是白送的：",
  "speed": 1.0,
  "dur": 2.64,
  "room": 3.95
 },
 "16.mp3": {
  "key": "feccdb5a94fc",
  "start": 57.2,
  "text": "同一个教室，同一个宿舍，一待就是好几年。",
  "speed": 1.0,
  "dur": 4.05,
  "room": 4.15
 },
 "17.mp3": {
  "key": "83bb9afed924",
  "start": 61.5,
  "text": "工作以后，谁还有200个小时，",
  "speed": 1.0,
  "dur": 2.5,
  "room": 3.25
 },
 "18.mp3": {
  "key": "2012821f2127",
  "start": 64.9,
  "text": "陪一个人什么都不干？",
  "speed": 1.0,
  "dur": 1.3,
  "room": 5.65
 },
 "19.mp3": {
  "key": "846e625e68f5",
  "start": 70.7,
  "text": "社会学家说，亲密的友谊要三个条件：",
  "speed": 1.0,
  "dur": 3.13,
  "room": 3.75
 },
 "20.mp3": {
  "key": "ad187c1a82ab",
  "start": 74.6,
  "text": "离得近；经常不经意地碰面；",
  "speed": 1.0,
  "dur": 2.65,
  "room": 2.85
 },
 "21.mp3": {
  "key": "1934f487a530",
  "start": 77.6,
  "text": "还有一个能放下防备、说真心话的地方。",
  "speed": 1.0,
  "dur": 3.24,
  "room": 3.95
 },
 "23.mp3": {
  "key": "5ebb8a18f63c",
  "start": 84.0,
  "text": "长大以后，它们一个一个消失：",
  "speed": 1.0,
  "dur": 2.54,
  "room": 3.05
 },
 "24.mp3": {
  "key": "415a56935217",
  "start": 87.2,
  "text": "大家去了不同的城市，见面要提前约，约了还常常改期；",
  "speed": 1.0,
  "dur": 4.52,
  "room": 5.25
 },
 "25.mp3": {
  "key": "5273858caacb",
  "start": 92.6,
  "text": "见了面，也很难再什么都说。",
  "speed": 1.0,
  "dur": 2.38,
  "room": 6.75
 },
 "26.mp3": {
  "key": "00553ce0189b",
  "start": 99.5,
  "text": "但还有一个原因，不全是坏事。",
  "speed": 1.0,
  "dur": 2.42,
  "room": 3.05
 },
 "27.mp3": {
  "key": "783573f2f9c9",
  "start": 102.7,
  "text": "两千多年前，亚里士多德把友谊分成三种：",
  "speed": 1.0,
  "dur": 3.31,
  "room": 4.15
 },
 "28.mp3": {
  "key": "8889ca8b0ee3",
  "start": 107.0,
  "text": "因为有用，因为开心，和因为欣赏对方这个人。",
  "speed": 1.0,
  "dur": 4.03,
  "room": 4.35
 },
 "29.mp3": {
  "key": "2e2b71ab9520",
  "start": 111.5,
  "text": "前两种，环境一变就散了；",
  "speed": 1.0,
  "dur": 2.45,
  "room": 2.65
 },
 "30.mp3": {
  "key": "5bb6a2e396bd",
  "start": 114.3,
  "text": "只有第三种，会留下来。",
  "speed": 1.0,
  "dur": 1.7,
  "room": 2.45
 },
 "31.mp3": {
  "key": "60dc08eb55a5",
  "start": 116.9,
  "text": "心理学家也发现：年纪越大，泛泛之交越少，",
  "speed": 1.0,
  "dur": 3.71,
  "room": 4.15
 },
 "32.mp3": {
  "key": "a5ccc06e1949",
  "start": 121.2,
  "text": "可真正亲近的人，并没有变少。",
  "speed": 1.0,
  "dur": 2.35,
  "room": 6.95
 },
 "33.mp3": {
  "key": "e3a870e7050b",
  "start": 128.3,
  "text": "所以，朋友变少，不一定是你失去了什么，",
  "speed": 1.0,
  "dur": 3.26,
  "room": 3.95
 },
 "34.mp3": {
  "key": "3332aa81ff4e",
  "start": 132.4,
  "text": "也可能是你终于知道，什么值得。",
  "speed": 1.0,
  "dur": 2.88,
  "room": 3.25
 },
 "35.mp3": {
  "key": "249694dca99b",
  "start": 135.8,
  "text": "只是成年人的友谊，不会再自然发生了，",
  "speed": 1.0,
  "dur": 3.19,
  "room": 3.95
 },
 "37.mp3": {
  "key": "50b524a16958",
  "start": 144.8,
  "text": "如果你刚才想到了某个人，",
  "speed": 1.0,
  "dur": 1.54,
  "room": 2.85
 },
 "38.mp3": {
  "key": "4ce5e8370bed",
  "start": 147.8,
  "text": "现在就给他发条消息吧。",
  "speed": 1.0,
  "dur": 1.61,
  "room": 2.65
 },
 "13.mp3": {
  "key": "aa6d2668efe8",
  "start": 45.99,
  "text": "而且得是闲着的时间：吃饭、聊天、一起瞎玩。",
  "speed": 1.0,
  "dur": 4.16,
  "room": 4.15
 },
 "22.mp3": {
  "key": "865f134588d7",
  "start": 81.7,
  "text": "学校，三样全给你了。",
  "speed": 1.0,
  "dur": 1.95,
  "room": 2.15
 },
 "36.mp3": {
  "key": "69d73dad7ed1",
  "start": 139.71,
  "text": "得有人先伸手：一条消息，一顿饭，一句“最近怎么样”。",
  "speed": 1.0,
  "dur": 4.94,
  "room": 4.75
 },
 "39.mp3": {
  "key": "622953c19a42",
  "start": 149.97,
  "text": "评论区说说：现在还能让你半夜打电话的朋友，你有几个？",
  "speed": 1.102,
  "dur": 3.48,
  "room": 2.85
 }
}