{
 "00.mp3": {
  "key": "b285e4789b00",
  "start": 0.15,
  "text": "两只猴子，做一样的事：交一块小石头，换一份吃的。",
  "speed": 1.3,
  "dur": 3.81,
  "room": 3.8
 },
 "01.mp3": {
  "key": "1120cac38547",
  "start": 4.11,
  "text": "一只拿到葡萄，另一只拿到黄瓜。它会怎样？先猜一个。",
  "speed": 1.3,
  "dur": 3.4,
  "room": 3.95
 },
 "02.mp3": {
  "key": "11cb2dc5c67e",
  "start": 8.2,
  "text": "答案是：常常不干了。",
  "speed": 1.0,
  "dur": 2.29,
  "room": 2.45
 },
 "03.mp3": {
  "key": "6a560bb58b02",
  "start": 10.8,
  "text": "有的，直接把黄瓜扔了回去；",
  "speed": 1.0,
  "dur": 2.17,
  "room": 2.65
 },
 "04.mp3": {
  "key": "597a526a4e7d",
  "start": 13.6,
  "text": "可平时，黄瓜它吃得好好的。",
  "speed": 1.0,
  "dur": 2.33,
  "room": 2.55
 },
 "05.mp3": {
  "key": "b45e8414a894",
  "start": 16.23,
  "text": "这是 2003 年，布罗斯南和德瓦尔的实验。",
  "speed": 1.045,
  "dur": 3.58,
  "room": 3.45
 },
 "06.mp3": {
  "key": "c7475e2caad1",
  "start": 19.96,
  "text": "两边都拿黄瓜时，猴子几乎每次都肯换；",
  "speed": 1.0,
  "dur": 3.05,
  "room": 3.95
 },
 "07.mp3": {
  "key": "8f3bf4b7feec",
  "start": 24.0,
  "text": "隔壁换来的是葡萄，肯换的只剩约六成；",
  "speed": 1.0,
  "dur": 2.83,
  "room": 3.55
 },
 "08.mp3": {
  "key": "fe21a0e16830",
  "start": 27.7,
  "text": "隔壁什么都不做就拿到葡萄，只剩约两成。",
  "speed": 1.0,
  "dur": 2.8,
  "room": 3.75
 },
 "09.mp3": {
  "key": "bfb0dd48dec4",
  "start": 31.6,
  "text": "这就是「平均主义」的直觉：一样的付出，该得一样的东西。",
  "speed": 1.0,
  "dur": 4.5,
  "room": 5.85
 },
 "10.mp3": {
  "key": "f0d5fb0717ca",
  "start": 37.6,
  "text": "人也一样。有一个分钱游戏：",
  "speed": 1.0,
  "dur": 2.58,
  "room": 3.15
 },
 "11.mp3": {
  "key": "3b589eea6f22",
  "start": 40.48,
  "text": "对方分 100 块，给你 20；你不接受，两个人都拿不到。",
  "speed": 1.044,
  "dur": 4.3,
  "room": 3.85
 },
 "12.mp3": {
  "key": "e640e6f48096",
  "start": 44.93,
  "text": "很多人会拒绝，宁可两手空空。",
  "speed": 1.0,
  "dur": 3.21,
  "room": 3.85
 },
 "13.mp3": {
  "key": "ed4b883c6f8d",
  "start": 48.9,
  "text": "不是不要钱，是不想被不公平地对待。",
  "speed": 1.0,
  "dur": 2.67,
  "room": 4.55
 },
 "14.mp3": {
  "key": "ea2becb41aab",
  "start": 53.6,
  "text": "可公平，不等于平均。",
  "speed": 1.0,
  "dur": 2.22,
  "room": 4.15
 },
 "15.mp3": {
  "key": "fb7cf13058b0",
  "start": 57.9,
  "text": "如果有人确实做得更多，",
  "speed": 1.0,
  "dur": 1.73,
  "room": 2.75
 },
 "16.mp3": {
  "key": "cccc77c91f7f",
  "start": 60.62,
  "text": "大多数人，连小孩子，都愿意让他多拿。",
  "speed": 1.0,
  "dur": 3.53,
  "room": 3.35
 },
 "17.mp3": {
  "key": "3ef837707ba6",
  "start": 64.3,
  "text": "所以，觉得委屈的时候，先分清：",
  "speed": 1.0,
  "dur": 2.98,
  "room": 3.45
 },
 "18.mp3": {
  "key": "018d1f54d495",
  "start": 67.9,
  "text": "是我拿得少，还是规则不公平？",
  "speed": 1.0,
  "dur": 2.59,
  "room": 4.15
 },
 "19.mp3": {
  "key": "a799d169b56a",
  "start": 72.2,
  "text": "前者，可以放下；后者，值得说出来。",
  "speed": 1.0,
  "dur": 3.71,
  "room": 3.95
 },
 "20.mp3": {
  "key": "83659d960b13",
  "start": 76.3,
  "text": "耶鲁的研究者总结过：",
  "speed": 1.0,
  "dur": 1.59,
  "room": 3.75
 },
 "21.mp3": {
  "key": "f190690a62a2",
  "start": 79.2,
  "text": "「让人不满的，不是不平等，而是不公平。」—— 斯塔曼斯、谢斯金 & 布鲁姆（大意）",
  "speed": 1.3,
  "dur": 6.0,
  "room": 4.55
 },
 "22.mp3": {
  "key": "735a332e858f",
  "start": 85.35,
  "text": "人们在意的，从来不是一样多，",
  "speed": 1.0,
  "dur": 2.6,
  "room": 3.85
 },
 "23.mp3": {
  "key": "9c5225c64a55",
  "start": 88.9,
  "text": "而是一样被公平地对待。",
  "speed": 1.0,
  "dur": 1.79,
  "room": 4.35
 },
 "24.mp3": {
  "key": "e200f798d28b",
  "start": 93.4,
  "text": "不求一样多，只求一样公平。",
  "speed": 1.0,
  "dur": 2.37,
  "room": 4.85
 },
 "25.mp3": {
  "key": "7086afa67249",
  "start": 98.4,
  "text": "评论区：你遇到过的「黄瓜时刻」是什么？",
  "speed": 1.0,
  "dur": 3.21,
  "room": 5.45
 }
}