{
 "00.mp3": {
  "key": "993b35f2fad8",
  "start": 0.15,
  "text": "两个候选人，你不认识他们，只看一秒照片。",
  "speed": 1.0,
  "dur": 3.76,
  "room": 3.8
 },
 "01.mp3": {
  "key": "95e545a333d2",
  "start": 4.1,
  "text": "选「看起来更能干」的那个，能猜中多少场选举？先猜一个。",
  "speed": 1.3,
  "dur": 3.59,
  "room": 3.95
 },
 "02.mp3": {
  "key": "9bad7402eeaa",
  "start": 8.2,
  "text": "答案是：约七成。",
  "speed": 1.0,
  "dur": 1.51,
  "room": 2.45
 },
 "03.mp3": {
  "key": "8302a00999b7",
  "start": 10.35,
  "text": "只看一眼脸，就猜中了大约七成的结果；",
  "speed": 1.0,
  "dur": 3.1,
  "room": 2.65
 },
 "04.mp3": {
  "key": "87afe583e2a6",
  "start": 13.6,
  "text": "后来发现，0.1 秒就够了。",
  "speed": 1.0,
  "dur": 2.55,
  "room": 2.55
 },
 "05.mp3": {
  "key": "1d6b41a16417",
  "start": 16.3,
  "text": "这是普林斯顿的托多罗夫，2005 年发表的研究。",
  "speed": 1.224,
  "dur": 3.26,
  "room": 3.45
 },
 "06.mp3": {
  "key": "66dcff6f1dd1",
  "start": 19.87,
  "text": "参与者对这些人一无所知，只凭一张脸。",
  "speed": 1.0,
  "dur": 3.98,
  "room": 3.95
 },
 "07.mp3": {
  "key": "c4a0dea65a34",
  "start": 24.0,
  "text": "让他们多想一会儿，反而猜得没那么准。",
  "speed": 1.0,
  "dur": 2.77,
  "room": 3.55
 },
 "08.mp3": {
  "key": "c59f398ea082",
  "start": 27.7,
  "text": "第一眼的判断，又快又固执。",
  "speed": 1.0,
  "dur": 2.36,
  "room": 3.75
 },
 "09.mp3": {
  "key": "7b441b3a5d6d",
  "start": 31.6,
  "text": "这就是「外貌主义」：先看脸，再看人。",
  "speed": 1.0,
  "dur": 3.37,
  "room": 5.85
 },
 "10.mp3": {
  "key": "799f705aa7b3",
  "start": 37.6,
  "text": "脸，不只影响选票。",
  "speed": 1.0,
  "dur": 1.77,
  "room": 3.15
 },
 "11.mp3": {
  "key": "1ca05b2c6759",
  "start": 39.98,
  "text": "经济学家发现：相貌平平的人，收入约少 5% 到 10%；",
  "speed": 1.0,
  "dur": 4.77,
  "room": 3.85
 },
 "12.mp3": {
  "key": "b7c39c702146",
  "start": 44.9,
  "text": "长得好看的人，也会多拿一点。",
  "speed": 1.0,
  "dur": 2.34,
  "room": 3.85
 },
 "13.mp3": {
  "key": "acae812f1955",
  "start": 48.9,
  "text": "我们以为在看能力，其实常常在看光环。",
  "speed": 1.0,
  "dur": 3.18,
  "room": 4.55
 },
 "14.mp3": {
  "key": "8cf31bb99d3a",
  "start": 53.6,
  "text": "可是，靠脸看人，准吗？",
  "speed": 1.0,
  "dur": 3.11,
  "room": 4.15
 },
 "15.mp3": {
  "key": "e88b0e0d92ba",
  "start": 57.9,
  "text": "一项分析了 100 多万次判断的研究发现：",
  "speed": 1.0,
  "dur": 2.4,
  "room": 2.75
 },
 "16.mp3": {
  "key": "c4825145654e",
  "start": 60.8,
  "text": "靠脸猜，还不如不看脸、只凭常识猜得准。",
  "speed": 1.152,
  "dur": 3.28,
  "room": 3.35
 },
 "17.mp3": {
  "key": "5c722740f25a",
  "start": 64.3,
  "text": "所以，下次第一眼不喜欢一个人，",
  "speed": 1.0,
  "dur": 2.7,
  "room": 3.45
 },
 "18.mp3": {
  "key": "982f289ad275",
  "start": 67.9,
  "text": "先等一等，给第二眼一个机会。",
  "speed": 1.0,
  "dur": 2.07,
  "room": 4.15
 },
 "19.mp3": {
  "key": "a0e5036fce79",
  "start": 72.2,
  "text": "脸，是封面；人，是内容。",
  "speed": 1.0,
  "dur": 3.85,
  "room": 3.95
 },
 "20.mp3": {
  "key": "57b019a852e6",
  "start": 76.3,
  "text": "《小王子》里，狐狸说：",
  "speed": 1.0,
  "dur": 1.83,
  "room": 3.75
 },
 "21.mp3": {
  "key": "abb3f3719157",
  "start": 79.2,
  "text": "「真正重要的东西，用眼睛是看不见的。」—— 圣埃克苏佩里《小王子》",
  "speed": 1.067,
  "dur": 5.63,
  "room": 4.55
 },
 "22.mp3": {
  "key": "292666e96ef0",
  "start": 84.98,
  "text": "第一眼，你看到的是脸；",
  "speed": 1.0,
  "dur": 1.89,
  "room": 3.85
 },
 "23.mp3": {
  "key": "6e3cdb7a18d4",
  "start": 88.9,
  "text": "第二眼，才开始看见人。",
  "speed": 1.0,
  "dur": 2.31,
  "room": 4.35
 },
 "24.mp3": {
  "key": "7c49afd54864",
  "start": 93.4,
  "text": "第一眼，只是第一眼。",
  "speed": 1.0,
  "dur": 2.17,
  "room": 4.85
 },
 "25.mp3": {
  "key": "7f9053111074",
  "start": 98.4,
  "text": "评论区：你有没有看错过一个人？",
  "speed": 1.0,
  "dur": 2.34,
  "room": 5.45
 }
}