{
 "00.mp3": {
  "key": "0b07d792a199",
  "start": 0.15,
  "text": "对讲机里，有人突然发病了。",
  "speed": 1.0,
  "dur": 2.49,
  "room": 3.8
 },
 "01.mp3": {
  "key": "41dea33edd9c",
  "start": 3.56,
  "text": "只有你听见，还是 5 个人都听见？哪种更会去帮？先猜一个。",
  "speed": 1.159,
  "dur": 4.49,
  "room": 3.95
 },
 "02.mp3": {
  "key": "2132fd3abdb7",
  "start": 8.2,
  "text": "答案是：只有你听见的时候。",
  "speed": 1.118,
  "dur": 2.23,
  "room": 2.45
 },
 "03.mp3": {
  "key": "743829501fa1",
  "start": 10.73,
  "text": "以为只有自己，约 85% 的人在发作结束前去帮忙；",
  "speed": 1.3,
  "dur": 3.29,
  "room": 2.65
 },
 "04.mp3": {
  "key": "4074630638e0",
  "start": 14.17,
  "text": "以为还有 4 个人，只剩约 31%。",
  "speed": 1.22,
  "dur": 2.4,
  "room": 2.55
 },
 "05.mp3": {
  "key": "d263a4f8161d",
  "start": 16.72,
  "text": "这是 1968 年，达利和拉塔内的实验。",
  "speed": 1.0,
  "dur": 2.85,
  "room": 3.45
 },
 "06.mp3": {
  "key": "af2d5e3b1457",
  "start": 19.9,
  "text": "人越多，每个人心里那份「该我去」就越少。",
  "speed": 1.146,
  "dur": 2.65,
  "room": 3.95
 },
 "07.mp3": {
  "key": "840311bee400",
  "start": 24.0,
  "text": "心理学家把这叫「责任分散」。",
  "speed": 1.0,
  "dur": 2.28,
  "room": 3.55
 },
 "08.mp3": {
  "key": "4d01d74cfbfc",
  "start": 27.7,
  "text": "每个人都在等，等一个英雄出现。",
  "speed": 1.0,
  "dur": 2.56,
  "room": 3.75
 },
 "09.mp3": {
  "key": "84d3271c34cd",
  "start": 31.6,
  "text": "这就是「英雄主义」的另一面：都盼着英雄，却没人先动。",
  "speed": 1.0,
  "dur": 4.84,
  "room": 5.85
 },
 "10.mp3": {
  "key": "acff73efac8c",
  "start": 37.6,
  "text": "他们还做过一个实验：房间里慢慢冒烟。",
  "speed": 1.0,
  "dur": 3.0,
  "room": 3.15
 },
 "11.mp3": {
  "key": "6137b75f9c9e",
  "start": 40.9,
  "text": "一个人在屋里时，大多数人会出去报告；",
  "speed": 1.0,
  "dur": 2.47,
  "room": 3.85
 },
 "12.mp3": {
  "key": "3a11068959a7",
  "start": 44.9,
  "text": "身边坐着两个毫无反应的人，只剩约一成。",
  "speed": 1.0,
  "dur": 3.13,
  "room": 3.85
 },
 "13.mp3": {
  "key": "63db785d0123",
  "start": 48.9,
  "text": "别人不动，我们就以为：没事。",
  "speed": 1.0,
  "dur": 2.64,
  "room": 4.55
 },
 "14.mp3": {
  "key": "44e8d0145c4f",
  "start": 53.6,
  "text": "可真实的街头，没那么冷漠。",
  "speed": 1.0,
  "dur": 2.51,
  "room": 4.15
 },
 "15.mp3": {
  "key": "758acd98b5fd",
  "start": 57.9,
  "text": "研究者看了 219 次街头冲突的监控：",
  "speed": 1.0,
  "dur": 2.68,
  "room": 2.75
 },
 "16.mp3": {
  "key": "3d012e6530ce",
  "start": 60.8,
  "text": "十次里有九次，至少有一个人上前帮忙。",
  "speed": 1.107,
  "dur": 2.88,
  "room": 3.35
 },
 "17.mp3": {
  "key": "a3fdfa72acb4",
  "start": 64.3,
  "text": "所以，如果你需要帮助，别对着人群喊；",
  "speed": 1.052,
  "dur": 3.14,
  "room": 3.45
 },
 "18.mp3": {
  "key": "f1075795f3d3",
  "start": 67.86,
  "text": "指着一个人说：「穿蓝衣服的你，请帮我打 120。」",
  "speed": 1.0,
  "dur": 4.19,
  "room": 4.15
 },
 "19.mp3": {
  "key": "9f16371073cb",
  "start": 72.2,
  "text": "责任落到具体的人身上，他就更容易动起来。",
  "speed": 1.0,
  "dur": 3.06,
  "room": 3.95
 },
 "20.mp3": {
  "key": "cf63f5467152",
  "start": 76.3,
  "text": "有一句话说：",
  "speed": 1.0,
  "dur": 1.33,
  "room": 3.75
 },
 "21.mp3": {
  "key": "6488550fa370",
  "start": 79.91,
  "text": "「爱的反面不是恨，是冷漠。」—— 埃利·维瑟尔",
  "speed": 1.0,
  "dur": 4.84,
  "room": 4.55
 },
 "22.mp3": {
  "key": "900bc8b9e6f2",
  "start": 84.9,
  "text": "英雄，不用等别人；",
  "speed": 1.0,
  "dur": 1.73,
  "room": 3.85
 },
 "23.mp3": {
  "key": "cec83af24ccc",
  "start": 88.9,
  "text": "你可以就是那第一个人。",
  "speed": 1.0,
  "dur": 1.52,
  "room": 4.35
 },
 "24.mp3": {
  "key": "4e803994f5c5",
  "start": 93.4,
  "text": "别等英雄，你就是第一个。",
  "speed": 1.0,
  "dur": 2.16,
  "room": 4.85
 },
 "25.mp3": {
  "key": "601e3ecf6b39",
  "start": 98.4,
  "text": "评论区：你有没有当过那个「第一个站出来」的人？",
  "speed": 1.0,
  "dur": 2.95,
  "room": 5.45
 }
}