{
 "00.mp3": {
  "key": "06d3acd9beec",
  "start": 0.15,
  "text": "找工作时，非要找到「最好」那份的人，",
  "speed": 1.0,
  "dur": 2.78,
  "room": 3.8
 },
 "01.mp3": {
  "key": "9a156fb80de6",
  "start": 3.29,
  "text": "起薪会比别人高、低，还是差不多？先猜一个。",
  "speed": 1.0,
  "dur": 4.76,
  "room": 3.95
 },
 "02.mp3": {
  "key": "b92798d4ed71",
  "start": 8.2,
  "text": "答案是：高约两成。",
  "speed": 1.0,
  "dur": 2.13,
  "room": 2.45
 },
 "03.mp3": {
  "key": "3e4f6497cc53",
  "start": 10.65,
  "text": "可是，他们对拿到的工作，反而更不满意；",
  "speed": 1.114,
  "dur": 2.8,
  "room": 2.65
 },
 "04.mp3": {
  "key": "b351a9ee097b",
  "start": 13.6,
  "text": "找工作的过程，也更焦虑、更累。",
  "speed": 1.268,
  "dur": 2.54,
  "room": 2.55
 },
 "05.mp3": {
  "key": "4ad3bbe4d25e",
  "start": 16.3,
  "text": "心理学家施瓦茨，把人大致分成两种：",
  "speed": 1.0,
  "dur": 2.65,
  "room": 3.45
 },
 "06.mp3": {
  "key": "64522573699d",
  "start": 19.76,
  "text": "一种是「最大化者」：每个选项都要比一遍，非要最好的。",
  "speed": 1.115,
  "dur": 4.09,
  "room": 3.95
 },
 "07.mp3": {
  "key": "97f4125ff983",
  "start": 24.0,
  "text": "另一种是「满意者」：碰到够好的，就收手。",
  "speed": 1.161,
  "dur": 3.9,
  "room": 3.55
 },
 "08.mp3": {
  "key": "126ba4ebc7bf",
  "start": 28.05,
  "text": "最大化者常常选得更好，却不一定过得更开心。",
  "speed": 1.126,
  "dur": 3.41,
  "room": 3.75
 },
 "09.mp3": {
  "key": "af06fa30c77d",
  "start": 31.61,
  "text": "这就是「最大化主义」：只有最好，才算对。",
  "speed": 1.0,
  "dur": 4.1,
  "room": 5.85
 },
 "10.mp3": {
  "key": "ade1109aaf25",
  "start": 37.6,
  "text": "问题在于，「最好」永远在下一个。",
  "speed": 1.0,
  "dur": 2.7,
  "room": 3.15
 },
 "11.mp3": {
  "key": "3947908b07d3",
  "start": 40.9,
  "text": "你选了这个，脑子里还在想那些没选的；",
  "speed": 1.0,
  "dur": 2.99,
  "room": 3.85
 },
 "12.mp3": {
  "key": "f8d86688acfb",
  "start": 44.9,
  "text": "选项越多，没选的越多，后悔也越多。",
  "speed": 1.0,
  "dur": 3.36,
  "room": 3.85
 },
 "13.mp3": {
  "key": "149ea709579a",
  "start": 48.56,
  "text": "研究发现：越想要最好的人，往往后悔更多、幸福感更低。",
  "speed": 1.059,
  "dur": 4.91,
  "room": 4.55
 },
 "14.mp3": {
  "key": "ad78108a7cc8",
  "start": 53.62,
  "text": "诺贝尔奖得主西蒙，提出过另一条路：",
  "speed": 1.0,
  "dur": 2.9,
  "room": 4.15
 },
 "15.mp3": {
  "key": "7f53e40f0337",
  "start": 57.9,
  "text": "先定一个「够好」的标准，",
  "speed": 1.0,
  "dur": 1.32,
  "room": 2.75
 },
 "16.mp3": {
  "key": "8936d4a069af",
  "start": 60.8,
  "text": "碰到了，就停。他叫它「满意即可」。",
  "speed": 1.0,
  "dur": 2.78,
  "room": 3.35
 },
 "17.mp3": {
  "key": "9f97adf314f2",
  "start": 64.3,
  "text": "所以，下次挑到停不下来时，",
  "speed": 1.0,
  "dur": 2.47,
  "room": 3.45
 },
 "18.mp3": {
  "key": "876371c7bbf3",
  "start": 67.9,
  "text": "先问自己：我的「够好」，是什么？",
  "speed": 1.0,
  "dur": 2.72,
  "room": 4.15
 },
 "19.mp3": {
  "key": "9561c5cbe652",
  "start": 72.2,
  "text": "找到了，就别再回头看。",
  "speed": 1.0,
  "dur": 1.88,
  "room": 3.95
 },
 "20.mp3": {
  "key": "085860ac15de",
  "start": 76.3,
  "text": "两百多年前，伏尔泰写过：",
  "speed": 1.0,
  "dur": 2.31,
  "room": 3.75
 },
 "21.mp3": {
  "key": "d676d83ef544",
  "start": 80.2,
  "text": "「最好，是好的敌人。」—— 伏尔泰",
  "speed": 1.0,
  "dur": 3.14,
  "room": 4.55
 },
 "22.mp3": {
  "key": "e198c937ff10",
  "start": 84.9,
  "text": "追求最好，没有错；",
  "speed": 1.0,
  "dur": 1.75,
  "room": 3.85
 },
 "23.mp3": {
  "key": "d5c2573f4588",
  "start": 88.9,
  "text": "可停不下来，好的也会变得不够好。",
  "speed": 1.0,
  "dur": 2.46,
  "room": 4.35
 },
 "24.mp3": {
  "key": "e56ab2b7ea77",
  "start": 93.4,
  "text": "找到够好的，就停下。",
  "speed": 1.0,
  "dur": 1.94,
  "room": 4.85
 },
 "25.mp3": {
  "key": "e793ce406674",
  "start": 98.4,
  "text": "评论区：你是「最大化者」，还是「满意者」？",
  "speed": 1.0,
  "dur": 3.28,
  "room": 5.45
 }
}