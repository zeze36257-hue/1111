{
 "00.mp3": {
  "key": "06eaf4a2c2fc",
  "start": 0.15,
  "text": "通勤火车上，一组人被要求跟陌生人聊天，",
  "speed": 1.0,
  "dur": 3.0,
  "room": 3.8
 },
 "01.mp3": {
  "key": "f7b9bdcc9a6d",
  "start": 3.64,
  "text": "另一组自己安静坐着。谁更愉快？先猜一个。",
  "speed": 1.0,
  "dur": 4.41,
  "room": 3.95
 },
 "02.mp3": {
  "key": "d2c1e6697610",
  "start": 8.2,
  "text": "答案是 C：聊天的那组。",
  "speed": 1.089,
  "dur": 2.32,
  "room": 2.45
 },
 "03.mp3": {
  "key": "8eb5c6c076be",
  "start": 10.8,
  "text": "可是事先问别的乘客，他们大多猜：",
  "speed": 1.038,
  "dur": 2.18,
  "room": 2.65
 },
 "04.mp3": {
  "key": "bb64e3b04e20",
  "start": 13.6,
  "text": "跟陌生人聊天，会是最难受的。",
  "speed": 1.0,
  "dur": 2.37,
  "room": 2.55
 },
 "05.mp3": {
  "key": "93465319b510",
  "start": 16.3,
  "text": "我们为什么不开口？研究者问了问。",
  "speed": 1.0,
  "dur": 2.74,
  "room": 3.45
 },
 "06.mp3": {
  "key": "5ba8f3fe0189",
  "start": 19.9,
  "text": "很多人以为：别人不想跟我聊。",
  "speed": 1.0,
  "dur": 2.04,
  "room": 3.95
 },
 "07.mp3": {
  "key": "7f708c036a16",
  "start": 24.0,
  "text": "可真开了口，对方往往挺乐意。",
  "speed": 1.0,
  "dur": 2.5,
  "room": 3.55
 },
 "08.mp3": {
  "key": "2fd9f3c89f8e",
  "start": 27.7,
  "text": "我们把自己关起来，是因为猜错了别人。",
  "speed": 1.0,
  "dur": 3.07,
  "room": 3.75
 },
 "09.mp3": {
  "key": "b9d330a9e25e",
  "start": 31.6,
  "text": "这就是「孤立主义」：宁可一个人，也怕打扰别人。",
  "speed": 1.0,
  "dur": 4.27,
  "room": 5.85
 },
 "10.mp3": {
  "key": "7e3a477d7364",
  "start": 37.6,
  "text": "还有一个“喜欢差”：",
  "speed": 1.0,
  "dur": 1.39,
  "room": 3.15
 },
 "11.mp3": {
  "key": "6bb5002313c6",
  "start": 40.9,
  "text": "聊完天，我们常觉得：对方没那么喜欢我。",
  "speed": 1.0,
  "dur": 3.02,
  "room": 3.85
 },
 "12.mp3": {
  "key": "f8520dab3697",
  "start": 44.9,
  "text": "可对方对你的喜欢，往往比你以为的多。",
  "speed": 1.0,
  "dur": 3.0,
  "room": 3.85
 },
 "13.mp3": {
  "key": "a8baab512015",
  "start": 48.9,
  "text": "我们低估了别人的善意，也低估了自己。",
  "speed": 1.0,
  "dur": 2.84,
  "room": 4.55
 },
 "14.mp3": {
  "key": "b5fedb637668",
  "start": 53.6,
  "text": "猜错的代价是：",
  "speed": 1.0,
  "dur": 1.27,
  "room": 4.15
 },
 "15.mp3": {
  "key": "411e1714b978",
  "start": 57.9,
  "text": "越来越少开口，越来越孤单；",
  "speed": 1.0,
  "dur": 2.48,
  "room": 2.75
 },
 "16.mp3": {
  "key": "bf9abccf8764",
  "start": 60.8,
  "text": "而长期孤立，对健康也有实实在在的伤害。",
  "speed": 1.125,
  "dur": 3.04,
  "room": 3.35
 },
 "17.mp3": {
  "key": "ae9fe38c60ae",
  "start": 64.3,
  "text": "所以，下次排队、坐车、等咖啡的时候，",
  "speed": 1.059,
  "dur": 3.24,
  "room": 3.45
 },
 "18.mp3": {
  "key": "5ecb3ab85844",
  "start": 67.9,
  "text": "可以试着说一句：今天挺冷的哈。",
  "speed": 1.0,
  "dur": 2.65,
  "room": 4.15
 },
 "19.mp3": {
  "key": "ea63ef91a320",
  "start": 72.2,
  "text": "大多数人，会比你想的更愿意接话。",
  "speed": 1.0,
  "dur": 2.66,
  "room": 3.95
 },
 "20.mp3": {
  "key": "77d55f8f4706",
  "start": 76.3,
  "text": "四百年前，英国诗人邓恩写过：",
  "speed": 1.0,
  "dur": 2.48,
  "room": 3.75
 },
 "21.mp3": {
  "key": "95e617f3caf9",
  "start": 80.2,
  "text": "「没有人是一座孤岛。」—— 约翰·邓恩",
  "speed": 1.0,
  "dur": 2.35,
  "room": 4.55
 },
 "22.mp3": {
  "key": "9e46b161265a",
  "start": 84.9,
  "text": "我们以为别人想要安静，",
  "speed": 1.0,
  "dur": 1.85,
  "room": 3.85
 },
 "23.mp3": {
  "key": "56c64ae45f46",
  "start": 88.9,
  "text": "其实很多人，也在等一个人先开口。",
  "speed": 1.0,
  "dur": 2.72,
  "room": 4.35
 },
 "24.mp3": {
  "key": "58968f132b9a",
  "start": 93.4,
  "text": "先开口，孤岛就连成大陆。",
  "speed": 1.0,
  "dur": 2.61,
  "room": 4.85
 },
 "25.mp3": {
  "key": "6ab6380367d3",
  "start": 98.4,
  "text": "评论区：你最近一次跟陌生人聊天，是什么时候？",
  "speed": 1.0,
  "dur": 4.02,
  "room": 5.45
 }
}