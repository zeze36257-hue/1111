{
 "00.mp3": {
  "key": "ffd23ed4f413",
  "start": 0.15,
  "text": "在加拿大，有人中了彩票，奖金有大有小。",
  "speed": 1.0,
  "dur": 3.7,
  "room": 3.8
 },
 "01.mp3": {
  "key": "1fd5bc72db44",
  "start": 4.1,
  "text": "奖金越大，他的邻居后来会怎样？先猜一个。",
  "speed": 1.0,
  "dur": 3.69,
  "room": 3.95
 },
 "02.mp3": {
  "key": "92d3190bc726",
  "start": 8.2,
  "text": "答案是 C：邻居更容易破产。",
  "speed": 1.195,
  "dur": 2.26,
  "room": 2.45
 },
 "03.mp3": {
  "key": "3756081df4ca",
  "start": 10.8,
  "text": "奖金越大，附近人家后来申请破产的越多；",
  "speed": 1.275,
  "dur": 2.15,
  "room": 2.65
 },
 "04.mp3": {
  "key": "5bfeb1b7e887",
  "start": 13.25,
  "text": "他们手里，多的是车、房这些看得见的东西。",
  "speed": 1.279,
  "dur": 3.09,
  "room": 2.55
 },
 "05.mp3": {
  "key": "a133a09f6d67",
  "start": 16.49,
  "text": "不是中奖的人做了什么，",
  "speed": 1.0,
  "dur": 1.45,
  "room": 3.45
 },
 "06.mp3": {
  "key": "d9f6454c95b7",
  "start": 19.9,
  "text": "而是：看着身边的人突然变好，自己坐不住了。",
  "speed": 1.0,
  "dur": 3.66,
  "room": 3.95
 },
 "07.mp3": {
  "key": "00a2af774631",
  "start": 24.0,
  "text": "借钱买车、换房子，想跟上隔壁的节奏。",
  "speed": 1.069,
  "dur": 3.37,
  "room": 3.55
 },
 "08.mp3": {
  "key": "5314d10610ef",
  "start": 27.7,
  "text": "比的往往不是需要，是“别人有”。",
  "speed": 1.0,
  "dur": 2.74,
  "room": 3.75
 },
 "09.mp3": {
  "key": "176b70cc15b9",
  "start": 31.6,
  "text": "这就是「攀比主义」：过得好不好，要看跟谁比。",
  "speed": 1.0,
  "dur": 4.27,
  "room": 5.85
 },
 "10.mp3": {
  "key": "33970b170523",
  "start": 37.6,
  "text": "有个经典问题：",
  "speed": 1.0,
  "dur": 1.2,
  "room": 3.15
 },
 "11.mp3": {
  "key": "3e9d4f7b1770",
  "start": 40.9,
  "text": "你年薪 5 万，别人 2.5 万；",
  "speed": 1.0,
  "dur": 3.17,
  "room": 3.85
 },
 "12.mp3": {
  "key": "2019b0ba723c",
  "start": 44.57,
  "text": "或者你年薪 10 万，别人 20 万。你选哪个？",
  "speed": 1.0,
  "dur": 4.18,
  "room": 3.85
 },
 "13.mp3": {
  "key": "92c5fd88d037",
  "start": 48.9,
  "text": "约一半的人选了前者：钱少一半，也要比别人多。",
  "speed": 1.0,
  "dur": 3.57,
  "room": 4.55
 },
 "14.mp3": {
  "key": "52bfee54eb7e",
  "start": 53.6,
  "text": "可比较，是没有尽头的：",
  "speed": 1.0,
  "dur": 2.45,
  "room": 4.15
 },
 "15.mp3": {
  "key": "493b0785e25c",
  "start": 57.9,
  "text": "你追上了隔壁，还有楼上；",
  "speed": 1.0,
  "dur": 2.28,
  "room": 2.75
 },
 "16.mp3": {
  "key": "92e777ff5b7a",
  "start": 60.8,
  "text": "追上了楼上，还有手机里的所有人。",
  "speed": 1.0,
  "dur": 2.42,
  "room": 3.35
 },
 "17.mp3": {
  "key": "a71581728b53",
  "start": 64.3,
  "text": "所以，想买点什么的时候，先问一句：",
  "speed": 1.0,
  "dur": 3.06,
  "room": 3.45
 },
 "18.mp3": {
  "key": "3f59b4c40782",
  "start": 67.9,
  "text": "如果没人看得见，我还想要它吗？",
  "speed": 1.0,
  "dur": 2.59,
  "room": 4.15
 },
 "19.mp3": {
  "key": "ded4b235d29e",
  "start": 72.15,
  "text": "真想要的，留下；只想被看见的，可以放一放。",
  "speed": 1.055,
  "dur": 4.0,
  "room": 3.95
 },
 "20.mp3": {
  "key": "f7ff0d409c41",
  "start": 76.3,
  "text": "两千多年前，老子说：",
  "speed": 1.0,
  "dur": 2.12,
  "room": 3.75
 },
 "21.mp3": {
  "key": "400c382b439e",
  "start": 79.46,
  "text": "「胜人者有力，自胜者强。知足者富。」——《道德经》",
  "speed": 1.0,
  "dur": 5.29,
  "room": 4.55
 },
 "22.mp3": {
  "key": "b3ae83de2af3",
  "start": 84.9,
  "text": "赢过别人，靠的是力气；",
  "speed": 1.0,
  "dur": 2.0,
  "room": 3.85
 },
 "23.mp3": {
  "key": "3a8df538e271",
  "start": 88.9,
  "text": "赢过那个总想比的自己，才叫强。",
  "speed": 1.0,
  "dur": 3.02,
  "room": 4.35
 },
 "24.mp3": {
  "key": "681c837e739a",
  "start": 93.4,
  "text": "少比一点，多过一点。",
  "speed": 1.0,
  "dur": 2.07,
  "room": 4.85
 },
 "25.mp3": {
  "key": "3b6e69e365ae",
  "start": 98.4,
  "text": "评论区：你有没有为了“别人有”，买过用不上的东西？",
  "speed": 1.0,
  "dur": 4.23,
  "room": 5.45
 }
}