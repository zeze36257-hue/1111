{
 "00.mp3": {
  "key": "8535a925fe6d",
  "start": 0.15,
  "text": "同一个老师、同一口口音，录了两段视频：",
  "speed": 1.0,
  "dur": 3.14,
  "room": 3.8
 },
 "01.mp3": {
  "key": "57c1f4bd1e4b",
  "start": 4.1,
  "text": "一段和蔼，一段冷淡。谁更喜欢他的口音？先猜一个。",
  "speed": 1.233,
  "dur": 3.91,
  "room": 3.95
 },
 "02.mp3": {
  "key": "dedb2bd86b26",
  "start": 8.2,
  "text": "答案是 C：看和蔼那段的。",
  "speed": 1.106,
  "dur": 2.73,
  "room": 2.45
 },
 "03.mp3": {
  "key": "8e04076db7b8",
  "start": 11.08,
  "text": "连他的长相、小动作，都跟着变顺眼了；",
  "speed": 1.3,
  "dur": 2.44,
  "room": 2.65
 },
 "04.mp3": {
  "key": "6d2305455b87",
  "start": 13.67,
  "text": "而学生们，坚决否认自己受了影响。",
  "speed": 1.188,
  "dur": 2.34,
  "room": 2.55
 },
 "05.mp3": {
  "key": "c930cbee8a93",
  "start": 16.3,
  "text": "心理学叫它「光环效应」：",
  "speed": 1.0,
  "dur": 2.52,
  "room": 3.45
 },
 "06.mp3": {
  "key": "89a63d3488c0",
  "start": 19.9,
  "text": "一个整体印象，会给所有细节都镀上一层颜色。",
  "speed": 1.0,
  "dur": 3.92,
  "room": 3.95
 },
 "07.mp3": {
  "key": "61126e929001",
  "start": 24.0,
  "text": "更早的一个实验，只在介绍里改了一个词：",
  "speed": 1.0,
  "dur": 3.08,
  "room": 3.55
 },
 "08.mp3": {
  "key": "b7dff77bbba3",
  "start": 27.7,
  "text": "“热情”换成“冷淡”，同一堂课的评价就变了。",
  "speed": 1.0,
  "dur": 3.71,
  "room": 3.75
 },
 "09.mp3": {
  "key": "a3c39cd2db08",
  "start": 31.6,
  "text": "这就是「印象主义」：先有印象，再看细节。",
  "speed": 1.0,
  "dur": 2.92,
  "room": 5.85
 },
 "10.mp3": {
  "key": "36809fc8bbd6",
  "start": 37.6,
  "text": "心理学家阿施做过一个更简单的测试：",
  "speed": 1.0,
  "dur": 2.36,
  "room": 3.15
 },
 "11.mp3": {
  "key": "b672329f5da2",
  "start": 40.26,
  "text": "聪明、勤奋、冲动、爱挑剔、固执、嫉妒；",
  "speed": 1.197,
  "dur": 4.65,
  "room": 3.85
 },
 "12.mp3": {
  "key": "9ce004973eb7",
  "start": 45.06,
  "text": "同样六个词，倒过来念，印象就差了一截。",
  "speed": 1.0,
  "dur": 3.63,
  "room": 3.85
 },
 "13.mp3": {
  "key": "12c3481d2f8d",
  "start": 48.9,
  "text": "先听到的，决定了后面怎么听。",
  "speed": 1.0,
  "dur": 2.46,
  "room": 4.55
 },
 "14.mp3": {
  "key": "778a345d5e44",
  "start": 53.6,
  "text": "所以，第一印象一旦定了：",
  "speed": 1.0,
  "dur": 2.18,
  "room": 4.15
 },
 "15.mp3": {
  "key": "d73d463a532d",
  "start": 57.9,
  "text": "印象好的人，缺点也像优点；",
  "speed": 1.0,
  "dur": 2.68,
  "room": 2.75
 },
 "16.mp3": {
  "key": "6b2e09763441",
  "start": 60.8,
  "text": "印象差的人，优点也像缺点。",
  "speed": 1.0,
  "dur": 2.37,
  "room": 3.35
 },
 "17.mp3": {
  "key": "ef7c487e008c",
  "start": 64.3,
  "text": "下次对一个人下结论之前，",
  "speed": 1.0,
  "dur": 1.84,
  "room": 3.45
 },
 "18.mp3": {
  "key": "41a4b8f0fc3c",
  "start": 67.9,
  "text": "可以把“印象”先放一放，单独看这一件事：",
  "speed": 1.0,
  "dur": 3.39,
  "room": 4.15
 },
 "19.mp3": {
  "key": "ca746c85bdaa",
  "start": 72.2,
  "text": "同样的事，换个人做，我还会这么想吗？",
  "speed": 1.0,
  "dur": 3.08,
  "room": 3.95
 },
 "20.mp3": {
  "key": "1e8a3856e8fc",
  "start": 76.3,
  "text": "两千多年前，孔子自己也看走过眼：",
  "speed": 1.0,
  "dur": 2.78,
  "room": 3.75
 },
 "21.mp3": {
  "key": "feddbc254c67",
  "start": 80.2,
  "text": "「以貌取人，失之子羽。」—— 孔子",
  "speed": 1.0,
  "dur": 3.36,
  "room": 4.55
 },
 "22.mp3": {
  "key": "108546ff57bb",
  "start": 84.9,
  "text": "连孔子，也被第一印象骗过；",
  "speed": 1.0,
  "dur": 2.16,
  "room": 3.85
 },
 "23.mp3": {
  "key": "bcd19ed0e793",
  "start": 88.9,
  "text": "他做的是：多看一眼，再改过来。",
  "speed": 1.0,
  "dur": 2.93,
  "room": 4.35
 },
 "24.mp3": {
  "key": "669e5ecbec90",
  "start": 93.4,
  "text": "印象是开始，不是结论。",
  "speed": 1.0,
  "dur": 2.23,
  "room": 4.85
 },
 "25.mp3": {
  "key": "b212355b2453",
  "start": 98.4,
  "text": "评论区：有没有谁，你对他的第一印象完全错了？",
  "speed": 1.0,
  "dur": 3.7,
  "room": 5.45
 }
}