{
 "00.mp3": {
  "key": "5990829f5390",
  "tkey": "ac4c0b1f1df0",
  "file": "00.mp3",
  "start": 0.3,
  "text": "好吵……喇叭声、脚步声、有人在打电话，全挤进我脑子里了。",
  "who": "黑",
  "kind": "think",
  "speed": 0.95,
  "dur": 7.68,
  "room": 8.03
 },
 "01.mp3": {
  "key": "7a0b23427c72",
  "tkey": "75f8fa4fc16a",
  "file": "01.mp3",
  "start": 8.48,
  "text": "快点快点，绿灯了！",
  "who": "橘",
  "kind": "say",
  "speed": 1.0,
  "dur": 1.57,
  "room": 1.77
 },
 "02.mp3": {
  "key": "60173fcc7d29",
  "tkey": "b99ff5545e9f",
  "file": "02.mp3",
  "start": 10.4,
  "text": "你不觉得……这里太吵了吗？",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 2.08,
  "room": 2.23
 },
 "03.mp3": {
  "key": "64ee39dedcb4",
  "tkey": "013a4636bcb7",
  "file": "03.mp3",
  "start": 12.78,
  "text": "有吗？还好吧。",
  "who": "橘",
  "kind": "say",
  "speed": 1.0,
  "dur": 1.34,
  "room": 3.47
 },
 "04.mp3": {
  "key": "c2a3fbad671b",
  "tkey": "9725d1cf5031",
  "file": "04.mp3",
  "start": 16.4,
  "text": "嗯……先这样吧。",
  "who": "板",
  "kind": "say",
  "speed": 0.9,
  "dur": 1.4,
  "room": 1.85
 },
 "05.mp3": {
  "key": "02926028051f",
  "tkey": "47c660cc289a",
  "file": "05.mp3",
  "start": 18.4,
  "text": "他刚才是不是叹气了？是不是我做得不好？",
  "who": "黑",
  "kind": "think",
  "speed": 0.95,
  "dur": 3.46,
  "room": 3.81
 },
 "06.mp3": {
  "key": "7914b043d156",
  "tkey": "1cefa6368c32",
  "file": "06.mp3",
  "start": 22.36,
  "text": "你怎么了？脸色这么差。",
  "who": "橘",
  "kind": "say",
  "speed": 1.0,
  "dur": 1.86,
  "room": 2.01
 },
 "07.mp3": {
  "key": "cc409db5e418",
  "tkey": "a46d4989443a",
  "file": "07.mp3",
  "start": 24.52,
  "text": "老板刚才那句话，语气好像不太对。",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 2.92,
  "room": 3.17
 },
 "08.mp3": {
  "key": "e8f4ce5a5de6",
  "tkey": "efb94eed73f2",
  "file": "08.mp3",
  "start": 27.84,
  "text": "你想太多了吧。你就是太敏感了。",
  "who": "橘",
  "kind": "say",
  "speed": 1.0,
  "dur": 2.4,
  "room": 4.41
 },
 "09.mp3": {
  "key": "875815b9c383",
  "tkey": "bb8c67e42091",
  "file": "09.mp3",
  "start": 32.4,
  "text": "一整天的每一句话，都在脑子里重播。",
  "who": "黑",
  "kind": "think",
  "speed": 0.95,
  "dur": 2.87,
  "room": 3.42
 },
 "10.mp3": {
  "key": "99e87df899bd",
  "tkey": "a804b18c1e14",
  "file": "10.mp3",
  "start": 35.97,
  "text": "我是不是……太脆弱了？",
  "who": "黑",
  "kind": "think",
  "speed": 0.95,
  "dur": 2.15,
  "room": 5.88
 },
 "11.mp3": {
  "key": "aaaf11b4413a",
  "tkey": "1234c9dc1072",
  "file": "11.mp3",
  "start": 42.0,
  "text": "又在想白天的事？",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 1.12,
  "room": 1.32
 },
 "12.mp3": {
  "key": "e52e9b9291bc",
  "tkey": "58c51f37c73e",
  "file": "12.mp3",
  "start": 43.47,
  "text": "嗯。大家都说我太敏感了。",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 2.67,
  "room": 2.97
 },
 "13.mp3": {
  "key": "d7f7abee53b2",
  "tkey": "74fdd8a39fcc",
  "file": "13.mp3",
  "start": 46.59,
  "text": "敏感不是毛病。心理学家专门研究过像你这样的人，叫「高敏感人群」。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 6.33,
  "room": 6.53
 },
 "14.mp3": {
  "key": "f763b4b5a742",
  "tkey": "ffd01753585b",
  "file": "14.mp3",
  "start": 53.27,
  "text": "高敏感？",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 0.64,
  "room": 0.79
 },
 "15.mp3": {
  "key": "9f2506bb5d11",
  "tkey": "ee7f603c7769",
  "file": "15.mp3",
  "start": 54.21,
  "text": "有研究估计，差不多每五个人里，就有一个是这样的。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 4.19,
  "room": 4.49
 },
 "16.mp3": {
  "key": "84c6dcbf1225",
  "tkey": "1ffcbc727efd",
  "file": "16.mp3",
  "start": 58.85,
  "text": "你们的大脑，处理信息更深、更细。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 3.08,
  "room": 3.23
 },
 "17.mp3": {
  "key": "2f7d59a8bd44",
  "tkey": "f40579d7b4dc",
  "file": "17.mp3",
  "start": 62.23,
  "text": "别人没注意的声音、光线、一个小眼神，你都接收到了，还会反复琢磨。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 5.54,
  "room": 5.79
 },
 "18.mp3": {
  "key": "cbcac77c6a28",
  "tkey": "cf49f7d60642",
  "file": "18.mp3",
  "start": 68.17,
  "text": "所以我在人多的地方，特别容易累？",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 3.1,
  "room": 3.25
 },
 "19.mp3": {
  "key": "a09ab84e9c47",
  "tkey": "24ab37db3c9e",
  "file": "19.mp3",
  "start": 71.57,
  "text": "对。信息一多，就像一下子塞满了，很容易过载。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 4.58,
  "room": 4.88
 },
 "20.mp3": {
  "key": "7d4c22258e92",
  "tkey": "9b77f54b80e2",
  "file": "20.mp3",
  "start": 76.6,
  "text": "有个脑成像研究发现：高敏感的人看到别人开心或难过的表情，跟共情有关的脑区更活跃。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 8.15,
  "room": 8.4
 },
 "21.mp3": {
  "key": "75156e8d236e",
  "tkey": "eefb3d3dfb1f",
  "file": "21.mp3",
  "start": 85.15,
  "text": "难怪别人一皱眉，我就跟着难受。",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 2.69,
  "room": 4.7
 },
 "22.mp3": {
  "key": "38c1783fc4f2",
  "tkey": "6aad0743abbc",
  "file": "22.mp3",
  "start": 90.0,
  "text": "那这是怎么来的？我能改掉吗？",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 2.34,
  "room": 2.54
 },
 "23.mp3": {
  "key": "745f341cc74c",
  "tkey": "9a2f6b33d84a",
  "file": "23.mp3",
  "start": 92.69,
  "text": "一项双胞胎研究发现，敏感程度的差别，差不多一半和基因有关。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 5.58,
  "room": 5.78
 },
 "24.mp3": {
  "key": "445ca27530f9",
  "tkey": "13a1871bbf2a",
  "file": "24.mp3",
  "start": 98.62,
  "text": "它更像一种天生的特质。不是病，也不是矫情。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 4.03,
  "room": 4.33
 },
 "25.mp3": {
  "key": "2ef5425a90c5",
  "tkey": "02918380c638",
  "file": "25.mp3",
  "start": 103.1,
  "text": "而且研究发现，高敏感的人在糟糕的环境里更容易受伤，可在好的环境里，收获也比别人多。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 7.55,
  "room": 9.15
 },
 "26.mp3": {
  "key": "5c25f932aa43",
  "tkey": "63227964d99f",
  "file": "26.mp3",
  "start": 112.4,
  "text": "那我该怎么办？",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 0.97,
  "room": 1.17
 },
 "27.mp3": {
  "key": "65c73943dfd0",
  "tkey": "126fb92ce970",
  "file": "27.mp3",
  "start": 113.72,
  "text": "累了，就找个安静的地方待一会儿。这不是逃避，是在充电。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 4.62,
  "room": 4.87
 },
 "28.mp3": {
  "key": "76cd2399ca5b",
  "tkey": "9194eeb1a83f",
  "file": "28.mp3",
  "start": 118.74,
  "text": "人多的安排之间，提前给自己留点恢复的时间。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 3.76,
  "room": 4.01
 },
 "29.mp3": {
  "key": "036751ab6ab7",
  "tkey": "f843f676e0f5",
  "file": "29.mp3",
  "start": 122.9,
  "text": "有人说你太敏感，你可以告诉他：我只是感受得比较多。",
  "who": "姐",
  "kind": "say",
  "speed": 0.97,
  "dur": 4.08,
  "room": 8.55
 },
 "30.mp3": {
  "key": "48f09c50e22a",
  "tkey": "bb6f480d4050",
  "file": "30.mp3",
  "start": 131.6,
  "text": "一大早，一个人跑公园来干嘛？",
  "who": "橘",
  "kind": "say",
  "speed": 1.0,
  "dur": 2.33,
  "room": 2.53
 },
 "31.mp3": {
  "key": "857a5f7679f8",
  "tkey": "7f13ebd19926",
  "file": "31.mp3",
  "start": 134.28,
  "text": "充个电。",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 0.47,
  "room": 0.92
 },
 "32.mp3": {
  "key": "d0e52ba66588",
  "tkey": "718a5f785ca2",
  "file": "32.mp3",
  "start": 135.35,
  "text": "我想明白了。我不是太脆弱，我只是……感受得比较多。",
  "who": "黑",
  "kind": "say",
  "speed": 0.95,
  "dur": 4.84,
  "room": 14.9
 }
}