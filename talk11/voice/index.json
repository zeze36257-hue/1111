{
 "00.mp3": {
  "key": "c800ce641f81",
  "tkey": "a0bf418d72ea",
  "file": "00.mp3",
  "start": 1.2,
  "text": "上班以后，我最崩溃的一刻，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.66,
  "room": 2.81
 },
 "01.mp3": {
  "key": "212d52ad8c2a",
  "tkey": "1af2b5e09596",
  "file": "01.mp3",
  "start": 4.16,
  "text": "不是加班，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.8,
  "room": 0.9
 },
 "02.mp3": {
  "key": "d666a0c69afa",
  "tkey": "35df46eae4fa",
  "file": "02.mp3",
  "start": 5.21,
  "text": "也不是挨骂。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.13,
  "room": 1.58
 },
 "03.mp3": {
  "key": "37c9eb928a42",
  "tkey": "299aa61526f9",
  "file": "03.mp3",
  "start": 6.94,
  "text": "而是有一天，我突然发现，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 3.06,
  "room": 3.21
 },
 "04.mp3": {
  "key": "ac9e3d69fa37",
  "tkey": "bb5e2f58f0fa",
  "file": "04.mp3",
  "start": 10.3,
  "text": "我好像正在变成一个——",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.72,
  "room": 2.07
 },
 "05.mp3": {
  "key": "0c5aee29fee3",
  "tkey": "1bb2311d2b4b",
  "file": "05.mp3",
  "start": 12.52,
  "text": "麻木，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.68,
  "room": 0.83
 },
 "06.mp3": {
  "key": "2c19d478847d",
  "tkey": "841f252592dd",
  "file": "06.mp3",
  "start": 13.5,
  "text": "听话，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.5,
  "room": 0.65
 },
 "07.mp3": {
  "key": "0c2f43555476",
  "tkey": "cb33cf62a590",
  "file": "07.mp3",
  "start": 14.3,
  "text": "只会说“好的”的人。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.3,
  "room": 3.55
 },
 "08.mp3": {
  "key": "40c64472c922",
  "tkey": "4adb9d34d858",
  "file": "08.mp3",
  "start": 18.0,
  "text": "每天就是开会，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.12,
  "room": 1.17
 },
 "09.mp3": {
  "key": "2172a10dcd59",
  "tkey": "3b1af71fd836",
  "file": "09.mp3",
  "start": 19.32,
  "text": "打卡，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.55,
  "room": 0.6
 },
 "10.mp3": {
  "key": "608e642b85b7",
  "tkey": "323d77497ceb",
  "file": "10.mp3",
  "start": 20.07,
  "text": "写周报，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.04,
  "room": 1.09
 },
 "11.mp3": {
  "key": "f9e8aa84d177",
  "tkey": "8ea75fecc56f",
  "file": "11.mp3",
  "start": 21.31,
  "text": "回一百个“好的”。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.04,
  "room": 1.49
 },
 "12.mp3": {
  "key": "ffedbe2e6921",
  "tkey": "c8de33405bfd",
  "file": "12.mp3",
  "start": 22.95,
  "text": "下班，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.81,
  "room": 0.81
 },
 "13.mp3": {
  "key": "6b5c7912079d",
  "tkey": "b916e9f92576",
  "file": "13.mp3",
  "start": 23.91,
  "text": "躺下，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.919,
  "dur": 0.75,
  "room": 0.8
 },
 "14.mp3": {
  "key": "aa28838e3730",
  "tkey": "212e1cac1625",
  "file": "14.mp3",
  "start": 24.86,
  "text": "刷手机，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.2,
  "room": 1.2
 },
 "15.mp3": {
  "key": "ce004e0b7737",
  "tkey": "00d301bc3626",
  "file": "15.mp3",
  "start": 26.21,
  "text": "睡觉。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.61,
  "room": 1.26
 },
 "16.mp3": {
  "key": "1448797fa893",
  "tkey": "a906b9977437",
  "file": "16.mp3",
  "start": 27.62,
  "text": "第二天，再来一遍。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.87,
  "room": 4.03
 },
 "17.mp3": {
  "key": "867b3ffddf4c",
  "tkey": "9262203f2038",
  "file": "17.mp3",
  "start": 31.8,
  "text": "上学的时候，目标很简单：",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.89,
  "room": 1.94
 },
 "18.mp3": {
  "key": "31a40c5e05cf",
  "tkey": "59c0ef439d09",
  "file": "18.mp3",
  "start": 33.89,
  "text": "考个好大学。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.13,
  "room": 3.36
 },
 "19.mp3": {
  "key": "800bcb7a03fa",
  "tkey": "5682dda9001d",
  "file": "19.mp3",
  "start": 37.4,
  "text": "可上班以后，再也没有人告诉我，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 3.15,
  "room": 3.2
 },
 "20.mp3": {
  "key": "a262cb35595b",
  "tkey": "c5ae3e28ae7a",
  "file": "20.mp3",
  "start": 40.75,
  "text": "下一步，该往哪走。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.05,
  "room": 4.6
 },
 "21.mp3": {
  "key": "e034f869702a",
  "tkey": "5083b2901e55",
  "file": "21.mp3",
  "start": 45.5,
  "text": "最可怕的是，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.37,
  "room": 1.62
 },
 "22.mp3": {
  "key": "39fd68440ae6",
  "tkey": "d4a148d593db",
  "file": "22.mp3",
  "start": 47.27,
  "text": "身边的人，好像都过得挺好。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.65,
  "room": 3.0
 },
 "23.mp3": {
  "key": "0863697f1208",
  "tkey": "b8b3c950bfd3",
  "file": "23.mp3",
  "start": 50.42,
  "text": "老哥照样开黑，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.34,
  "room": 1.49
 },
 "24.mp3": {
  "key": "d86065d1afc0",
  "tkey": "7b5f24fc9f83",
  "file": "24.mp3",
  "start": 52.06,
  "text": "运营照样晒奶茶，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.62,
  "room": 1.77
 },
 "25.mp3": {
  "key": "31833a2497c5",
  "tkey": "3f5cda39f8d3",
  "file": "25.mp3",
  "start": 53.98,
  "text": "朋友圈里，有人在旅游，有人升职了。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 3.66,
  "room": 6.07
 },
 "26.mp3": {
  "key": "d6837de165d4",
  "tkey": "a61d062581a2",
  "file": "26.mp3",
  "start": 60.2,
  "text": "好像只有我一个人，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.81,
  "room": 1.96
 },
 "27.mp3": {
  "key": "b6a2f2631ca1",
  "tkey": "985107b87931",
  "file": "27.mp3",
  "start": 62.31,
  "text": "凌晨两点，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.18,
  "room": 1.33
 },
 "28.mp3": {
  "key": "7c3c38568651",
  "tkey": "069c5a5a598c",
  "file": "28.mp3",
  "start": 63.79,
  "text": "还睁着眼睛，盯着天花板。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.35,
  "room": 4.2
 },
 "29.mp3": {
  "key": "32a396585303",
  "tkey": "19df6ae662c6",
  "file": "29.mp3",
  "start": 68.14,
  "text": "但人不能一直烂在那里。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.45,
  "room": 3.0
 },
 "30.mp3": {
  "key": "48b33e2b2a4f",
  "tkey": "9bc38530d4f8",
  "file": "30.mp3",
  "start": 71.29,
  "text": "你总得抓住一点什么，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.66,
  "room": 1.81
 },
 "31.mp3": {
  "key": "f669d640411e",
  "tkey": "a354edb7cbab",
  "file": "31.mp3",
  "start": 73.25,
  "text": "证明自己，还能变。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.4,
  "room": 3.35
 },
 "32.mp3": {
  "key": "5d1a3a441fbb",
  "tkey": "1c4ac23f5019",
  "file": "32.mp3",
  "start": 76.75,
  "text": "对我来说，那个东西是——",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.07,
  "room": 3.5
 },
 "33.mp3": {
  "key": "64027cd477a5",
  "tkey": "4fca1d449118",
  "file": "33.mp3",
  "start": 80.4,
  "text": "跑步。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.68,
  "room": 2.53
 },
 "34.mp3": {
  "key": "95c27f57afc4",
  "tkey": "b61e7e881b87",
  "file": "34.mp3",
  "start": 83.08,
  "text": "第一天，八百米，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.99,
  "room": 2.14
 },
 "35.mp3": {
  "key": "f793ada43431",
  "tkey": "1662c6dbcb14",
  "file": "35.mp3",
  "start": 85.37,
  "text": "喘得像条狗。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.34,
  "room": 2.29
 },
 "36.mp3": {
  "key": "b956c34dad1a",
  "tkey": "9c5941f9a745",
  "file": "36.mp3",
  "start": 87.81,
  "text": "第七天，两公里。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.8,
  "room": 2.55
 },
 "37.mp3": {
  "key": "c4b4a6f1a1f5",
  "tkey": "8fa58379924a",
  "file": "37.mp3",
  "start": 90.51,
  "text": "第三十天，五公里。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.53,
  "room": 3.68
 },
 "38.mp3": {
  "key": "e88e7b147d5e",
  "tkey": "451c4d3da7b4",
  "file": "38.mp3",
  "start": 94.34,
  "text": "原来，我不是没有力气，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.47,
  "room": 2.72
 },
 "39.mp3": {
  "key": "7f522110af8d",
  "tkey": "35c3a84932bc",
  "file": "39.mp3",
  "start": 97.21,
  "text": "我只是，太久没有为自己，用过力气了。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 3.81,
  "room": 7.34
 },
 "40.mp3": {
  "key": "0444c35411d4",
  "tkey": "9d0723755ff2",
  "file": "40.mp3",
  "start": 104.7,
  "text": "所以，如果你也觉得，现在的日子——",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 4.12,
  "room": 4.27
 },
 "41.mp3": {
  "key": "24d4c94faec9",
  "tkey": "0028ac29e609",
  "file": "41.mp3",
  "start": 109.12,
  "text": "很空，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.45,
  "room": 0.55
 },
 "42.mp3": {
  "key": "797850d90260",
  "tkey": "b8de0c04f68e",
  "file": "42.mp3",
  "start": 109.82,
  "text": "很乱，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 0.72,
  "room": 0.82
 },
 "43.mp3": {
  "key": "a17b6ec6491a",
  "tkey": "d8fbb4895a9f",
  "file": "43.mp3",
  "start": 110.79,
  "text": "很没意义，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.1,
  "room": 1.55
 },
 "44.mp3": {
  "key": "73703d1f3e91",
  "tkey": "47fd89ab363f",
  "file": "44.mp3",
  "start": 112.49,
  "text": "先别急着骂自己没用。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.97,
  "room": 2.42
 },
 "45.mp3": {
  "key": "385a39f74668",
  "tkey": "79154ce576cc",
  "file": "45.mp3",
  "start": 115.06,
  "text": "你可能只是需要一件小事，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.13,
  "room": 2.18
 },
 "46.mp3": {
  "key": "ab00c81edd95",
  "tkey": "eeb4bc3e676e",
  "file": "46.mp3",
  "start": 117.39,
  "text": "能亲手完成，",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.11,
  "room": 1.16
 },
 "47.mp3": {
  "key": "c3a73ad10f55",
  "tkey": "87a295fbb46f",
  "file": "47.mp3",
  "start": 118.7,
  "text": "能亲眼看到变化。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 1.67,
  "room": 2.22
 },
 "48.mp3": {
  "key": "5fe830cacbf2",
  "tkey": "06627ad433e8",
  "file": "48.mp3",
  "start": 121.07,
  "text": "哪怕每天，只跑一公里。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 2.63,
  "room": 3.58
 },
 "49.mp3": {
  "key": "ccb5cbfcbb43",
  "tkey": "039499f9fcc1",
  "file": "49.mp3",
  "start": 124.8,
  "text": "人是可以一点一点，把自己捡回来的。",
  "who": "黑",
  "kind": "vo",
  "speed": 0.85,
  "dur": 3.06,
  "room": 11.05
 }
}