{
 "00.mp3": {
  "key": "9a23337757f5",
  "tkey": "2c224ac1ae1e",
  "file": "00.mp3",
  "start": 0.15,
  "text": "你是不是这样：消息发出去，就一直盯着屏幕？",
  "speed": 1.0,
  "dur": 4.07,
  "room": 4.42
 },
 "01.mp3": {
  "key": "df8d34afb8be",
  "tkey": "ae21f02b5cf2",
  "file": "01.mp3",
  "start": 4.72,
  "text": "对方晚回一会儿，你就开始想：是不是我说错了什么？",
  "speed": 1.0,
  "dur": 3.76,
  "room": 4.06
 },
 "02.mp3": {
  "key": "67f12f7ae805",
  "tkey": "f1f73f25b49e",
  "file": "02.mp3",
  "start": 8.93,
  "text": "他回了一个「嗯」，你能琢磨一整晚。",
  "speed": 1.0,
  "dur": 3.44,
  "room": 3.89
 },
 "03.mp3": {
  "key": "988c51e81928",
  "tkey": "a1f91a462b11",
  "file": "03.mp3",
  "start": 12.97,
  "text": "或者，你正在爱着这样一个人。",
  "speed": 1.0,
  "dur": 2.46,
  "room": 2.81
 },
 "04.mp3": {
  "key": "e18e0d036dab",
  "tkey": "ad33efbcf469",
  "file": "04.mp3",
  "start": 15.93,
  "text": "今天，我们一起来聊聊「焦虑型依恋」。",
  "speed": 1.0,
  "dur": 2.57,
  "room": 6.62
 },
 "05.mp3": {
  "key": "f012b55f2a95",
  "tkey": "d5f9f37343bd",
  "file": "05.mp3",
  "start": 22.7,
  "text": "心理学家用两把尺子，量一个人怎么谈感情。",
  "speed": 1.0,
  "dur": 3.6,
  "room": 3.85
 },
 "06.mp3": {
  "key": "08e9c7ca8a1a",
  "tkey": "2db5b6c14904",
  "file": "06.mp3",
  "start": 26.7,
  "text": "焦虑型，是第一把尺子特别高：特别怕被抛弃。",
  "speed": 1.0,
  "dur": 4.41,
  "room": 4.71
 },
 "07.mp3": {
  "key": "976f36ce9e90",
  "tkey": "dfeb55cd680a",
  "file": "07.mp3",
  "start": 31.56,
  "text": "所以越在乎，越想靠近，越想确认。",
  "speed": 1.0,
  "dur": 3.44,
  "room": 3.79
 },
 "08.mp3": {
  "key": "ffcc7df06b71",
  "tkey": "5a841c1b0f33",
  "file": "08.mp3",
  "start": 35.5,
  "text": "在两项大型调查里，大约一到两成的人这样形容自己。",
  "speed": 1.0,
  "dur": 3.78,
  "room": 6.25
 },
 "09.mp3": {
  "key": "40f22029b841",
  "tkey": "0b1edca6ba57",
  "file": "09.mp3",
  "start": 41.9,
  "text": "心理学家把焦虑型的做法，叫「过度激活」：",
  "speed": 1.0,
  "dur": 3.2,
  "room": 3.35
 },
 "10.mp3": {
  "key": "82259009bdbf",
  "tkey": "fafae7cab4c1",
  "file": "10.mp3",
  "start": 45.4,
  "text": "回避型把心里的警报关小，焦虑型把它开到最大。",
  "speed": 1.0,
  "dur": 4.12,
  "room": 4.47
 },
 "11.mp3": {
  "key": "9bfccba1acb2",
  "tkey": "3246a09cfa85",
  "file": "11.mp3",
  "start": 50.02,
  "text": "就像一个太灵敏的烟雾报警器：烤个面包，它也响。",
  "speed": 1.0,
  "dur": 4.25,
  "room": 4.8
 },
 "12.mp3": {
  "key": "037b037023ed",
  "tkey": "2d9edb603435",
  "file": "12.mp3",
  "start": 54.97,
  "text": "有个实验，让人看一张脸，慢慢变出表情。",
  "speed": 1.0,
  "dur": 3.73,
  "room": 3.93
 },
 "13.mp3": {
  "key": "c6cb87ab0649",
  "tkey": "4999dc897536",
  "file": "13.mp3",
  "start": 59.05,
  "text": "越焦虑的人，越早觉得「表情变了」；",
  "speed": 1.0,
  "dur": 2.4,
  "room": 2.55
 },
 "14.mp3": {
  "key": "796344ab3b5f",
  "tkey": "d9c0ec334be7",
  "file": "14.mp3",
  "start": 61.75,
  "text": "可也更容易看错，因为判断得太快。",
  "speed": 1.0,
  "dur": 2.96,
  "room": 3.41
 },
 "15.mp3": {
  "key": "c1b44f45d83e",
  "tkey": "5b1a9071bc40",
  "file": "15.mp3",
  "start": 65.31,
  "text": "另一项研究发现：越焦虑的人，越常去翻伴侣的社交软件。",
  "speed": 1.0,
  "dur": 4.97,
  "room": 5.17
 },
 "16.mp3": {
  "key": "6ca9bb47a0ed",
  "tkey": "883247bca6ab",
  "file": "16.mp3",
  "start": 70.63,
  "text": "警报一响，就忍不住要去确认。",
  "speed": 1.0,
  "dur": 2.42,
  "room": 6.32
 },
 "17.mp3": {
  "key": "90cc487554d3",
  "tkey": "bbe050bfb5f4",
  "file": "17.mp3",
  "start": 77.1,
  "text": "这个警报，是怎么调得这么灵敏的？",
  "speed": 1.0,
  "dur": 2.65,
  "room": 2.95
 },
 "18.mp3": {
  "key": "0e6b2f1f64f5",
  "tkey": "9c8386afe73d",
  "file": "18.mp3",
  "start": 80.2,
  "text": "心理学家观察过一种宝宝：妈妈一走就大哭，回来了，又很难哄好。",
  "speed": 1.0,
  "dur": 5.14,
  "room": 5.39
 },
 "19.mp3": {
  "key": "d831577ec6b7",
  "tkey": "fe403c8093bb",
  "file": "19.mp3",
  "start": 85.74,
  "text": "研究者认为，这可能和照顾者的回应时有时无有关：",
  "speed": 1.0,
  "dur": 3.51,
  "room": 3.66
 },
 "20.mp3": {
  "key": "5087f072cc3b",
  "tkey": "f446fa9741b7",
  "file": "20.mp3",
  "start": 89.55,
  "text": "有时候哭一声就有人来，有时候怎么哭都没人理。",
  "speed": 1.0,
  "dur": 4.23,
  "room": 4.58
 },
 "21.mp3": {
  "key": "2805f864d04a",
  "tkey": "7216481ca94d",
  "file": "21.mp3",
  "start": 94.28,
  "text": "孩子可能就学会了：声音要够大，才会被看见。",
  "speed": 1.0,
  "dur": 4.0,
  "room": 8.27
 },
 "22.mp3": {
  "key": "77eeab8c7b96",
  "tkey": "a7b2d2a52131",
  "file": "22.mp3",
  "start": 102.7,
  "text": "如果你是焦虑型：",
  "speed": 1.0,
  "dur": 1.2,
  "room": 1.35
 },
 "23.mp3": {
  "key": "e75d6f8d01af",
  "tkey": "558d67c818ec",
  "file": "23.mp3",
  "start": 104.2,
  "text": "警报响的时候，先别急着试探。",
  "speed": 1.0,
  "dur": 2.59,
  "room": 2.84
 },
 "24.mp3": {
  "key": "0a5bbc6450be",
  "tkey": "04a2824adc6b",
  "file": "24.mp3",
  "start": 107.19,
  "text": "别问「你是不是不爱我了」，直接说：「我有点不安，能抱我一下吗？」",
  "speed": 1.0,
  "dur": 4.95,
  "room": 5.5
 },
 "25.mp3": {
  "key": "c7f1950e1796",
  "tkey": "17ced54a4f08",
  "file": "25.mp3",
  "start": 112.84,
  "text": "如果你爱着一个焦虑型：",
  "speed": 1.0,
  "dur": 1.27,
  "room": 1.42
 },
 "26.mp3": {
  "key": "71842713d885",
  "tkey": "2e39a310f87d",
  "file": "26.mp3",
  "start": 114.41,
  "text": "一个确定的回应，比十句「我爱你」都管用。",
  "speed": 1.0,
  "dur": 3.1,
  "room": 3.3
 },
 "27.mp3": {
  "key": "bb056ab1f5e9",
  "tkey": "4f6b0f214df3",
  "file": "27.mp3",
  "start": 117.86,
  "text": "比如：「我今天很忙，晚上十点给你打电话。」",
  "speed": 1.0,
  "dur": 3.69,
  "room": 4.04
 },
 "28.mp3": {
  "key": "f476878922ee",
  "tkey": "aab17254bc79",
  "file": "28.mp3",
  "start": 122.05,
  "text": "研究也发现：另一半多一点包容，焦虑型的人也会慢慢缓和下来。",
  "speed": 1.0,
  "dur": 5.92,
  "room": 6.37
 },
 "29.mp3": {
  "key": "1d5bb2f30784",
  "tkey": "5ed715c54f10",
  "file": "29.mp3",
  "start": 128.57,
  "text": "依恋类型挺稳定，但不是一辈子的标签。",
  "speed": 1.0,
  "dur": 3.2,
  "room": 3.75
 },
 "30.mp3": {
  "key": "bac990b851e8",
  "tkey": "96549f0d6252",
  "file": "30.mp3",
  "start": 132.47,
  "text": "焦虑型的人，不是太黏人，只是太怕失去。",
  "speed": 1.0,
  "dur": 3.23,
  "room": 3.98
 },
 "31.mp3": {
  "key": "ed954003a12b",
  "tkey": "12b29785e884",
  "file": "31.mp3",
  "start": 136.6,
  "text": "评论区说说：你是焦虑型，还是正在爱着一个焦虑型？",
  "speed": 1.0,
  "dur": 4.08,
  "room": 7.25
 }
}