{
 "00.mp3": {
  "key": "ff6cf752d8c4",
  "start": 0.15,
  "text": "一个穿白大褂的人，让你电击隔壁答错题的人。",
  "speed": 1.0,
  "dur": 3.37,
  "room": 3.8
 },
 "01.mp3": {
  "key": "59ea4de536ee",
  "start": 3.89,
  "text": "他喊疼了，白大褂说「请继续」。多少人按到了最高的 450 伏？",
  "speed": 1.3,
  "dur": 4.16,
  "room": 3.95
 },
 "02.mp3": {
  "key": "ee863ce1b95b",
  "start": 8.2,
  "text": "答案是：约 65%。",
  "speed": 1.0,
  "dur": 2.18,
  "room": 2.45
 },
 "03.mp3": {
  "key": "c1abb89b11e5",
  "start": 10.8,
  "text": "40 个人里，有 26 个按到了最后。",
  "speed": 1.168,
  "dur": 2.19,
  "room": 2.65
 },
 "04.mp3": {
  "key": "bee59a0e05e1",
  "start": 13.29,
  "text": "实验前，精神科医生猜：只有极少数人会这样。",
  "speed": 1.3,
  "dur": 2.9,
  "room": 2.55
 },
 "05.mp3": {
  "key": "9d6a085db615",
  "start": 16.34,
  "text": "这是耶鲁大学米尔格拉姆的实验，1963 年发表。",
  "speed": 1.3,
  "dur": 2.95,
  "room": 3.45
 },
 "06.mp3": {
  "key": "644a55650e7f",
  "start": 19.9,
  "text": "电击是假的，喊疼的是演员；可按按钮的人不知道。",
  "speed": 1.17,
  "dur": 3.58,
  "room": 3.95
 },
 "07.mp3": {
  "key": "92c175ff0808",
  "start": 23.83,
  "text": "很多人一边冒汗、一边发抖，还是按了下去。",
  "speed": 1.0,
  "dur": 3.72,
  "room": 3.55
 },
 "08.mp3": {
  "key": "f4ae6ff6ced1",
  "start": 27.7,
  "text": "因为那个人说：「实验需要你继续。」",
  "speed": 1.0,
  "dur": 2.8,
  "room": 3.75
 },
 "09.mp3": {
  "key": "8bf68933ddda",
  "start": 31.6,
  "text": "这就是「权威主义」：把对错，交给穿制服的人去判断。",
  "speed": 1.0,
  "dur": 4.4,
  "room": 5.85
 },
 "10.mp3": {
  "key": "02d991de230c",
  "start": 37.6,
  "text": "可这个数字，会变。",
  "speed": 1.0,
  "dur": 1.68,
  "room": 3.15
 },
 "11.mp3": {
  "key": "3bf4933da52c",
  "start": 40.47,
  "text": "白大褂不在场，只打电话下指令，按到底的约两成；",
  "speed": 1.0,
  "dur": 4.28,
  "room": 3.85
 },
 "12.mp3": {
  "key": "6ec091124b74",
  "start": 44.9,
  "text": "身边有两个人先拒绝了，只剩约一成。",
  "speed": 1.0,
  "dur": 3.31,
  "room": 3.85
 },
 "13.mp3": {
  "key": "e993976621c5",
  "start": 48.9,
  "text": "服从会传染，反抗，也会。",
  "speed": 1.0,
  "dur": 3.24,
  "room": 4.55
 },
 "14.mp3": {
  "key": "c4a03dfda993",
  "start": 53.6,
  "text": "这个实验，也一直有争议。",
  "speed": 1.0,
  "dur": 2.24,
  "room": 4.15
 },
 "15.mp3": {
  "key": "ec94299c25fa",
  "start": 57.38,
  "text": "2009 年，有人在更安全的条件下重做：",
  "speed": 1.0,
  "dur": 3.27,
  "room": 2.75
 },
 "16.mp3": {
  "key": "d090c2edd4c3",
  "start": 60.8,
  "text": "到 150 伏为止，约七成的人还是愿意继续。",
  "speed": 1.165,
  "dur": 3.0,
  "room": 3.35
 },
 "17.mp3": {
  "key": "a43f8bd4e587",
  "start": 64.3,
  "text": "所以，当有人拿身份让你做不对的事，",
  "speed": 1.0,
  "dur": 2.99,
  "room": 3.45
 },
 "18.mp3": {
  "key": "a9fca1830dcf",
  "start": 67.9,
  "text": "先问一句：出了事，是谁的责任？",
  "speed": 1.0,
  "dur": 3.34,
  "room": 4.15
 },
 "19.mp3": {
  "key": "80ba9372e096",
  "start": 72.2,
  "text": "然后，试着做那个先说「不」的人。",
  "speed": 1.0,
  "dur": 3.03,
  "room": 3.95
 },
 "20.mp3": {
  "key": "4f76d841e6b7",
  "start": 76.3,
  "text": "米尔格拉姆后来写道：",
  "speed": 1.0,
  "dur": 1.51,
  "room": 3.75
 },
 "21.mp3": {
  "key": "bb6b536973fe",
  "start": 79.67,
  "text": "「普通人，只是在做自己的工作，也可能成为可怕之事的一环。」—— 米尔格拉姆（大意）",
  "speed": 1.3,
  "dur": 5.08,
  "room": 4.55
 },
 "22.mp3": {
  "key": "bb1c315cc086",
  "start": 84.9,
  "text": "你可以尊重权威，",
  "speed": 1.0,
  "dur": 1.25,
  "room": 3.85
 },
 "23.mp3": {
  "key": "2c519b801d08",
  "start": 88.9,
  "text": "但别把良心交出去。",
  "speed": 1.0,
  "dur": 1.04,
  "room": 4.35
 },
 "24.mp3": {
  "key": "9814bdebd513",
  "start": 93.4,
  "text": "服从之前，先问良心。",
  "speed": 1.0,
  "dur": 1.94,
  "room": 4.85
 },
 "25.mp3": {
  "key": "c20f6e5f0593",
  "start": 98.4,
  "text": "评论区：你有没有一次，没敢说「不」？",
  "speed": 1.0,
  "dur": 2.71,
  "room": 5.45
 }
}