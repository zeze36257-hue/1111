{
 "00.mp3": {
  "key": "c1ae9f55b1a9",
  "start": 0.15,
  "text": "把观点差不多的人，放在一起讨论。",
  "speed": 1.0,
  "dur": 2.94,
  "room": 3.8
 },
 "01.mp3": {
  "key": "40ee325412c4",
  "start": 3.45,
  "text": "讨论完，他们会变温和，还是更极端？先猜一个。",
  "speed": 1.0,
  "dur": 4.6,
  "room": 3.95
 },
 "02.mp3": {
  "key": "20fe67d69888",
  "start": 8.2,
  "text": "答案是 C：更极端了。",
  "speed": 1.0,
  "dur": 2.23,
  "room": 2.45
 },
 "03.mp3": {
  "key": "9def8eff6eee",
  "start": 10.8,
  "text": "偏左的更左，偏右的更右；",
  "speed": 1.0,
  "dur": 2.31,
  "room": 2.65
 },
 "04.mp3": {
  "key": "d0ab65c4e63e",
  "start": 13.6,
  "text": "而且组里的意见，更一致了。",
  "speed": 1.0,
  "dur": 2.02,
  "room": 2.55
 },
 "05.mp3": {
  "key": "61f99bac35c8",
  "start": 16.13,
  "text": "研究者在美国科罗拉多州，找来 63 个人。",
  "speed": 1.0,
  "dur": 3.62,
  "room": 3.45
 },
 "06.mp3": {
  "key": "aaf599245b12",
  "start": 19.9,
  "text": "一座城偏左，一座城偏右，各自讨论三个热门话题。",
  "speed": 1.0,
  "dur": 3.83,
  "room": 3.95
 },
 "07.mp3": {
  "key": "002d11466855",
  "start": 24.0,
  "text": "讨论之后，连匿名写下的看法，也更极端了。",
  "speed": 1.0,
  "dur": 3.54,
  "room": 3.55
 },
 "08.mp3": {
  "key": "ac45d0a1de16",
  "start": 27.7,
  "text": "两座城之间的距离，被拉得更远。",
  "speed": 1.0,
  "dur": 2.67,
  "room": 3.75
 },
 "09.mp3": {
  "key": "e4981d1943b0",
  "start": 31.6,
  "text": "「极端主义」，常常就是这样，一点点聊出来的。",
  "speed": 1.0,
  "dur": 3.42,
  "room": 5.85
 },
 "10.mp3": {
  "key": "24806da42740",
  "start": 37.34,
  "text": "心理学叫它「群体极化」。为什么会这样？",
  "speed": 1.0,
  "dur": 3.41,
  "room": 3.15
 },
 "11.mp3": {
  "key": "c655493a46d1",
  "start": 40.9,
  "text": "一是：群里听到的理由，大多站在同一边；",
  "speed": 1.137,
  "dur": 3.01,
  "room": 3.85
 },
 "12.mp3": {
  "key": "12526fb0ee00",
  "start": 44.65,
  "text": "二是：谁都想显得，比别人更像“自己人”。",
  "speed": 1.0,
  "dur": 4.1,
  "room": 3.85
 },
 "13.mp3": {
  "key": "7b4447a3fe0f",
  "start": 48.9,
  "text": "一来一回，整个群，就往边上挪了一步。",
  "speed": 1.0,
  "dur": 3.25,
  "room": 4.55
 },
 "14.mp3": {
  "key": "df8eb8a244d0",
  "start": 53.6,
  "text": "到了网上，我们更容易只关注想法相近的人：",
  "speed": 1.0,
  "dur": 3.28,
  "room": 4.15
 },
 "15.mp3": {
  "key": "aca915e1dae0",
  "start": 57.37,
  "text": "越聊越确定，越确定越不想听别的；",
  "speed": 1.0,
  "dur": 3.28,
  "room": 2.75
 },
 "16.mp3": {
  "key": "550288c1b6c2",
  "start": 60.8,
  "text": "最后，对面的人看起来，简直不可理喻。",
  "speed": 1.095,
  "dur": 3.06,
  "room": 3.35
 },
 "17.mp3": {
  "key": "21f35f1a6fc4",
  "start": 64.3,
  "text": "所以，当你发现自己越来越确定，",
  "speed": 1.0,
  "dur": 3.05,
  "room": 3.45
 },
 "18.mp3": {
  "key": "221d8d5a8667",
  "start": 67.9,
  "text": "可以去找一个想法不同、但讲道理的人聊聊。",
  "speed": 1.0,
  "dur": 3.07,
  "room": 4.15
 },
 "19.mp3": {
  "key": "71589213ba6c",
  "start": 72.2,
  "text": "不是为了被说服，是为了看见全貌。",
  "speed": 1.0,
  "dur": 2.55,
  "room": 3.95
 },
 "20.mp3": {
  "key": "49210f1507ab",
  "start": 76.3,
  "text": "两千多年前，孔子说：",
  "speed": 1.0,
  "dur": 1.78,
  "room": 3.75
 },
 "21.mp3": {
  "key": "f196dc5381ad",
  "start": 80.2,
  "text": "「过犹不及。」—— 孔子",
  "speed": 1.0,
  "dur": 2.07,
  "room": 4.55
 },
 "22.mp3": {
  "key": "c78d2c2ebab2",
  "start": 84.86,
  "text": "走过了头，和走得不够，一样是偏了；",
  "speed": 1.0,
  "dur": 3.89,
  "room": 3.85
 },
 "23.mp3": {
  "key": "2036a6993cc1",
  "start": 88.9,
  "text": "站在中间，不是没立场，是两头都看得见。",
  "speed": 1.0,
  "dur": 3.5,
  "room": 4.35
 },
 "24.mp3": {
  "key": "b0329f68bf3b",
  "start": 93.4,
  "text": "多听一边，少偏一步。",
  "speed": 1.0,
  "dur": 2.25,
  "room": 4.85
 },
 "25.mp3": {
  "key": "3c425b4ab8df",
  "start": 98.4,
  "text": "评论区：你有没有在一个群里，越聊越上头？",
  "speed": 1.0,
  "dur": 3.7,
  "room": 5.45
 }
}