{
 "00.mp3": {
  "key": "f51293d3eee8",
  "start": 0.15,
  "text": "你决定动一下手指，然后，它动了。",
  "speed": 1.0,
  "dur": 3.0,
  "room": 3.8
 },
 "01.mp3": {
  "key": "7d8775524f15",
  "start": 4.1,
  "text": "大脑开始准备，比你「决定」早多久？先猜一个。",
  "speed": 1.0,
  "dur": 3.66,
  "room": 3.95
 },
 "02.mp3": {
  "key": "d43f4eff4a45",
  "start": 8.2,
  "text": "答案是：约 0.35 秒。",
  "speed": 1.0,
  "dur": 2.31,
  "room": 2.45
 },
 "03.mp3": {
  "key": "6404a7318f65",
  "start": 10.8,
  "text": "在你觉得「我要动了」之前，",
  "speed": 1.0,
  "dur": 1.43,
  "room": 2.65
 },
 "04.mp3": {
  "key": "1b78a966c02d",
  "start": 13.6,
  "text": "大脑已经准备了一会儿。",
  "speed": 1.0,
  "dur": 1.6,
  "room": 2.55
 },
 "05.mp3": {
  "key": "1cfd1eea2044",
  "start": 16.3,
  "text": "这是 1983 年，利贝特做的实验。",
  "speed": 1.0,
  "dur": 2.91,
  "room": 3.45
 },
 "06.mp3": {
  "key": "1d5a991bacf8",
  "start": 19.9,
  "text": "后来有研究用脑扫描，能提前几秒猜你按左还是按右，",
  "speed": 1.17,
  "dur": 3.85,
  "room": 3.95
 },
 "07.mp3": {
  "key": "b043d56a2e19",
  "start": 24.0,
  "text": "准确率约六成，只比瞎猜好一点。",
  "speed": 1.0,
  "dur": 2.39,
  "room": 3.55
 },
 "08.mp3": {
  "key": "b111542e758a",
  "start": 27.7,
  "text": "难道，我们的选择早就被决定了？",
  "speed": 1.0,
  "dur": 2.67,
  "room": 3.75
 },
 "09.mp3": {
  "key": "ea4640eee063",
  "start": 31.6,
  "text": "这就是「决定论」的问题。",
  "speed": 1.0,
  "dur": 1.35,
  "room": 5.85
 },
 "10.mp3": {
  "key": "00836501985a",
  "start": 37.6,
  "text": "两百年前，拉普拉斯想象过一个「恶魔」：",
  "speed": 1.0,
  "dur": 2.63,
  "room": 3.15
 },
 "11.mp3": {
  "key": "62fbcfd2bf9f",
  "start": 40.9,
  "text": "只要知道此刻所有粒子的位置和速度，",
  "speed": 1.0,
  "dur": 2.52,
  "room": 3.85
 },
 "12.mp3": {
  "key": "d9debcf9f19d",
  "start": 44.84,
  "text": "就能算出全部的未来，包括你下一秒做什么。",
  "speed": 1.0,
  "dur": 3.91,
  "room": 3.85
 },
 "13.mp3": {
  "key": "109b1f4c6de0",
  "start": 48.9,
  "text": "如果真是这样，「我决定」还有意义吗？",
  "speed": 1.0,
  "dur": 2.63,
  "room": 4.55
 },
 "14.mp3": {
  "key": "7ec3c0146af1",
  "start": 53.37,
  "text": "可 2012 年，研究者重新解释了那个「准备信号」：",
  "speed": 1.0,
  "dur": 4.38,
  "room": 4.15
 },
 "15.mp3": {
  "key": "e7bb915a1c00",
  "start": 57.9,
  "text": "它更像随机的起伏，碰巧涨过门槛，未必是「已经做好的决定」。",
  "speed": 1.0,
  "dur": 5.28,
  "room": 6.25
 },
 "16.mp3": {
  "key": "687a59316ea8",
  "start": 64.3,
  "text": "科学还没有给出最后的答案。",
  "speed": 1.0,
  "dur": 1.59,
  "room": 3.45
 },
 "17.mp3": {
  "key": "ce1e817d2ad3",
  "start": 67.9,
  "text": "但利贝特自己，并不觉得人只是机器。",
  "speed": 1.0,
  "dur": 2.75,
  "room": 4.15
 },
 "18.mp3": {
  "key": "daf11405be9d",
  "start": 72.2,
  "text": "他发现，人在最后一刻，还能喊停。",
  "speed": 1.0,
  "dur": 3.25,
  "room": 3.95
 },
 "19.mp3": {
  "key": "36f328aecb1f",
  "start": 76.3,
  "text": "他写道：",
  "speed": 1.0,
  "dur": 0.44,
  "room": 3.75
 },
 "20.mp3": {
  "key": "f7d4a03dd2da",
  "start": 79.92,
  "text": "「意识的作用，也许不是发起一个动作，而是决定让不让它发生。」—— 利贝特",
  "speed": 1.3,
  "dur": 4.83,
  "room": 4.55
 },
 "21.mp3": {
  "key": "5b34f0ec7661",
  "start": 84.9,
  "text": "念头会先来，",
  "speed": 1.0,
  "dur": 1.16,
  "room": 3.85
 },
 "22.mp3": {
  "key": "b9960a37022d",
  "start": 88.9,
  "text": "但最后那一下，你还能说「不」。",
  "speed": 1.0,
  "dur": 2.22,
  "room": 4.35
 },
 "23.mp3": {
  "key": "627c01196db1",
  "start": 93.4,
  "text": "你管不了念头，但管得了下一步。",
  "speed": 1.0,
  "dur": 2.72,
  "room": 4.85
 },
 "24.mp3": {
  "key": "2f5a5c84fc3d",
  "start": 98.4,
  "text": "评论区：你相信自由意志吗？",
  "speed": 1.0,
  "dur": 2.61,
  "room": 5.45
 }
}