{
 "00.mp3": {
  "key": "eb3ffa98e160",
  "start": 0.15,
  "text": "研究者问大学生：校园里那种狂饮，你自在吗？",
  "speed": 1.0,
  "dur": 3.8,
  "room": 3.8
 },
 "01.mp3": {
  "key": "e84b2c851b09",
  "start": 4.1,
  "text": "再问：那一般同学呢？结果会怎样？先猜一个。",
  "speed": 1.064,
  "dur": 4.85,
  "room": 3.95
 },
 "02.mp3": {
  "key": "ed67ad2b6ead",
  "start": 9.1,
  "text": "答案是 C：都觉得别人比自己更自在。",
  "speed": 1.3,
  "dur": 2.29,
  "room": 2.45
 },
 "03.mp3": {
  "key": "18be71df4573",
  "start": 11.54,
  "text": "很多人私下都有点不舒服，",
  "speed": 1.0,
  "dur": 1.81,
  "room": 2.65
 },
 "04.mp3": {
  "key": "f2665829a60c",
  "start": 13.6,
  "text": "却都以为，只有自己这样。",
  "speed": 1.0,
  "dur": 1.92,
  "room": 2.55
 },
 "05.mp3": {
  "key": "96a7490a303e",
  "start": 16.3,
  "text": "于是，谁也不说。",
  "speed": 1.0,
  "dur": 1.99,
  "room": 3.45
 },
 "06.mp3": {
  "key": "ae35e8c435e8",
  "start": 19.9,
  "text": "大家一起喝，一起装作很享受。",
  "speed": 1.0,
  "dur": 2.57,
  "room": 3.95
 },
 "07.mp3": {
  "key": "ae459356d97f",
  "start": 24.0,
  "text": "更糟的是，一个学期后，男生的看法，",
  "speed": 1.0,
  "dur": 3.01,
  "room": 3.55
 },
 "08.mp3": {
  "key": "2b5b633c5e68",
  "start": 27.7,
  "text": "慢慢变得更像那个“想象中的大家”。",
  "speed": 1.0,
  "dur": 2.72,
  "room": 3.75
 },
 "09.mp3": {
  "key": "50772cd2a183",
  "start": 31.6,
  "text": "这就是「沉默主义」：都以为别人同意，就都不开口。",
  "speed": 1.0,
  "dur": 4.26,
  "room": 5.85
 },
 "10.mp3": {
  "key": "868c6c698fc2",
  "start": 37.6,
  "text": "教室里也一样。",
  "speed": 1.0,
  "dur": 1.23,
  "room": 3.15
 },
 "11.mp3": {
  "key": "178be1a92dc8",
  "start": 40.9,
  "text": "老师问：有没有问题？没人举手。",
  "speed": 1.0,
  "dur": 2.96,
  "room": 3.85
 },
 "12.mp3": {
  "key": "a2977fc0f2ea",
  "start": 44.9,
  "text": "每个没听懂的人都在想：大家应该都懂了吧。",
  "speed": 1.0,
  "dur": 3.02,
  "room": 3.85
 },
 "13.mp3": {
  "key": "f0a6a141bb45",
  "start": 48.9,
  "text": "一屋子的沉默，其实是一屋子的问号。",
  "speed": 1.0,
  "dur": 2.94,
  "room": 4.55
 },
 "14.mp3": {
  "key": "6a9bfe98cf26",
  "start": 53.6,
  "text": "这像不像《皇帝的新装》？",
  "speed": 1.0,
  "dur": 1.92,
  "room": 4.15
 },
 "15.mp3": {
  "key": "e5b07bf2276b",
  "start": 57.54,
  "text": "人人都看见了，却以为只有自己看见；",
  "speed": 1.0,
  "dur": 3.11,
  "room": 2.75
 },
 "16.mp3": {
  "key": "f5d2d6f182c4",
  "start": 60.8,
  "text": "直到一个小孩，说出了口。",
  "speed": 1.0,
  "dur": 2.19,
  "room": 3.35
 },
 "17.mp3": {
  "key": "f7a39133ccf7",
  "start": 64.05,
  "text": "所以，当你心里犯嘀咕，却没人说话时，",
  "speed": 1.0,
  "dur": 3.7,
  "room": 3.45
 },
 "18.mp3": {
  "key": "4d64df4240e9",
  "start": 67.9,
  "text": "可以先轻轻问一句：只有我这么觉得吗？",
  "speed": 1.0,
  "dur": 3.16,
  "room": 4.15
 },
 "19.mp3": {
  "key": "c83a3a78a815",
  "start": 72.2,
  "text": "很多时候，会有人松一口气：原来不止我。",
  "speed": 1.0,
  "dur": 3.82,
  "room": 3.95
 },
 "20.mp3": {
  "key": "0c0d7456f94f",
  "start": 76.3,
  "text": "一百年前，鲁迅写过：",
  "speed": 1.0,
  "dur": 1.85,
  "room": 3.75
 },
 "21.mp3": {
  "key": "792f30e8e26a",
  "start": 80.2,
  "text": "「不在沉默中爆发，就在沉默中灭亡。」—— 鲁迅",
  "speed": 1.0,
  "dur": 3.82,
  "room": 4.55
 },
 "22.mp3": {
  "key": "ec82fdab1dd6",
  "start": 84.9,
  "text": "不一定要爆发，",
  "speed": 1.0,
  "dur": 1.1,
  "room": 3.85
 },
 "23.mp3": {
  "key": "9951e4a3e203",
  "start": 88.9,
  "text": "但可以做那个，先小声说出来的人。",
  "speed": 1.0,
  "dur": 2.73,
  "room": 4.35
 },
 "24.mp3": {
  "key": "6988ff3c153e",
  "start": 93.4,
  "text": "你说出口，别人才敢说。",
  "speed": 1.0,
  "dur": 2.24,
  "room": 4.85
 },
 "25.mp3": {
  "key": "27acd8692975",
  "start": 98.4,
  "text": "评论区：你有没有一句“大家都不说”的话？",
  "speed": 1.0,
  "dur": 3.21,
  "room": 5.45
 }
}