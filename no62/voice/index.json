{
 "00.mp3": {
  "key": "38e9e894dcb4",
  "start": 0.15,
  "text": "主动承认一个错误，或者先开口道歉。",
  "speed": 1.0,
  "dur": 2.83,
  "room": 3.8
 },
 "01.mp3": {
  "key": "3582345ae6ed",
  "start": 3.84,
  "text": "你觉得自己显得怎样？别人又怎么看？先猜一个。",
  "speed": 1.0,
  "dur": 4.21,
  "room": 3.95
 },
 "02.mp3": {
  "key": "356ee6b144ad",
  "start": 8.2,
  "text": "答案是 B：自己觉得丢脸，别人觉得勇敢。",
  "speed": 1.3,
  "dur": 2.9,
  "room": 2.45
 },
 "03.mp3": {
  "key": "689b590fda1a",
  "start": 11.25,
  "text": "研究者做了七个实验：表白、求助、露出不完美，",
  "speed": 1.3,
  "dur": 3.77,
  "room": 2.65
 },
 "04.mp3": {
  "key": "e3e9fe071b12",
  "start": 15.17,
  "text": "换成别人来做，大家都更欣赏。",
  "speed": 1.0,
  "dur": 2.4,
  "room": 2.55
 },
 "05.mp3": {
  "key": "9027307f1248",
  "start": 17.72,
  "text": "心理学家叫它「美丽的混乱效应」：",
  "speed": 1.0,
  "dur": 2.74,
  "room": 3.45
 },
 "06.mp3": {
  "key": "db4d8e5144a1",
  "start": 20.61,
  "text": "自己示弱时，满脑子是细节：脸红、结巴、被笑话；",
  "speed": 1.3,
  "dur": 4.01,
  "room": 3.95
 },
 "07.mp3": {
  "key": "0c1dd9994120",
  "start": 24.77,
  "text": "看别人示弱时，看到的是整体：真诚、有勇气。",
  "speed": 1.268,
  "dur": 3.63,
  "room": 3.55
 },
 "08.mp3": {
  "key": "090594e5e567",
  "start": 28.55,
  "text": "同一件事，在自己眼里是狼狈，在别人眼里是真实。",
  "speed": 1.118,
  "dur": 3.99,
  "room": 3.75
 },
 "09.mp3": {
  "key": "1d86bd430f85",
  "start": 32.69,
  "text": "这就是「面子主义」：宁可撑着，也不肯露一点。",
  "speed": 1.0,
  "dur": 4.13,
  "room": 5.85
 },
 "10.mp3": {
  "key": "690dcb38f795",
  "start": 37.6,
  "text": "还有个老实验：",
  "speed": 1.0,
  "dur": 0.96,
  "room": 3.15
 },
 "11.mp3": {
  "key": "8d3e1017b791",
  "start": 40.9,
  "text": "一个答题高手，录完节目，不小心洒了一身咖啡；",
  "speed": 1.0,
  "dur": 3.53,
  "room": 3.85
 },
 "12.mp3": {
  "key": "8285effd02c6",
  "start": 44.9,
  "text": "听录音的人，反而更喜欢他了。",
  "speed": 1.0,
  "dur": 2.46,
  "room": 3.85
 },
 "13.mp3": {
  "key": "85484c4959e0",
  "start": 48.9,
  "text": "有本事的人出一点小丑，反而更像个人。",
  "speed": 1.0,
  "dur": 3.51,
  "room": 4.55
 },
 "14.mp3": {
  "key": "0f0b1c480138",
  "start": 53.6,
  "text": "求助也一样。",
  "speed": 1.0,
  "dur": 1.06,
  "room": 4.15
 },
 "15.mp3": {
  "key": "8d341da4e461",
  "start": 57.9,
  "text": "我们以为开口求人，多半会被拒绝；",
  "speed": 1.0,
  "dur": 2.57,
  "room": 2.75
 },
 "16.mp3": {
  "key": "0b2548903e3b",
  "start": 60.8,
  "text": "实际愿意帮忙的人，大约是你猜的两倍。",
  "speed": 1.0,
  "dur": 3.17,
  "room": 3.35
 },
 "17.mp3": {
  "key": "cd65228cc2c0",
  "start": 64.3,
  "text": "所以，撑不住的时候，",
  "speed": 1.0,
  "dur": 1.95,
  "room": 3.45
 },
 "18.mp3": {
  "key": "d65da61056fa",
  "start": 67.9,
  "text": "可以试着说一句：这个我不太会，能帮我一下吗？",
  "speed": 1.0,
  "dur": 3.87,
  "room": 4.15
 },
 "19.mp3": {
  "key": "a2b772ca49bb",
  "start": 72.2,
  "text": "你丢的面子，没有你想的那么多。",
  "speed": 1.0,
  "dur": 2.28,
  "room": 3.95
 },
 "20.mp3": {
  "key": "fbf3c020764b",
  "start": 76.3,
  "text": "两千多年前，子贡说：",
  "speed": 1.0,
  "dur": 2.1,
  "room": 3.75
 },
 "21.mp3": {
  "key": "addbf7921759",
  "start": 79.2,
  "text": "「君子之过也，如日月之食焉：过也，人皆见之；更也，人皆仰之。」——《论语》",
  "speed": 1.3,
  "dur": 6.75,
  "room": 4.55
 },
 "22.mp3": {
  "key": "c3c289e2760b",
  "start": 86.1,
  "text": "犯错的时候，大家都看见了；",
  "speed": 1.0,
  "dur": 1.69,
  "room": 3.85
 },
 "23.mp3": {
  "key": "60f41d4ac40b",
  "start": 88.9,
  "text": "改过来的时候，大家也都看见了。",
  "speed": 1.0,
  "dur": 2.12,
  "room": 4.35
 },
 "24.mp3": {
  "key": "f23ddd2f4c77",
  "start": 93.4,
  "text": "露一点不完美，人反而更近。",
  "speed": 1.0,
  "dur": 2.47,
  "room": 4.85
 },
 "25.mp3": {
  "key": "7d51791ad92c",
  "start": 98.4,
  "text": "评论区：你最近一次放下面子，是为了什么？",
  "speed": 1.0,
  "dur": 3.49,
  "room": 5.45
 }
}