{
 "00.mp3": {
  "key": "a382d9dafcba",
  "tkey": "180e575032d5",
  "file": "00.mp3",
  "start": 0.15,
  "text": "你发了三条消息，他一条也没回；",
  "speed": 1.0,
  "dur": 2.89,
  "room": 3.14
 },
 "01.mp3": {
  "key": "03efbbb2b786",
  "tkey": "0eea5de0d820",
  "file": "01.mp3",
  "start": 3.44,
  "text": "你越问「你怎么了」，他越不想说话；",
  "speed": 1.0,
  "dur": 2.37,
  "room": 2.62
 },
 "02.mp3": {
  "key": "5525ef586f8a",
  "tkey": "628b003f5082",
  "file": "02.mp3",
  "start": 6.21,
  "text": "他只是想静一静，你却觉得：他要走了。",
  "speed": 1.0,
  "dur": 3.71,
  "room": 4.11
 },
 "03.mp3": {
  "key": "f480e9e263e6",
  "tkey": "1665e5247027",
  "file": "03.mp3",
  "start": 10.47,
  "text": "一个越追，一个越跑。",
  "speed": 1.0,
  "dur": 1.9,
  "room": 2.35
 },
 "04.mp3": {
  "key": "e2b0ffc32d95",
  "tkey": "1ddca7326ee3",
  "file": "04.mp3",
  "start": 12.97,
  "text": "今天，我们一起来聊聊：焦虑型配回避型。",
  "speed": 1.0,
  "dur": 3.73,
  "room": 6.38
 },
 "05.mp3": {
  "key": "4ccf05953f82",
  "tkey": "f4ae9f6701b8",
  "file": "05.mp3",
  "start": 19.5,
  "text": "有一项研究，调查了三百多对恋人：",
  "speed": 1.0,
  "dur": 2.57,
  "room": 2.72
 },
 "06.mp3": {
  "key": "0d0dece9df2e",
  "tkey": "5b986921c033",
  "file": "06.mp3",
  "start": 22.37,
  "text": "两个都焦虑、两个都回避的，一对也没有。",
  "speed": 1.0,
  "dur": 3.57,
  "room": 3.92
 },
 "07.mp3": {
  "key": "1c830b99a341",
  "tkey": "6d3c813c42a3",
  "file": "07.mp3",
  "start": 26.44,
  "text": "一种解释是：对方的样子，正好印证了自己的担心。",
  "speed": 1.0,
  "dur": 3.5,
  "room": 3.75
 },
 "08.mp3": {
  "key": "d01273b253a1",
  "tkey": "542a80ec8538",
  "file": "08.mp3",
  "start": 30.34,
  "text": "焦虑型想：「你看，他果然会走。」",
  "speed": 1.0,
  "dur": 3.52,
  "room": 3.67
 },
 "09.mp3": {
  "key": "bc7593ac4d6a",
  "tkey": "610570979a12",
  "file": "09.mp3",
  "start": 34.16,
  "text": "回避型想：「你看，靠太近，就会被缠住。」",
  "speed": 1.0,
  "dur": 3.79,
  "room": 7.59
 },
 "10.mp3": {
  "key": "d3ab05acc780",
  "tkey": "1d8230cd720a",
  "file": "10.mp3",
  "start": 41.9,
  "text": "于是，就有了这个圈：",
  "speed": 1.0,
  "dur": 1.74,
  "room": 1.89
 },
 "11.mp3": {
  "key": "31ea489f5105",
  "tkey": "995905602c04",
  "file": "11.mp3",
  "start": 43.94,
  "text": "焦虑型心里的警报一响，就去追：发消息、追问、要一个答案；",
  "speed": 1.0,
  "dur": 6.25,
  "room": 6.45
 },
 "12.mp3": {
  "key": "19872a3ad1e2",
  "tkey": "e2864b65a950",
  "file": "12.mp3",
  "start": 50.54,
  "text": "回避型被追得喘不过气，就往后退：不回、沉默、冷下来。",
  "speed": 1.0,
  "dur": 5.91,
  "room": 6.21
 },
 "13.mp3": {
  "key": "f3c931b7a2d9",
  "tkey": "f36872a214a9",
  "file": "13.mp3",
  "start": 56.9,
  "text": "心理学家把它叫作「要求—退缩」。",
  "speed": 1.0,
  "dur": 3.14,
  "room": 3.39
 },
 "14.mp3": {
  "key": "2c96e60f2a80",
  "tkey": "54d2e0061df4",
  "file": "14.mp3",
  "start": 60.44,
  "text": "研究发现：这样的圈转得越多，两个人都越不满意。",
  "speed": 1.0,
  "dur": 4.17,
  "room": 6.91
 },
 "15.mp3": {
  "key": "ce85fe8374e3",
  "tkey": "27fd1892b307",
  "file": "15.mp3",
  "start": 67.5,
  "text": "可奇怪的是，这样的两个人，常常分不开。",
  "speed": 1.0,
  "dur": 3.64,
  "room": 3.89
 },
 "16.mp3": {
  "key": "7b4b4121e502",
  "tkey": "a2bfd241ac31",
  "file": "16.mp3",
  "start": 71.54,
  "text": "那项研究三年后又回访：",
  "speed": 1.0,
  "dur": 1.72,
  "room": 1.77
 },
 "17.mp3": {
  "key": "4c9fd2fbed3b",
  "tkey": "f0e8fd5b6a98",
  "file": "17.mp3",
  "start": 73.46,
  "text": "回避型男生、焦虑型女生的恋爱，两个人打分都不高，却意外地稳定。",
  "speed": 1.0,
  "dur": 6.81,
  "room": 9.89
 },
 "18.mp3": {
  "key": "be8a9737ab0d",
  "tkey": "ec24d644d180",
  "file": "18.mp3",
  "start": 83.5,
  "text": "想走出这个圈，先要看见它。",
  "speed": 1.0,
  "dur": 2.23,
  "room": 2.43
 },
 "19.mp3": {
  "key": "dfa07217b11e",
  "tkey": "ec360242e087",
  "file": "19.mp3",
  "start": 86.08,
  "text": "下次又绕起来，说一句：「我们又在转圈了。」",
  "speed": 1.0,
  "dur": 3.7,
  "room": 4.0
 },
 "20.mp3": {
  "key": "560828490ea6",
  "tkey": "a7d908267029",
  "file": "20.mp3",
  "start": 90.23,
  "text": "焦虑型，先别追问，直接说你需要什么；",
  "speed": 1.0,
  "dur": 3.26,
  "room": 3.41
 },
 "21.mp3": {
  "key": "b66cc36e6657",
  "tkey": "e3a9646c10af",
  "file": "21.mp3",
  "start": 93.79,
  "text": "回避型，想退的时候，说好什么时候回来。",
  "speed": 1.0,
  "dur": 3.44,
  "room": 3.74
 },
 "22.mp3": {
  "key": "f7b758937aaa",
  "tkey": "ae7b9f8213ea",
  "file": "22.mp3",
  "start": 97.68,
  "text": "要对付的，是这个圈，不是对方。",
  "speed": 1.0,
  "dur": 2.73,
  "room": 3.28
 },
 "23.mp3": {
  "key": "c2df1f039c84",
  "tkey": "1e46743cc9bb",
  "file": "23.mp3",
  "start": 101.11,
  "text": "一个怕被丢下，一个怕被困住。",
  "speed": 1.0,
  "dur": 2.06,
  "room": 2.71
 },
 "24.mp3": {
  "key": "3df1a00fdbd7",
  "tkey": "770c6448c4e3",
  "file": "24.mp3",
  "start": 103.97,
  "text": "评论区说说：你是追的那个，还是跑的那个？",
  "speed": 1.0,
  "dur": 3.23,
  "room": 4.68
 }
}