{
 "00.mp3": {
  "key": "e8be053e505f",
  "start": 0.15,
  "text": "服务员递账单的时候，顺手送你糖。",
  "speed": 1.0,
  "dur": 2.44,
  "room": 3.8
 },
 "01.mp3": {
  "key": "f6597e86d6b0",
  "start": 4.04,
  "text": "哪种送法，拿到的小费最多？先猜一个。",
  "speed": 1.0,
  "dur": 4.01,
  "room": 3.95
 },
 "02.mp3": {
  "key": "293d7f976713",
  "start": 8.2,
  "text": "答案是 C：小费多了约两成。",
  "speed": 1.3,
  "dur": 2.14,
  "room": 2.45
 },
 "03.mp3": {
  "key": "1a2d2693110d",
  "start": 10.8,
  "text": "同样是两颗糖，回头的那一下，",
  "speed": 1.0,
  "dur": 2.42,
  "room": 2.65
 },
 "04.mp3": {
  "key": "2b2a1d2d9552",
  "start": 13.6,
  "text": "像在说：这是特意给你的。",
  "speed": 1.0,
  "dur": 2.35,
  "room": 2.55
 },
 "05.mp3": {
  "key": "38a8f7229002",
  "start": 16.3,
  "text": "社会学家古尔德纳认为，几乎每种文化里，",
  "speed": 1.13,
  "dur": 3.25,
  "room": 3.45
 },
 "06.mp3": {
  "key": "1c32a25d973e",
  "start": 19.9,
  "text": "都有同一条规矩：别人对你好，你要还。",
  "speed": 1.0,
  "dur": 3.93,
  "room": 3.95
 },
 "07.mp3": {
  "key": "5004a4ba8aa3",
  "start": 24.0,
  "text": "收了好处不还，我们就浑身不自在。",
  "speed": 1.0,
  "dur": 2.73,
  "room": 3.55
 },
 "08.mp3": {
  "key": "1505bc841d95",
  "start": 27.7,
  "text": "这份不自在，是人和人之间的一根线。",
  "speed": 1.0,
  "dur": 2.66,
  "room": 3.75
 },
 "09.mp3": {
  "key": "317ebe7d42bd",
  "start": 31.6,
  "text": "这就是「互惠主义」：有来，就要有往。",
  "speed": 1.0,
  "dur": 3.5,
  "room": 5.85
 },
 "10.mp3": {
  "key": "eaf492a983fa",
  "start": 37.6,
  "text": "心理学家里根做过一个实验：",
  "speed": 1.0,
  "dur": 1.7,
  "room": 3.15
 },
 "11.mp3": {
  "key": "0cdcb0e9df3c",
  "start": 40.9,
  "text": "一个陌生人，顺手请你喝了一瓶可乐；",
  "speed": 1.0,
  "dur": 3.13,
  "room": 3.85
 },
 "12.mp3": {
  "key": "22518a93970a",
  "start": 44.72,
  "text": "过一会儿他找你买彩票，你买的约是别人的两倍。",
  "speed": 1.0,
  "dur": 4.03,
  "room": 3.85
 },
 "13.mp3": {
  "key": "e8057d293fbc",
  "start": 48.9,
  "text": "平均下来，花的钱比那瓶可乐还多。",
  "speed": 1.0,
  "dur": 2.67,
  "room": 4.55
 },
 "14.mp3": {
  "key": "d977dd8d73f3",
  "start": 53.6,
  "text": "可这根线，也能被人拿来拉你。",
  "speed": 1.0,
  "dur": 2.51,
  "room": 4.15
 },
 "15.mp3": {
  "key": "ef40d69d38a0",
  "start": 57.9,
  "text": "免费试吃、先送小礼物，",
  "speed": 1.0,
  "dur": 2.28,
  "room": 2.75
 },
 "16.mp3": {
  "key": "7491b954741f",
  "start": 60.8,
  "text": "都是先给你一点，再等你回一点。",
  "speed": 1.0,
  "dur": 2.85,
  "room": 3.35
 },
 "17.mp3": {
  "key": "c0b26d5ce412",
  "start": 63.95,
  "text": "所以，收到好意的时候，先说声谢谢；",
  "speed": 1.0,
  "dur": 3.8,
  "room": 3.45
 },
 "18.mp3": {
  "key": "220bf568c5e4",
  "start": 67.9,
  "text": "真心想还，再还；觉得被套路了，也可以不还。",
  "speed": 1.3,
  "dur": 3.37,
  "room": 4.15
 },
 "19.mp3": {
  "key": "d1b31028d093",
  "start": 72.2,
  "text": "好意，不该变成一笔债。",
  "speed": 1.0,
  "dur": 2.22,
  "room": 3.95
 },
 "20.mp3": {
  "key": "1986915c08cd",
  "start": 76.3,
  "text": "两千多年前，《诗经》里写：",
  "speed": 1.0,
  "dur": 2.12,
  "room": 3.75
 },
 "21.mp3": {
  "key": "bbe8ff6502d7",
  "start": 79.2,
  "text": "「投我以木瓜，报之以琼琚。匪报也，永以为好也。」——《诗经》",
  "speed": 1.3,
  "dur": 6.44,
  "room": 4.55
 },
 "22.mp3": {
  "key": "f9938055a07a",
  "start": 85.79,
  "text": "你送我木瓜，我回你美玉；",
  "speed": 1.0,
  "dur": 2.24,
  "room": 3.85
 },
 "23.mp3": {
  "key": "248c300e0fca",
  "start": 88.9,
  "text": "不是为了还清，是想一直好下去。",
  "speed": 1.0,
  "dur": 2.39,
  "room": 4.35
 },
 "24.mp3": {
  "key": "7fd284aa82b5",
  "start": 93.4,
  "text": "好意不是债，是开始。",
  "speed": 1.0,
  "dur": 2.2,
  "room": 4.85
 },
 "25.mp3": {
  "key": "b9925e304989",
  "start": 98.4,
  "text": "评论区：最近一次让你想“还”的好意，是什么？",
  "speed": 1.0,
  "dur": 3.45,
  "room": 5.45
 }
}