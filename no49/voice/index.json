{
 "00.mp3": {
  "key": "8dd5a5eda9fc",
  "start": 0.15,
  "text": "你先买了一张 100 美元的滑雪票，后来又买了一张 50 美元的。",
  "speed": 1.3,
  "dur": 3.01,
  "room": 3.8
 },
 "01.mp3": {
  "key": "c451509c2891",
  "start": 3.47,
  "text": "你更喜欢便宜那趟，可两趟撞了日子，都不能退。你会去哪趟？",
  "speed": 1.286,
  "dur": 4.58,
  "room": 3.95
 },
 "02.mp3": {
  "key": "c7547d10e90e",
  "start": 8.2,
  "text": "答案是：过半的人，去了贵的那趟。",
  "speed": 1.3,
  "dur": 2.3,
  "room": 2.45
 },
 "03.mp3": {
  "key": "190a00abd2ab",
  "start": 10.8,
  "text": "明明更喜欢另一趟，",
  "speed": 1.0,
  "dur": 1.4,
  "room": 2.65
 },
 "04.mp3": {
  "key": "2cbc150abc4f",
  "start": 13.6,
  "text": "还是选了「不去就亏了」的那一趟。",
  "speed": 1.0,
  "dur": 2.47,
  "room": 2.55
 },
 "05.mp3": {
  "key": "7bf77521e73f",
  "start": 16.3,
  "text": "这是 1985 年，阿克斯和布鲁默的实验。",
  "speed": 1.069,
  "dur": 4.02,
  "room": 3.45
 },
 "06.mp3": {
  "key": "4baffc491c6d",
  "start": 20.47,
  "text": "可钱已经花了，选哪趟都拿不回来。",
  "speed": 1.0,
  "dur": 2.85,
  "room": 3.95
 },
 "07.mp3": {
  "key": "6b1eb6aa3219",
  "start": 24.0,
  "text": "经济学家把这叫「沉没成本」：",
  "speed": 1.0,
  "dur": 1.96,
  "room": 3.55
 },
 "08.mp3": {
  "key": "c3f4f6a2fe83",
  "start": 27.7,
  "text": "已经沉下去的钱，不该决定接下来的路。",
  "speed": 1.0,
  "dur": 2.82,
  "room": 3.75
 },
 "09.mp3": {
  "key": "e33a09410c29",
  "start": 31.6,
  "text": "这就是「节俭主义」的陷阱：怕浪费钱，结果浪费了更多。",
  "speed": 1.0,
  "dur": 3.97,
  "room": 5.85
 },
 "10.mp3": {
  "key": "a972d3409844",
  "start": 37.6,
  "text": "他们还做了一个真实的实验：",
  "speed": 1.0,
  "dur": 1.62,
  "room": 3.15
 },
 "11.mp3": {
  "key": "fb2cf9cd6893",
  "start": 40.9,
  "text": "剧院的季票，随机打折卖给观众。",
  "speed": 1.0,
  "dur": 3.16,
  "room": 3.85
 },
 "12.mp3": {
  "key": "e0eaf622b232",
  "start": 44.9,
  "text": "付全价的人，接下来半年来看戏的次数更多。",
  "speed": 1.0,
  "dur": 3.09,
  "room": 3.85
 },
 "13.mp3": {
  "key": "6901554d59fe",
  "start": 48.9,
  "text": "不一定是更喜欢，是怕「白花了钱」。",
  "speed": 1.0,
  "dur": 2.75,
  "room": 4.55
 },
 "14.mp3": {
  "key": "003e77d6d9a8",
  "start": 53.6,
  "text": "更有意思的是：",
  "speed": 1.0,
  "dur": 1.01,
  "room": 4.15
 },
 "15.mp3": {
  "key": "52f4f6951b1f",
  "start": 57.55,
  "text": "有研究者认为，动物和年幼的孩子，",
  "speed": 1.0,
  "dur": 3.1,
  "room": 2.75
 },
 "16.mp3": {
  "key": "4a0f8cb53691",
  "start": 60.8,
  "text": "似乎反而不太犯这个错。",
  "speed": 1.0,
  "dur": 1.71,
  "room": 3.35
 },
 "17.mp3": {
  "key": "5da62417d7c1",
  "start": 64.3,
  "text": "所以，下次舍不得放下的时候，问问自己：",
  "speed": 1.0,
  "dur": 3.15,
  "room": 3.45
 },
 "18.mp3": {
  "key": "742e82d2db98",
  "start": 67.9,
  "text": "如果今天才开始，我还会选它吗？",
  "speed": 1.0,
  "dur": 3.21,
  "room": 4.15
 },
 "19.mp3": {
  "key": "59f0f3690929",
  "start": 72.2,
  "text": "花掉的钱回不来，但接下来的时间，还是你的。",
  "speed": 1.0,
  "dur": 3.79,
  "room": 3.95
 },
 "20.mp3": {
  "key": "a23709543f6e",
  "start": 76.3,
  "text": "有一句老话说：",
  "speed": 1.0,
  "dur": 0.9,
  "room": 3.75
 },
 "21.mp3": {
  "key": "7f309aae7487",
  "start": 80.2,
  "text": "「别为打翻的牛奶哭泣。」—— 英语谚语",
  "speed": 1.0,
  "dur": 3.21,
  "room": 4.55
 },
 "22.mp3": {
  "key": "33f5904ca7e5",
  "start": 84.9,
  "text": "过去的账，已经结了；",
  "speed": 1.0,
  "dur": 1.78,
  "room": 3.85
 },
 "23.mp3": {
  "key": "0e137f8bf5d8",
  "start": 88.9,
  "text": "往前的路，才是你的。",
  "speed": 1.0,
  "dur": 1.55,
  "room": 4.35
 },
 "24.mp3": {
  "key": "1adb58412321",
  "start": 93.4,
  "text": "花掉的，就让它花掉。",
  "speed": 1.0,
  "dur": 1.98,
  "room": 4.85
 },
 "25.mp3": {
  "key": "cfae68f88f67",
  "start": 98.4,
  "text": "评论区：你有没有为了「不浪费」，硬撑过什么？",
  "speed": 1.0,
  "dur": 3.42,
  "room": 5.45
 }
}