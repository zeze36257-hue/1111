{
 "00.mp3": {
  "key": "e5a6090a0deb",
  "start": 0.15,
  "text": "先看一段很好看的黑洞视频，再读一篇很难的黑洞论文。",
  "speed": 1.206,
  "dur": 3.63,
  "room": 3.8
 },
 "01.mp3": {
  "key": "1f67b157828b",
  "start": 4.1,
  "text": "相信「热爱靠找」的人，兴趣会怎样？先猜一个。",
  "speed": 1.155,
  "dur": 3.44,
  "room": 3.95
 },
 "02.mp3": {
  "key": "26e853add531",
  "start": 8.2,
  "text": "答案是：掉得更多。",
  "speed": 1.0,
  "dur": 1.75,
  "room": 2.45
 },
 "03.mp3": {
  "key": "04afeaf22a98",
  "start": 10.54,
  "text": "看视频的时候，大家都觉得黑洞很有意思；",
  "speed": 1.0,
  "dur": 2.91,
  "room": 2.65
 },
 "04.mp3": {
  "key": "a25df19af6ee",
  "start": 13.6,
  "text": "一难起来，他们的兴趣掉得更快。",
  "speed": 1.0,
  "dur": 2.38,
  "room": 2.55
 },
 "05.mp3": {
  "key": "90c7b2400d33",
  "start": 16.3,
  "text": "很多人心里，都有一个理想：",
  "speed": 1.0,
  "dur": 2.38,
  "room": 3.45
 },
 "06.mp3": {
  "key": "c4396604661e",
  "start": 19.9,
  "text": "总有一件事，是我命中注定的热爱；找到它，就不会累。",
  "speed": 1.3,
  "dur": 3.52,
  "room": 3.95
 },
 "07.mp3": {
  "key": "8f1ba2371391",
  "start": 24.0,
  "text": "心理学家把这叫做「兴趣的固定观」：",
  "speed": 1.0,
  "dur": 2.82,
  "room": 3.55
 },
 "08.mp3": {
  "key": "b3a509cf798c",
  "start": 27.7,
  "text": "热爱是现成的，只等你去找。",
  "speed": 1.0,
  "dur": 2.15,
  "room": 3.75
 },
 "09.mp3": {
  "key": "5f925bf66c31",
  "start": 31.6,
  "text": "这就是「理想主义」的一种：完美的那一个，就在某处等你。",
  "speed": 1.0,
  "dur": 5.05,
  "room": 5.85
 },
 "10.mp3": {
  "key": "1f4eb13f38ad",
  "start": 37.6,
  "text": "研究发现，这样想的人，",
  "speed": 1.0,
  "dur": 2.17,
  "room": 3.15
 },
 "11.mp3": {
  "key": "10e175da62c8",
  "start": 40.9,
  "text": "对自己领域以外的东西，兴趣更少；",
  "speed": 1.0,
  "dur": 2.69,
  "room": 3.85
 },
 "12.mp3": {
  "key": "f8091971e44a",
  "start": 44.9,
  "text": "还以为找到热爱以后，动力会无穷无尽。",
  "speed": 1.0,
  "dur": 2.81,
  "room": 3.85
 },
 "13.mp3": {
  "key": "9aba4fe99894",
  "start": 48.9,
  "text": "研究者说：这像把鸡蛋都放进一个篮子，篮子一沉，就扔了。",
  "speed": 1.083,
  "dur": 4.03,
  "room": 4.55
 },
 "14.mp3": {
  "key": "159dc4b13914",
  "start": 53.6,
  "text": "另一项研究发现：相信「找」的人，一开始更觉得自己选对了；",
  "speed": 1.0,
  "dur": 3.89,
  "room": 4.15
 },
 "15.mp3": {
  "key": "c911e992bc81",
  "start": 57.9,
  "text": "可后来，相信「找」和相信「养」的人，对工作的热爱和满意，差不多。",
  "speed": 1.0,
  "dur": 5.93,
  "room": 6.25
 },
 "16.mp3": {
  "key": "024f570c4214",
  "start": 64.3,
  "text": "所以，热爱也许不是找到的，",
  "speed": 1.0,
  "dur": 2.26,
  "room": 3.45
 },
 "17.mp3": {
  "key": "536ca867c8cf",
  "start": 67.9,
  "text": "是你一次次回去、一点点做，慢慢长出来的。",
  "speed": 1.0,
  "dur": 3.91,
  "room": 4.15
 },
 "18.mp3": {
  "key": "be2e5ef78d24",
  "start": 72.2,
  "text": "难的那一段，不一定是选错了，可能只是它正在长。",
  "speed": 1.129,
  "dur": 3.69,
  "room": 3.95
 },
 "19.mp3": {
  "key": "eec56bdc42d2",
  "start": 76.3,
  "text": "那篇论文最后，研究者建议：",
  "speed": 1.0,
  "dur": 2.2,
  "room": 3.75
 },
 "20.mp3": {
  "key": "65ef50df82fa",
  "start": 79.2,
  "text": "与其「找到」你的热爱，不如「培养」它。—— 奥基夫、德韦克 & 沃尔顿（大意）",
  "speed": 1.151,
  "dur": 6.16,
  "room": 4.55
 },
 "21.mp3": {
  "key": "d4df1287cf86",
  "start": 85.51,
  "text": "这一季，我们聊了十个「看不见的主义」。",
  "speed": 1.0,
  "dur": 2.82,
  "room": 3.85
 },
 "22.mp3": {
  "key": "a08c4c838483",
  "start": 88.9,
  "text": "谢谢你，一期一期看到这里。",
  "speed": 1.0,
  "dur": 1.88,
  "room": 4.35
 },
 "23.mp3": {
  "key": "65522054e261",
  "start": 93.4,
  "text": "热爱，是养出来的。",
  "speed": 1.0,
  "dur": 1.82,
  "room": 4.85
 },
 "24.mp3": {
  "key": "978d0d561ed7",
  "start": 98.4,
  "text": "评论区：你有哪件事，是慢慢才喜欢上的？",
  "speed": 1.0,
  "dur": 3.36,
  "room": 5.45
 }
}