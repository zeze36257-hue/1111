{
 "00.mp3": {
  "key": "d6b6f985eed4",
  "tkey": "4c2d78824534",
  "file": "00.mp3",
  "start": 0.15,
  "text": "你是不是这样：越喜欢一个人，越想躲？",
  "speed": 1.0,
  "dur": 3.12,
  "room": 3.52
 },
 "01.mp3": {
  "key": "5be7c2fdadd3",
  "tkey": "46d8304a75a6",
  "file": "01.mp3",
  "start": 3.82,
  "text": "对方一靠近，你就想往后退；",
  "speed": 1.0,
  "dur": 2.01,
  "room": 2.31
 },
 "02.mp3": {
  "key": "624a37eb17b1",
  "tkey": "c8d504041d12",
  "file": "02.mp3",
  "start": 6.28,
  "text": "一吵架，你不想说话，只想一个人待着。",
  "speed": 1.0,
  "dur": 3.41,
  "room": 3.91
 },
 "03.mp3": {
  "key": "e9a023373ada",
  "tkey": "a1f91a462b11",
  "file": "03.mp3",
  "start": 10.34,
  "text": "或者，你正在爱着这样一个人。",
  "speed": 1.0,
  "dur": 2.16,
  "room": 2.56
 },
 "04.mp3": {
  "key": "8ce9d2c4fd0f",
  "tkey": "997533d1a99d",
  "file": "04.mp3",
  "start": 13.05,
  "text": "今天，我们一起来聊聊「回避型依恋」。",
  "speed": 1.0,
  "dur": 2.39,
  "room": 6.3
 },
 "05.mp3": {
  "key": "d389f4919a33",
  "tkey": "97fd421bf806",
  "file": "05.mp3",
  "start": 19.5,
  "text": "心理学家用两把尺子，量一个人怎么谈感情：",
  "speed": 1.0,
  "dur": 3.46,
  "room": 3.76
 },
 "06.mp3": {
  "key": "5ce4e60390c9",
  "tkey": "619acd220343",
  "file": "06.mp3",
  "start": 23.41,
  "text": "一把是「怕被抛弃」，一把是「怕太亲近」。",
  "speed": 1.0,
  "dur": 2.99,
  "room": 3.39
 },
 "07.mp3": {
  "key": "9ea51f624fce",
  "tkey": "7409982be4a4",
  "file": "07.mp3",
  "start": 26.95,
  "text": "回避型，是第二把尺子特别高：",
  "speed": 1.0,
  "dur": 2.01,
  "room": 2.21
 },
 "08.mp3": {
  "key": "3f2932a5da66",
  "tkey": "02dff4776e7f",
  "file": "08.mp3",
  "start": 29.31,
  "text": "离得越近，越不自在；其中有一种，还不太担心被丢下。",
  "speed": 1.0,
  "dur": 5.17,
  "room": 5.57
 },
 "09.mp3": {
  "key": "81f2f637aa19",
  "tkey": "2fac36af4e23",
  "file": "09.mp3",
  "start": 35.03,
  "text": "在两项大型调查里，都有大约四分之一的人这样形容自己。",
  "speed": 1.0,
  "dur": 4.47,
  "room": 6.72
 },
 "10.mp3": {
  "key": "80455fcab189",
  "tkey": "5fa2b7fa76e2",
  "file": "10.mp3",
  "start": 41.9,
  "text": "很多人以为，回避型就是冷，不在乎。",
  "speed": 1.0,
  "dur": 3.73,
  "room": 4.03
 },
 "11.mp3": {
  "key": "b76477f2280c",
  "tkey": "4845baed63e5",
  "file": "11.mp3",
  "start": 46.08,
  "text": "可研究看到的，没那么简单。",
  "speed": 1.0,
  "dur": 2.11,
  "room": 2.76
 },
 "12.mp3": {
  "key": "2ea6f8cb5ade",
  "tkey": "882c5d74f8bf",
  "file": "12.mp3",
  "start": 48.99,
  "text": "心理学家观察过一岁的宝宝：妈妈离开房间，再回来。",
  "speed": 1.0,
  "dur": 4.13,
  "room": 4.43
 },
 "13.mp3": {
  "key": "660f934c56b7",
  "tkey": "8d86843fe923",
  "file": "13.mp3",
  "start": 53.57,
  "text": "有的宝宝不哭不闹，像什么都没发生，继续玩玩具。",
  "speed": 1.0,
  "dur": 3.72,
  "room": 4.12
 },
 "14.mp3": {
  "key": "a3c8e2699e8e",
  "tkey": "72b2ae534c99",
  "file": "14.mp3",
  "start": 57.84,
  "text": "可仪器显示，他们的心跳一直很快，迟迟降不下来。",
  "speed": 1.0,
  "dur": 4.04,
  "room": 4.99
 },
 "15.mp3": {
  "key": "848fe4b64559",
  "tkey": "02a6e83724b8",
  "file": "15.mp3",
  "start": 62.98,
  "text": "长大以后也一样。",
  "speed": 1.0,
  "dur": 1.23,
  "room": 1.48
 },
 "16.mp3": {
  "key": "86dbd179f3a2",
  "tkey": "7e03ce1f43d9",
  "file": "16.mp3",
  "start": 64.61,
  "text": "越习惯回避的人，回忆起被父母拒绝、分开的往事，",
  "speed": 1.0,
  "dur": 4.31,
  "room": 4.46
 },
 "17.mp3": {
  "key": "740438b47df7",
  "tkey": "cd696eeb7ce6",
  "file": "17.mp3",
  "start": 69.22,
  "text": "嘴上说「没什么」，皮肤电反应却明显升高。",
  "speed": 1.0,
  "dur": 3.44,
  "room": 4.09
 },
 "18.mp3": {
  "key": "e26ba83d566e",
  "tkey": "a2aa2fc73865",
  "file": "18.mp3",
  "start": 73.46,
  "text": "不在乎，是一层壳。",
  "speed": 1.0,
  "dur": 1.67,
  "room": 3.49
 },
 "19.mp3": {
  "key": "19427aebddee",
  "tkey": "d49747f6d303",
  "file": "19.mp3",
  "start": 77.1,
  "text": "这层壳，是怎么长出来的？",
  "speed": 1.0,
  "dur": 2.2,
  "room": 2.6
 },
 "20.mp3": {
  "key": "eef4f43dbe17",
  "tkey": "6b3acc630db8",
  "file": "20.mp3",
  "start": 79.85,
  "text": "心理学家发现，回避型的宝宝，常有这样的经历：",
  "speed": 1.0,
  "dur": 3.64,
  "room": 3.84
 },
 "21.mp3": {
  "key": "3d9399aa5a41",
  "tkey": "f743ab31b7ef",
  "file": "21.mp3",
  "start": 83.84,
  "text": "难过的时候想要抱抱，却常常被推开、被嫌烦。",
  "speed": 1.0,
  "dur": 4.04,
  "room": 4.44
 },
 "22.mp3": {
  "key": "9888240cae9d",
  "tkey": "b31f2827ed28",
  "file": "22.mp3",
  "start": 88.43,
  "text": "次数多了，孩子可能就学会了：",
  "speed": 1.0,
  "dur": 2.34,
  "room": 2.54
 },
 "23.mp3": {
  "key": "bc7ff42b9d6d",
  "tkey": "9de054c3b888",
  "file": "23.mp3",
  "start": 91.12,
  "text": "把需要藏起来，就不会被推开。",
  "speed": 1.0,
  "dur": 2.65,
  "room": 3.4
 },
 "24.mp3": {
  "key": "dfa547b67445",
  "tkey": "cc4fe7eccb82",
  "file": "24.mp3",
  "start": 94.67,
  "text": "心理学家管这叫「去激活」：把想靠近的需要压下去，再悄悄拉开距离。",
  "speed": 1.0,
  "dur": 6.51,
  "room": 6.91
 },
 "25.mp3": {
  "key": "bd4e4e1b7ed3",
  "tkey": "6e7aed7233ae",
  "file": "25.mp3",
  "start": 101.73,
  "text": "可压得住，不代表它不在。",
  "speed": 1.0,
  "dur": 2.16,
  "room": 2.46
 },
 "26.mp3": {
  "key": "2b30abaac48f",
  "tkey": "0b15a9090fc4",
  "file": "26.mp3",
  "start": 104.34,
  "text": "实验发现：回避型的人一分心，被压下去的分手念头，就会反弹回来。",
  "speed": 1.0,
  "dur": 5.7,
  "room": 7.81
 },
 "27.mp3": {
  "key": "c685fb83d660",
  "tkey": "16b91db59c6f",
  "file": "27.mp3",
  "start": 112.3,
  "text": "如果你是回避型：",
  "speed": 1.0,
  "dur": 1.28,
  "room": 1.48
 },
 "28.mp3": {
  "key": "3c3d3a27c458",
  "tkey": "d4b5821e7032",
  "file": "28.mp3",
  "start": 113.93,
  "text": "想退的时候，别直接消失。",
  "speed": 1.0,
  "dur": 2.09,
  "room": 2.39
 },
 "29.mp3": {
  "key": "181de5e31071",
  "tkey": "10cda855221f",
  "file": "29.mp3",
  "start": 116.47,
  "text": "说一句：「我需要一点时间，晚上找你。」",
  "speed": 1.0,
  "dur": 3.27,
  "room": 3.57
 },
 "30.mp3": {
  "key": "9e420df8b3ea",
  "tkey": "7f8971de6ac6",
  "file": "30.mp3",
  "start": 120.19,
  "text": "给对方一个时间点，也给自己留一条回来的路。",
  "speed": 1.0,
  "dur": 3.25,
  "room": 3.9
 },
 "31.mp3": {
  "key": "75351991cf3d",
  "tkey": "e414e0b9f676",
  "file": "31.mp3",
  "start": 124.24,
  "text": "如果你爱着一个回避型：",
  "speed": 1.0,
  "dur": 1.63,
  "room": 1.83
 },
 "32.mp3": {
  "key": "245d327a56bf",
  "tkey": "159e8a65163d",
  "file": "32.mp3",
  "start": 126.22,
  "text": "越追，对方越跑。",
  "speed": 1.0,
  "dur": 1.64,
  "room": 2.04
 },
 "33.mp3": {
  "key": "b2d5c6c1a206",
  "tkey": "d75cec2cafab",
  "file": "33.mp3",
  "start": 128.41,
  "text": "给空间，不等于被冷落。",
  "speed": 1.0,
  "dur": 2.12,
  "room": 2.77
 },
 "34.mp3": {
  "key": "e0cf3b90b45d",
  "tkey": "5ed715c54f10",
  "file": "34.mp3",
  "start": 131.33,
  "text": "依恋类型挺稳定，但不是一辈子的标签。",
  "speed": 1.0,
  "dur": 2.81,
  "room": 3.11
 },
 "35.mp3": {
  "key": "c48a8621dd14",
  "tkey": "9764ed68bb6c",
  "file": "35.mp3",
  "start": 134.59,
  "text": "研究发现，在稳定、被好好回应的关系里，有些人会慢慢变得更安心。",
  "speed": 1.0,
  "dur": 5.58,
  "room": 6.13
 },
 "36.mp3": {
  "key": "e882bf58ea2d",
  "tkey": "6eb8ff75849b",
  "file": "36.mp3",
  "start": 140.87,
  "text": "回避型的人，不是不会爱，只是爱得很小心。",
  "speed": 1.0,
  "dur": 3.91,
  "room": 4.66
 },
 "37.mp3": {
  "key": "83da3c4ca1b7",
  "tkey": "66f56b31c2a2",
  "file": "37.mp3",
  "start": 145.68,
  "text": "评论区说说：你是回避型，还是正在爱着一个回避型？",
  "speed": 1.0,
  "dur": 3.93,
  "room": 7.77
 }
}